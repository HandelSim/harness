# harness — environment variables.
#
# This file documents every variable the project reads. Copy it to .env
# at the top of the clone — the install root IS the clone. docker compose
# is invoked with `--env-file <install-root>/.env`.
#
# Required values are marked REQUIRED; you must fill these in before
# running harness. Everything else has a sensible default.
#
# Per-MCP variables are tagged with one of:
#   REQUIRED for <mcp>: ...
#   OPTIONAL for <mcp> (default: ...): ...
#   OPTIONAL, used by multiple MCPs: ...

# ---------------------------------------------------------------------------
# Upstream API (consumed by the proxy)
# ---------------------------------------------------------------------------

# REQUIRED. Base URL of the third-party API the proxy will call. This is a
# BASE — the proxy appends the OpenAI-style paths itself: it POSTs chat to
# {PROXY_API_URL}/v1/chat/completions and GETs the model catalog from
# {PROXY_API_URL}/v1/models. For convenience a trailing /v1/chat/completions,
# /chat/completions, or /v1 is stripped first, so all of these work:
#   PROXY_API_URL=https://api.example.com
#   PROXY_API_URL=https://api.example.com/v1
#   PROXY_API_URL=https://api.example.com/v1/chat/completions   (legacy form)
PROXY_API_URL=

# REQUIRED. API key / bearer token for the upstream API. Sensitive — never commit.
PROXY_API_KEY=

# REQUIRED. Default/fallback model id. The harness now passes whatever model
# opencode selects all the way through to the upstream, and opencode's model
# list is built from every model the upstream advertises on /v1/models — so you
# can switch models from opencode on the fly. This value is the one always
# offered and selected by default (set it to the upstream model id you want as
# the default). No hardcoded default: a valid id is upstream-specific. Replaces
# the old PROXY_API_MODEL and OLLAMA_AGENT_MODEL (set this to your old PROXY_API_MODEL).
DEFAULT_MODEL_NAME=

# Upstream request timeout in seconds. Defaults to 180.
PROXY_TIMEOUT=180

# NOTE: the cooperative-prompt injection mode is no longer a .env knob. The
# proxy defaults to "hybrid" (the best general-purpose mode). For benchmarking
# or power use you can pick a mode for a single launch with the ephemeral flag:
#   harness start   --prompt-mode user_front
#   harness restart --prompt-mode passthrough
# It is not persisted — a later bare start/restart reverts to hybrid. The proxy
# also always converts the upstream-dropped `system` role into a user message,
# and the hybrid "detail tools" set (task, skill) is project-managed; none of
# these are user-tunable anymore.

# ---------------------------------------------------------------------------
# Proxy service (containers on the harness-net bridge)
# ---------------------------------------------------------------------------

# Bind address inside the proxy container. 0.0.0.0 because the proxy is only
# reachable on the docker network — the host does not publish this port.
PROXY_HOST=0.0.0.0

# Port the proxy listens on inside the container. opencode's provider baseURL
# (http://proxy:${PROXY_PORT}/v1) is constructed from this.
PROXY_PORT=8000

# Context length (in tokens) the proxy advertises and uses to cap its local
# token estimate. Defaults to 200000. (Legacy alias: OLLAMA_CONTEXT_LENGTH,
# still honored if set, but prefer MODEL_CONTEXT_LENGTH.)
MODEL_CONTEXT_LENGTH=200000

# OPTIONAL — proxy debug dumps. Leave empty (default) to disable.
# When set, the proxy writes JSON files to this directory for every
# request: the raw inbound request, the translated upstream request, and
# the upstream response. Useful for debugging tool-call issues. Can
# produce many files quickly. Path is INSIDE the proxy container; the
# default compose bind-mounts <install-root>/state/output to it.
#
# Default: empty (no debug dumps written)
# Linux/macOS example: OUTPUT_DIR=/output
#
# WINDOWS NOTE: Git Bash auto-translates leading `/` paths when passing
# env vars to Docker, so OUTPUT_DIR=/output ends up as
# `C:/Program Files/Git/output` inside the container. Use a double-slash
# to bypass MSYS path translation: OUTPUT_DIR=//output. Both forms
# bind-mount to the same host directory at <install-root>/state/output/.
#
# (Unrelated to HARNESS_EXTRA_MOUNTS / agent --mount: those bind paths at
# their original host-side names; this var is the proxy's debug-dump
# in-container target, not an agent mount.)
OUTPUT_DIR=

# ---------------------------------------------------------------------------
# MCP servers (consumed by registry compose snippets)
# ---------------------------------------------------------------------------

# OPTIONAL for Serena (default: the host's $HOME of whoever invoked harness).
# Path on the host that registry MCP services may mount read-only for code
# analysis. Currently consumed by Serena's compose snippet. Leaving blank
# means the harness wrapper falls back to your $HOME, which matches
# "see whatever is in my home". Narrow it if you only want to expose
# specific projects:
#   HARNESS_PROJECTS_ROOT=/home/you/code
# Mounts are read-only; agents still own the write path via their normal
# CWD bind-mount (which lands at the same absolute path inside the
# container — see HARNESS_EXTRA_MOUNTS below).
HARNESS_PROJECTS_ROOT=

# OPTIONAL for agent launches (default: empty, just the CWD is mounted).
# Sticky list of additional host folders to bind-mount into every agent
# launch (opencode, shell). Each entry is mounted at its same
# absolute path inside the container, so paths are identical from host
# to container — useful for absolute references in code, log files, or
# project-relative scripts that span multiple repos.
#
# Format: colon-separated absolute paths (PATH-style on Linux/macOS).
# On Windows Git Bash, use Linux-style absolute paths (/c/Users/...).
# Each path must exist as a directory at launch time; the harness CLI
# refuses to start if any are missing.
#
# Examples:
#   HARNESS_EXTRA_MOUNTS=/home/me/refs
#   HARNESS_EXTRA_MOUNTS=/home/me/refs:/home/me/data
#   HARNESS_EXTRA_MOUNTS=/c/Users/me/notes
#
# CLI equivalent (per-launch, repeatable, mergeable with the env var):
#   harness --mount /home/me/refs --mount /home/me/data
#
# The agent's CWD is ALWAYS mounted regardless of this setting; this
# variable controls only the additional mounts. The agent's starting
# directory is always the CWD, never an extra mount.
HARNESS_EXTRA_MOUNTS=

# OPTIONAL for Serena (default: dashboard internal-only).
# Set to e.g. 24282 to publish Serena's web dashboard on that host port so
# you can browse it from outside docker. Leave blank to keep the dashboard
# reachable only from inside the harness-net bridge. Only consulted when
# the Serena MCP is enabled.
SERENA_DASHBOARD_PORT=

# ---------------------------------------------------------------------------
# Network / firewall overrides
# ---------------------------------------------------------------------------

# Path to the per-service firewall override JSON. Defaults to
# <install-root>/.harness-net-overrides.json. Managed by `harness net open`
# and `harness net close`; only set this if you want the overrides file in a
# non-default location (e.g. tests).
HARNESS_NET_OVERRIDES_PATH=

# ---------------------------------------------------------------------------
# Corporate HTTP proxy (optional)
# ---------------------------------------------------------------------------
# If your machine reaches the internet through a corporate proxy, set these so
# the host-side work harness runs behind it succeeds:
#   - the initial 'git clone' during install (see note below),
#   - 'git pull' during 'harness update' / 'harness upgrade',
#   - 'git clone'/'fetch' during 'harness mcp install',
#   - 'docker compose build' — both the base-image pulls and the apt/pip/npm
#     steps inside the image builds. BuildKit reads these vars from harness's
#     environment and routes the build through the proxy. The build runs on the
#     host's BuildKit before any container/firewall exists, so it needs them.
#   - 'harness host' toolchain pulls (containerless mode): the jq binary and
#     Node archive (curl), opencode (npm), and the proxy venv deps (pip) are
#     all fetched on the host and routed through this proxy. curl honors the
#     vars directly; npm and pip are pinned to them explicitly so an ambient
#     ~/.npmrc / pip.conf proxy cannot override .env. The local loopback calls
#     host mode makes (the proxy's own /v1/models) bypass the proxy.
#
# These are NOT injected into running containers: docker-compose.yml declares
# no proxy vars in any service environment, so once a container is up its
# egress stays on the runtime/firewall path rather than your corp proxy. Set
# these only if your HOST needs a proxy to reach the internet (git hosts, the
# Docker registry).
#
# Leave blank if you don't need a proxy. Blank values do not override a proxy
# already exported in your shell.
#
# Pre-install note: harness-install.sh runs before this .env exists, so the
# very first 'git clone' gets its proxy from one of two places:
#   1. a .env placed BESIDE harness-install.sh with HTTP_PROXY/HTTPS_PROXY set
#      (the installer exports those for the clone, then copies the file in), or
#   2. otherwise whatever proxy you export in your shell, e.g.
#      `HTTPS_PROXY=http://proxy:8080 ./harness-install.sh`.
# Either way the values land here so later 'harness' runs pick them up.
#
# Sensitive: a proxy URL with embedded credentials (http://user:pass@host:port)
# ends up stored in this file. .env is gitignored, but treat it accordingly.
HTTP_PROXY=
HTTPS_PROXY=
# Hosts to reach DIRECTLY, bypassing the proxy (comma-separated). 127.0.0.1 and
# localhost are always bypassed by harness for its own loopback calls; set this
# only to add internal hosts your proxy must not be used for. Honored by curl,
# npm, and pip on the host. Optional; leave blank if unneeded.
NO_PROXY=

# ---------------------------------------------------------------------------
# Container runtime
# ---------------------------------------------------------------------------

# OPTIONAL. Pin the container runtime to use. Valid values: docker, podman.
# When unset (the default), harness auto-detects: docker first, then podman.
# Set this if you have both installed and want to force one.
#
# Podman support is for Linux + rootless podman 4.0+ (which ships the
# built-in `podman compose` subcommand). See docs/PODMAN.md for setup.
#
# HARNESS_CONTAINER_RUNTIME=podman
HARNESS_CONTAINER_RUNTIME=
