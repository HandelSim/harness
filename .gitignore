# User config — seeded by install.sh from .env.example /
# .harness-allowlist.example, then user-owned. Sensitive (PROXY_API_KEY etc.).
.env
.harness-allowlist
.harness-net-overrides.json
# The reminder's user-editable data, seeded from the proxy/ defaults by
# `harness start`. The leading slash is load-bearing: these keep their tracked
# basenames, and only the copies AT THE INSTALL ROOT are ignored — proxy/
# reminder.md and proxy/tool-guidance.json stay tracked. (.harness-data/ and
# the two .harness-* names are earlier locations, kept ignored so an install
# that hasn't started since the move stays clean.)
/reminder.md
/tool-guidance.json
.harness-data/
.harness-reminder.md
.harness-tool-guidance.json

# Runtime state — bind-mounted into containers; not part of the repo.
# Includes output/, agent/home/, mcp/<name>/,
# and the .harness-runtime.yml compose override.
state/

# Host MCP instances scaffolded by `harness mcp host-init` live under
# host-mcp/<name>/ (in prod install_root == the repo). They are user-specific
# build servers, not part of the repo — ignore them, but keep the git-tracked
# template they are copied from.
/host-mcp/*
!/host-mcp/template/

# harness is distributed via direct git clone — no zip build artifact.

# Python / editor / OS
__pycache__/
*.pyc
.DS_Store
*.swp
*.swo
# Windows / Git Bash crash dumps
*.stackdump

# Local Claude Code state (lock files for skill scheduling, etc.).
# Default-deny everything under .claude/, then allow checked-in config,
# skills, and agent reference docs back in. New runtime files default to
# ignored without a list change.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
!.claude/references/
!.claude/references/**
