#!/usr/bin/env bash
#
# harness — management entrypoint for the harness runtime.
#
# Layout assumed at runtime (the install root IS the git clone — they are
# the same directory):
#
#   <install-root>/                       # also the git clone
#     .git/                                # managed by 'harness update'
#     harness                              # this file (tracked)
#     docker-compose.yml                   # tracked
#     mcp-registry/                        # vetted MCP definitions (tracked)
#     ...
#     .env                                 # gitignored — user config
#     .harness-allowlist                   # gitignored — egress allowlist
#     state/                               # gitignored — runtime state
#       output/                            # bind-mounted into the proxy
#       agent/home/                        # shared agent /home/harness
#                                            (opencode, shell)
#       mcp/<name>/                        # active MCP services
#
# This script is symlinked into ~/.local/bin/harness by install.sh; we use
# realpath on $0 to resolve the script's true location independent of how
# it was invoked. The script's parent directory is both the clone and the
# install root.

set -euo pipefail

# --- self-locate ------------------------------------------------------------
#
# In production we resolve $0 through any wrapper or symlink
# (~/.local/bin/harness -> <install-root>/harness) to find the install root,
# which is also the git clone. The wrapper script installed by harness-
# install.sh exec's into this script, so $0 here resolves to the real
# install-root path. Tests can override via HARNESS_INSTALL_ROOT — useful
# when the test layout uses symlinks that would otherwise collapse dirname
# into the real repo path.
#
# We use a portable resolver here rather than depending on `realpath` so
# the script also works on Windows Git Bash and on minimal images where
# realpath isn't installed. The full equivalent lives in
# scripts/lib/platform.sh:harness_realpath; the helper sourced below.

_self_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    elif command -v readlink >/dev/null 2>&1 && readlink -f "$1" >/dev/null 2>&1; then
        readlink -f "$1"
    else
        cd "$(dirname "$1")" && echo "$(pwd -P)/$(basename "$1")"
    fi
}

real_self=$(_self_path "$0")
# clone_dir is where the code lives (this script + docker-compose.yml + scripts/).
# install_root is where the user config (.env, .harness-allowlist) and runtime
# state (state/) live. In production these are the same directory: install.sh
# clones the repo and that clone IS the install root. Tests can override
# HARNESS_INSTALL_ROOT to point at a tmpdir while keeping clone_dir resolved
# to the real repo (via the script's realpath); without HARNESS_INSTALL_ROOT,
# install_root falls back to clone_dir and the layout is single-folder.
clone_dir=$(dirname "$real_self")

# Source the cross-platform helper library so the rest of the script can
# call harness_detect_os, harness_require_docker, etc. The library is
# installed alongside this script in scripts/lib/platform.sh.
if [[ -f "$clone_dir/scripts/lib/platform.sh" ]]; then
    # shellcheck disable=SC1091
    source "$clone_dir/scripts/lib/platform.sh"
fi
install_root="${HARNESS_INSTALL_ROOT:-$clone_dir}"
state_root="$install_root/state"
env_file="$install_root/.env"
runtime_override="$state_root/.harness-runtime.yml"

# Ephemeral cooperative-prompt mode for this invocation. Empty unless
# `harness start/restart --prompt-mode <mode>` was passed; when set it is
# injected into the proxy container's env (PROXY_PROMPT_MODE) by
# write_runtime_override. Never persisted — a later bare start/restart reverts
# the proxy to its built-in "hybrid" default. See _parse_prompt_mode_flag.
prompt_mode_override=""

# Universal egress firewall allowlist. Bind-mounted into every harness
# container at /etc/harness/allowlist. install.sh seeds this from
# .harness-allowlist.example on a fresh install. Tests can override by
# setting HARNESS_ALLOWLIST_PATH.
allowlist_path="${HARNESS_ALLOWLIST_PATH:-$install_root/.harness-allowlist}"

# B3-MANAGED: net-overrides — JSON file holding per-service firewall opt-out
# state. Written by `harness net open/close <service>`; read by
# write_runtime_override to inject HARNESS_FIREWALL_DISABLED=1 env vars onto
# the matching services in the generated compose override. Tests can
# substitute their own path via HARNESS_NET_OVERRIDES_PATH.
net_overrides_path="${HARNESS_NET_OVERRIDES_PATH:-$install_root/.harness-net-overrides.json}"

# Tests can substitute their own registry by overriding HARNESS_REGISTRY_DIR.
# Defaults to the repo's bundled mcp-registry/ folder so users see the
# vetted set out-of-the-box.
registry_dir="${HARNESS_REGISTRY_DIR:-$clone_dir/mcp-registry}"
mcp_active_dir="$state_root/mcp"

# Project name is fixed by spec but overridable for tests so harness_test.sh
# can run without colliding with a real harness instance on the same daemon.
project_name="${HARNESS_PROJECT_NAME:-harness}"

# --- env loading ------------------------------------------------------------
#
# Source .env into this shell so we can read DEFAULT_MODEL_NAME etc. for our
# own logic. docker compose gets the file separately via --env-file.
#
# Host proxy (HTTP_PROXY/HTTPS_PROXY/NO_PROXY): honored for the host-side git
# calls this script runs (update/upgrade pull, mcp clone) — git's libcurl
# reads them from the process env — but stripped from every container-runtime
# call by harness_docker (see platform.sh). A non-empty value in .env wins; a
# blank value (the optional default) must NOT clobber a proxy the invoking
# shell already exported, so capture the shell's values before sourcing and
# restore any that .env left empty.
_harness_proxy_keys=(HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy)
for _k in "${_harness_proxy_keys[@]}"; do
    printf -v "_harness_shell_$_k" '%s' "${!_k:-}"
done

if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
fi

for _k in "${_harness_proxy_keys[@]}"; do
    if [[ -z "${!_k:-}" ]]; then
        _sv="_harness_shell_$_k"
        [[ -n "${!_sv:-}" ]] && export "$_k=${!_sv}"
    fi
done
# harness_normalize_proxy_env lives in platform.sh, which is always present in
# a real install but may be absent when this script is sourced from a test
# harness that didn't load it (HARNESS_SOURCE_ONLY). Guard so source-only
# contexts don't abort under set -u/-e.
command -v harness_normalize_proxy_env >/dev/null 2>&1 && harness_normalize_proxy_env
unset _harness_proxy_keys _k _sv

# The default/fallback model id. REQUIRED (no hardcoded default): once the
# model passes through to the upstream, a cosmetic default would be a real
# upstream id we can't know. require_runtime_config enforces it's set before
# any launch. The agent entrypoint discovers models from the proxy's
# /v1/models catalog and opencode selects harness/${DEFAULT_MODEL_NAME} by
# default.
# See architecture/harness-cli.md (Env loading).
agent_model="${DEFAULT_MODEL_NAME:-}"

# --- net helpers (lazy load) ------------------------------------------------
#
# scripts/lib/net_helpers.sh is shared between the harness script and tests.
# We source it on first use so the no-op startup cost on commands that don't
# touch the network (e.g. `harness logs`) stays close to zero.

netlib_loaded=0
load_net_helpers() {
    if (( netlib_loaded )); then return 0; fi
    local lib="$clone_dir/scripts/lib/net_helpers.sh"
    if [[ ! -f "$lib" ]]; then
        err "internal: $lib is missing — broken install"
        exit 1
    fi
    # NETLIB_* must persist after `source` returns: the lib's functions read
    # them at call time, not at source time. The `VAR=val source` prefix
    # syntax only scopes the assignment to the source builtin itself.
    NETLIB_ALLOWLIST="$allowlist_path"
    NETLIB_OVERRIDES="$net_overrides_path"
    # shellcheck disable=SC1090
    source "$lib"
    netlib_loaded=1
}

# --- helpers ----------------------------------------------------------------

# Print to stderr in the standard `harness:` format.
err() {
    echo "harness: $*" >&2
}

# harness_jq — wrapper that uses host jq if available, else falls back to
# the proxy container's jq. Same args/stdin/stdout/exit semantics as
# native jq.
#
# Why: the harness script's upgrade flow uses jq to parse the manifest,
# but jq is a host dependency users frequently don't have. Forcing them to
# install it via platform-specific package managers is poor UX. The proxy
# image (harness-proxy:latest) ships jq for its own firewall scripts, so
# the fallback runs jq there transparently — no host dependency added.
#
# The fallback does NOT spawn a fresh container per call. It runs jq via
# `docker exec` against a long-lived per-invocation sidecar container
# (_ensure_jq_sidecar) so the ~200ms container-creation cost is paid once
# per `harness` invocation rather than once per jq call — `harness
# upgrade` still makes ~3 jq calls per merged file. Sidecar lifecycle:
# _ensure_jq_sidecar (create), _reap_jq_sidecar (tear down on exit / before
# exec), _sweep_stale_jq_sidecars (self-heal leaks). See those functions.
#
# Caveats:
# - First fallback in a fresh install (no proxy image yet) builds the
#   image inline. We tell the user this is happening so they don't think
#   the script froze. Build is one-time; subsequent calls are fast.
# - If Docker isn't running, both paths fail. Clear error.
harness_jq() {
    if command -v jq >/dev/null 2>&1; then
        jq "$@"
        return $?
    fi

    # Host jq missing. Route through the per-invocation container sidecar.
    local sidecar
    sidecar=$(_ensure_jq_sidecar) || return 1

    # The container can't see host filesystem paths. If the last argument is
    # a host file that exists, redirect it as stdin instead of passing it as
    # a positional arg. This handles `jq '...' file.json` callers (manifest
    # parsing in cmd_upgrade, net overrides file in netlib_overrides_*).
    local args=("$@")
    local n=${#args[@]}
    if (( n > 0 )) && [[ -f "${args[n-1]}" ]]; then
        local file="${args[n-1]}"
        unset 'args[n-1]'
        harness_docker exec -i "$sidecar" jq "${args[@]}" <"$file"
    else
        harness_docker exec -i "$sidecar" jq "$@"
    fi
}

# _ensure_jq_sidecar — ensure the per-invocation jq sidecar container is
# running and echo its name. The sidecar is a long-lived `sleep infinity`
# container built from the proxy image; harness_jq runs `docker exec`
# against it instead of paying full container-creation latency per call.
#
# Keyed on $$ (the main `harness` PID), which is identical in every
# subshell — so any harness_jq call site, inside any `$(...)` / `< <(...)`,
# converges on the same container name with no shared in-process state
# (a captured container ID would die with the subshell that created it).
#
# Created lazily on the first jq call of a jq-less invocation; calls 2..N
# hit the "already running" fast path. Reaped by the EXIT trap and by
# explicit pre-exec reap calls on the agent-launch paths (see
# _reap_jq_sidecar). _sweep_stale_jq_sidecars (called here, so once per
# invocation) clears sidecars left behind by harness processes that died
# without reaping.
_ensure_jq_sidecar() {
    local name="harness-jq-$$"
    local rt state

    rt=$(harness_container_runtime)
    if ! command -v "$rt" >/dev/null 2>&1; then
        echo "harness: jq is required but not installed on the host," >&2
        echo "harness: and the container runtime ($rt) isn't installed either as a fallback." >&2
        echo "harness: install $rt (which harness already requires) or" >&2
        echo "harness: install jq via your package manager." >&2
        return 1
    fi

    # Fast path: sidecar already up for this invocation.
    state=$(harness_docker container inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)
    [[ "$state" == "true" ]] && { echo "$name"; return 0; }

    if ! harness_docker info >/dev/null 2>&1; then
        echo "harness: jq is required but not installed on the host," >&2
        echo "harness: and the $rt runtime isn't reachable for the fallback." >&2
        echo "harness: start the $rt runtime and retry." >&2
        return 1
    fi

    if ! harness_docker image inspect harness-proxy:latest >/dev/null 2>&1; then
        echo "harness: jq isn't installed on the host. Falling back to the" >&2
        echo "harness: proxy container's jq, but its image isn't built yet." >&2
        echo "harness: building harness-proxy:latest now (one-time, ~2-5 minutes)..." >&2

        # compose build proxy re-enters compose() -> write_runtime_override,
        # which calls harness_jq again; the _harness_wro_in_progress guard
        # in write_runtime_override breaks that recursion. Keep this build
        # ahead of the `docker run` below so the guard covers it.
        if ! (cd "$install_root" && compose build proxy >&2); then
            echo "harness: proxy image build failed; cannot fall back to" >&2
            echo "harness: container jq. Install jq directly via your package" >&2
            echo "harness: manager (apt/dnf/brew/pacman) and retry." >&2
            return 1
        fi
        echo "harness: proxy image built; resuming." >&2
    fi

    # A stopped container under our own name (crashed sleep, or PID reuse
    # the sweep didn't catch) blocks `run --name`; clear it first.
    if [[ "$state" == "false" ]]; then
        harness_docker rm -f "$name" >/dev/null 2>&1 || true
    fi

    # Clear sidecars owned by harness processes that are no longer alive.
    # Runs only on the invocation's first jq call (calls 2..N hit the fast
    # path above), so it's one `docker ps` per jq-less invocation.
    _sweep_stale_jq_sidecars

    # Start ours. Concurrent harness_jq calls (a `< <(...)` producer racing
    # the loop body that consumes it) can both reach here; the loser's
    # `run` fails on the name collision, which is fine — the re-inspect
    # below sees the winner's container.
    harness_docker run -d --name "$name" --entrypoint sleep \
        harness-proxy:latest infinity >/dev/null 2>&1 || true

    state=$(harness_docker container inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)
    if [[ "$state" != "true" ]]; then
        echo "harness: failed to start the jq sidecar container ($name)." >&2
        return 1
    fi

    # Marker file so _reap_jq_sidecar knows a sidecar exists for this PID
    # without an extra docker call on every harness exit (the EXIT trap
    # fires even for `harness help`). Survives subshells; cleared on reap.
    mkdir -p "${install_root}/state" 2>/dev/null || true
    : > "${install_root}/state/.harness-jq-sidecar.$$" 2>/dev/null || true

    echo "$name"
}

# _reap_jq_sidecar — tear down this invocation's jq sidecar. Cheap no-op
# when none was created (the marker file is absent), which matters because
# this runs from the EXIT trap on every harness invocation — including
# ones that never touch jq or docker at all.
_reap_jq_sidecar() {
    local marker="${install_root}/state/.harness-jq-sidecar.$$"
    [[ -f "$marker" ]] || return 0
    harness_docker rm -f "harness-jq-$$" >/dev/null 2>&1 || true
    rm -f "$marker" 2>/dev/null || true
}

# _sweep_stale_jq_sidecars — remove jq sidecar containers whose owning
# harness process is gone (crash, SIGKILL, an exec path that replaced the
# process before its reap call). Self-healing safety net for the
# EXIT-trap / pre-exec-reap lifecycle. Best-effort and silent.
_sweep_stale_jq_sidecars() {
    local name pid
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        pid=${name#harness-jq-}
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        [[ "$pid" == "$$" ]] && continue
        # A live process under that PID means another harness invocation
        # owns the sidecar — leave it alone.
        kill -0 "$pid" 2>/dev/null && continue
        harness_docker rm -f "$name" >/dev/null 2>&1 || true
        rm -f "${install_root}/state/.harness-jq-sidecar.${pid}" 2>/dev/null || true
    done < <(harness_docker ps -a --filter 'name=harness-jq-' --format '{{.Names}}' 2>/dev/null || true)
}

# --- update-available banner ----------------------------------------------
#
# Synchronous "is harness behind origin/main?" check with a tight timeout.
# Runs `git ls-remote --heads origin main` in the foreground bounded by
# $1 seconds (default 4); on success caches the remote HEAD into
# state/.harness-update-check and prints a one-line banner to stderr if
# remote != local. On timeout / failure (offline or no remote configured)
# it falls back to the cached value from a prior successful run, so users
# behind a flaky network still get a banner if drift was previously
# detected. Either way the agent launch ALWAYS continues — this is
# advisory output, not a gate.
#
# Skipped entirely when HARNESS_SKIP_UPDATE_CHECK=1, when not in a git
# checkout, or when not on main (working from a feature branch shouldn't
# nag the user about origin/main).
#
# Used by run_agent and cmd_shell at startup with the default 4s budget,
# and by cmd_check_updates with a longer budget for an explicit foreground
# check.
_update_check_and_banner() {
    [[ "${HARNESS_SKIP_UPDATE_CHECK:-0}" == "1" ]] && return 0
    [[ -d "${install_root}/.git" ]] || return 0
    local branch
    branch=$(git -C "$install_root" symbolic-ref --short HEAD 2>/dev/null) || return 0
    [[ "$branch" == "main" ]] || return 0

    local timeout_secs="${1:-4}"
    local cache="${install_root}/state/.harness-update-check"
    local local_head remote_head
    local_head=$(git -C "$install_root" rev-parse HEAD 2>/dev/null) || return 0
    [[ -n "$local_head" ]] || return 0

    # Synchronous check, bounded so a flaky network can't stall agent
    # startup. `timeout` exits 124 on the deadline, non-zero on other
    # failures; either way we treat $remote_head as empty and fall back
    # to the cache. `|| true` is required because the script runs under
    # `set -euo pipefail` — without it, a failed ls-remote (offline,
    # missing remote, timeout) would propagate out of the pipeline and
    # abort the agent launch.
    remote_head=$(timeout "$timeout_secs" git -C "$install_root" ls-remote --heads origin main 2>/dev/null | awk '{print $1}' || true)
    if [[ -n "$remote_head" ]]; then
        mkdir -p "${install_root}/state" 2>/dev/null
        printf '%s\n' "$remote_head" >"$cache" 2>/dev/null
    elif [[ -f "$cache" ]]; then
        # Offline / lookup failed — fall back to the last value we saw.
        remote_head=$(tr -d '\r\n[:space:]' <"$cache" 2>/dev/null)
    fi
    [[ -n "$remote_head" ]] || return 0
    [[ "$remote_head" == "$local_head" ]] && return 0

    # ANSI green (32) + bold (1), reset at end. Bold green stands out against
    # most terminal themes (light + dark) and isn't reserved for errors.
    printf '\033[1;32m[harness] update available; run '\''harness upgrade'\'' to update\033[0m\n' >&2
    return 0
}

# `harness check-updates`: explicit foreground check. Reuses the same
# helper with a longer timeout, then prints an additional "up to date"
# message when there's no banner to show. Errors out only when we're not
# in a git checkout — being offline isn't fatal here either, just
# reported.
cmd_check_updates() {
    if [[ ! -d "${install_root}/.git" ]]; then
        err "not a git checkout (no $install_root/.git); update check unavailable"
        return 1
    fi
    local branch
    branch=$(git -C "$install_root" symbolic-ref --short HEAD 2>/dev/null) || branch=""
    if [[ "$branch" != "main" ]]; then
        echo "[harness] not on main (current: ${branch:-detached}); skipping update check"
        return 0
    fi
    local local_head remote_head
    local_head=$(git -C "$install_root" rev-parse HEAD 2>/dev/null)
    # `|| true` defends against pipefail aborting on offline / missing
    # remote — we want the empty-stdout path below to handle it cleanly.
    remote_head=$(timeout 10 git -C "$install_root" ls-remote --heads origin main 2>/dev/null | awk '{print $1}' || true)
    if [[ -z "$remote_head" ]]; then
        err "could not reach origin/main (offline, or no remote configured)"
        return 1
    fi
    mkdir -p "${install_root}/state" 2>/dev/null
    printf '%s\n' "$remote_head" >"${install_root}/state/.harness-update-check" 2>/dev/null
    if [[ "$remote_head" == "$local_head" ]]; then
        echo "[harness] up to date with origin/main ($(echo "$local_head" | cut -c1-7))"
        return 0
    fi
    echo "[harness] update available; run 'harness upgrade' to update"
    return 0
}

# --- agent-launch config merge --------------------------------------------
#
# Offer to merge newly-added config keys/hosts into the user's .env and
# .harness-allowlist at agent / shell launch — the same merge `harness
# upgrade` performs, but gated so the user is only prompted when something
# actually changed (e.g. a `harness update` pulled new code that introduced
# env vars or allowlist hosts, without the rebuild/restart that `harness
# upgrade` does).
#
# The precheck is pure bash + awk (upgrade_*_needs_merge against the two
# known config files) — NO jq and NO container — so when nothing changed
# this is a near-zero-cost silent no-op on every launch. Only when a merge
# is actually needed do we source-and-call the (jq-backed) merge functions.
#
# It NEVER gates the launch: headless (-p) mode, a missing tty, or the user
# declining all fall through and the agent starts normally. One prompt,
# all-or-nothing (matches `harness upgrade`).
#
# Arg 1: print_mode (1 = headless; skip entirely).
_check_and_offer_config_merge() {
    local print_mode="${1:-0}"
    (( print_mode )) && return 0
    [[ "${HARNESS_SKIP_CONFIG_MERGE:-0}" == "1" ]] && return 0
    [[ -d "$install_root" ]] || return 0

    local lib="$clone_dir/scripts/lib/upgrade_actions.sh"
    [[ -f "$lib" ]] || return 0
    # shellcheck disable=SC1090
    source "$lib"

    local env_src="$clone_dir/.env.example"
    local env_tgt="$install_root/.env"
    local allow_src="$clone_dir/.harness-allowlist.example"
    local allow_tgt="$install_root/.harness-allowlist"

    local need_env=0 need_allow=0
    if upgrade_envfile_needs_merge "$env_src" "$env_tgt"; then need_env=1; fi
    if upgrade_linefile_needs_merge "$allow_src" "$allow_tgt"; then need_allow=1; fi
    (( need_env || need_allow )) || return 0

    echo >&2
    err "new configuration is available to merge into your install:"
    (( need_env ))   && err "  - .env (new variables in .env.example)"
    (( need_allow )) && err "  - .harness-allowlist (new hostnames in .harness-allowlist.example)"

    # Need a terminal to prompt on. Interactive agent/shell launches have a
    # tty; if not, don't block — just point the user at `harness upgrade`.
    if [[ ! -t 0 && ! -e /dev/tty ]]; then
        err "run 'harness upgrade' to apply (no terminal to prompt on now)."
        return 0
    fi

    if _upgrade_confirm "merge now? [y/n] (n continues launch; run 'harness upgrade' later): "; then
        if (( need_env )); then
            upgrade_envfile_merge "$env_src" "$env_tgt" 0 >/dev/null || true
        fi
        if (( need_allow )); then
            upgrade_linefile_merge "$allow_src" "$allow_tgt" 0 >/dev/null || true
        fi
        err "configuration merged."
    else
        err "skipped; run 'harness upgrade' to apply later."
    fi
    return 0
}

# Ensure the container runtime (docker or podman) is reachable; auto-start
# Docker Desktop / podman machine on Windows / macOS if we can. Hard exit
# with a helpful message otherwise. Delegates to
# platform.sh:harness_require_docker when the library is available; falls
# back to the original probe-only check if not.
require_docker() {
    # Container subcommands need a runtime; host mode (harness host) does not.
    # Replicate harness_require_docker's reach/auto-start logic so we can append
    # the host-mode hint to its failure path (the library helper exits with its
    # own message, leaving no place to add the pointer).
    if declare -f harness_docker_running >/dev/null 2>&1; then
        harness_docker_running && return 0
        if declare -f harness_start_docker_desktop >/dev/null 2>&1 \
            && harness_start_docker_desktop; then
            return 0
        fi
        err "container runtime is required for this command but is not available."
        err "for a containerless run (no docker), use 'harness host'."
        exit 1
    fi
    # Fallback when platform.sh wasn't sourced — try docker first, then podman.
    if docker info >/dev/null 2>&1 || podman info >/dev/null 2>&1; then
        return 0
    fi
    err "container runtime (docker or podman) is not reachable; is it running?"
    err "for a containerless run (no docker), use 'harness host'."
    exit 1
}

# True if a container runtime BINARY is installed (docker or podman on PATH),
# regardless of whether its daemon is currently reachable. This distinguishes a
# HOST-ONLY install (no runtime installed at all — 'harness host' is the
# intended path, and container subcommands must adapt rather than hard-fail)
# from a normal container install whose daemon merely isn't running (which
# should be started, not silently downgraded to host mode). harness-install.sh
# allows installing with no runtime present, so this is the post-install signal
# of which world we're in. Cheap, no daemon round-trip.
harness_runtime_installed() {
    command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1
}

# Validate runtime configuration (.env presence, required vars) before
# bringing services up. Lightweight subset of `harness preflight` so users
# get a clear error before docker compose churns through a build/up cycle
# that's destined to fail in the proxy container.
require_runtime_config() {
    if [[ ! -f "$env_file" ]]; then
        err "missing $env_file"
        err "run 'harness preflight' for details, or recreate from .env.example:"
        err "  cp $clone_dir/.env.example $env_file"
        exit 1
    fi

    local missing=()
    local v
    for v in PROXY_API_URL PROXY_API_KEY DEFAULT_MODEL_NAME; do
        local val="${!v:-}"
        if [[ -z "$val" ]]; then
            missing+=("$v")
        fi
    done
    if (( ${#missing[@]} > 0 )); then
        err "required value(s) empty in $env_file: ${missing[*]}"
        err "edit $env_file and set them, then re-run. See 'harness preflight' for details."
        exit 1
    fi

    if [[ ! -f "$allowlist_path" ]]; then
        err "missing firewall allowlist at $allowlist_path"
        err "seed it from .harness-allowlist.example, or run 'harness preflight'"
        exit 1
    fi
}

# Create the install-root persistent directories if they don't exist.
ensure_dirs() {
    mkdir -p \
        "$state_root/output" \
        "$state_root/agent/home" \
        "$mcp_active_dir"
}

# Echo the -f arguments for every installed-and-enabled MCP compose snippet,
# one flag/value pair per line. Disabled MCPs are skipped (their dir stays
# but they don't get spliced into the compose stack).
#
# The emitted paths are normalized via harness_docker_path so they're in a
# form `docker.exe` accepts on Git Bash for Windows. The compose wrapper
# below runs through harness_docker, which sets MSYS_NO_PATHCONV=1 — that
# stops MSYS from auto-translating unix-style paths, so we have to convert
# them ourselves before docker sees them. Passthrough on Linux/macOS.
mcp_compose_files() {
    if [[ ! -d "$mcp_active_dir" ]]; then
        return 0
    fi
    local mcp_dir name
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -f "$mcp_dir/compose.yml" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_enabled "$name" || continue
        printf '%s\n' "-f" "$(harness_docker_path "$mcp_dir/compose.yml")"
    done
}

# True if any installed MCP is currently enabled. Drives `harness start`'s
# decision to add `--profile mcp` to the up command.
any_mcp_active() {
    if [[ ! -d "$mcp_active_dir" ]]; then
        return 1
    fi
    local mcp_dir name
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -f "$mcp_dir/compose.yml" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_enabled "$name" && return 0
    done
    return 1
}

# --- mcp state helpers ------------------------------------------------------
#
# State is tracked in <mcp_active_dir>/<name>/harness-meta.json:
#
#   {"enabled": true|false}
#
# Missing meta file == enabled (legacy default; pre-Phase-7a installs had
# no meta and were always treated as enabled). Writes are atomic via a
# temp file + mv so a crashed write can't leave half-parsed JSON.

mcp_meta_file() {
    printf '%s/%s/harness-meta.json' "$mcp_active_dir" "$1"
}

# True iff an MCP is installed. An installed entry has EITHER a compose.yml
# (a normal container MCP) OR a client-config.json (a host MCP, which runs as
# a process on the host and has no compose snippet — see mcp_is_host). data/
# survives uninstall, so a bare-directory check would refuse a clean re-install.
mcp_is_installed() {
    [[ -f "$mcp_active_dir/$1/compose.yml" || -f "$mcp_active_dir/$1/client-config.json" ]]
}

# True iff an MCP is a "host MCP": it has a client-config.json (so it is wired
# into the agent's MCP config) but NO compose.yml (so harness does not manage a
# container for it — the user runs the server on the host). The agent reaches it
# at the host.docker.internal URL recorded in its client-config.json.
mcp_is_host() {
    [[ ! -f "$mcp_active_dir/$1/compose.yml" && -f "$mcp_active_dir/$1/client-config.json" ]]
}

# True iff an MCP is enabled. Returns 0 when meta file is missing so legacy
# installs continue to behave as enabled.
mcp_is_enabled() {
    local name="$1"
    local meta
    meta=$(mcp_meta_file "$name")
    if [[ ! -f "$meta" ]]; then
        return 0
    fi
    # NOTE: jq's `//` operator treats `false` as a missing value, so
    # `.enabled // true` returns true even when enabled is explicitly
    # false. Use the explicit null-check instead. Route through harness_jq
    # (host jq when present, else the proxy container's jq) so the read is
    # correct on a docker-only host with no host jq, instead of a fragile
    # grep fallback. Single file arg → the container path maps it to stdin.
    local v
    v=$(harness_jq -r 'if .enabled == null then "true" else (.enabled | tostring) end' "$meta" 2>/dev/null || echo "true")
    [[ "$v" == "true" ]]
}

# Build the consolidated MCP tool-recency map for the proxy. For every ENABLED
# MCP under state/mcp/<name>/, read its recency.json (a bare `tool -> one-line
# description` map) and emit ONE merged JSON object keyed `<name>_<tool>` — the
# `<server>_<tool>` form opencode gives an MCP server's tools, which is how the
# proxy's recency reminder looks them up. The proxy reads this from the
# HARNESS_MCP_TOOL_RECENCY env var (see proxy.py:_setup_mcp_tool_recency and
# architecture/mcp.md "Tool recency descriptions").
#
# Source precedence per MCP (first that exists wins):
#   1. state/mcp/<name>/recency.json     explicit per-install override / authored
#   2. host-mcp/<name>/recency.json      host MCP, written by its setup agent
#   3. mcp-registry/<name>/recency.json  bundled/registry default (e.g. serena)
#
# Emits `{}` when nothing applies. A malformed file contributes nothing rather
# than failing the launch. Lines are minimal by mandate — the recency block is
# budget-constrained. Call this OUTSIDE compose() (e.g. cmd_start) so its
# harness_jq use can't re-enter the compose() runtime-override path.
mcp_tool_recency_json() {
    [[ -d "$mcp_active_dir" ]] || { printf '{}'; return 0; }
    local merged='{}' mcp_dir name src part
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -d "$mcp_dir" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_enabled "$name" || continue
        src=""
        if [[ -f "$mcp_active_dir/$name/recency.json" ]]; then
            src="$mcp_active_dir/$name/recency.json"
        elif [[ -f "$install_root/host-mcp/$name/recency.json" ]]; then
            src="$install_root/host-mcp/$name/recency.json"
        elif [[ -f "$install_root/mcp-registry/$name/recency.json" ]]; then
            src="$install_root/mcp-registry/$name/recency.json"
        fi
        [[ -n "$src" ]] || continue
        # A tool value is either a plain string (the line) or an object
        # {"line": "...", "state_check": true}; normalize both to the line,
        # keep only non-empty ones, then prefix each bare tool key with
        # "<name>_" to match opencode's exposed naming.
        part=$(harness_jq -c --arg p "${name}_" '
            (.tools // {})
            | with_entries(
                .value |= (if type == "string" then .
                           elif type == "object" then (.line // "")
                           else "" end))
            | with_entries(select((.value | type) == "string" and (.value | length) > 0))
            | with_entries(.key |= ($p + .))
        ' "$src" 2>/dev/null) || continue
        [[ -n "$part" && "$part" != "null" ]] || continue
        merged=$(harness_jq -cn --argjson a "$merged" --argjson b "$part" '$a * $b' 2>/dev/null) || continue
    done
    printf '%s' "$merged"
}

# Build a JSON array of `<server>_<tool>` names that an enabled MCP marked
# `state_check: true` in its recency.json — state-mutating tools the agent
# should orient before calling. Mirrors mcp_tool_recency_json's source
# precedence and prefixing; exported as HARNESS_MCP_STATE_CHECK, which the proxy
# renders as a `[state-check]` marker plus an orient-first reminder line. A tool
# whose recency value is a plain string contributes nothing here (only the
# object form carries the flag). Emits `[]` when nothing applies.
mcp_state_check_json() {
    [[ -d "$mcp_active_dir" ]] || { printf '[]'; return 0; }
    local merged='[]' mcp_dir name src part
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -d "$mcp_dir" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_enabled "$name" || continue
        src=""
        if [[ -f "$mcp_active_dir/$name/recency.json" ]]; then
            src="$mcp_active_dir/$name/recency.json"
        elif [[ -f "$install_root/host-mcp/$name/recency.json" ]]; then
            src="$install_root/host-mcp/$name/recency.json"
        elif [[ -f "$install_root/mcp-registry/$name/recency.json" ]]; then
            src="$install_root/mcp-registry/$name/recency.json"
        fi
        [[ -n "$src" ]] || continue
        part=$(harness_jq -c --arg p "${name}_" '
            (.tools // {})
            | to_entries
            | map(select((.value | type) == "object" and (.value.state_check == true)))
            | map($p + .key)
        ' "$src" 2>/dev/null) || continue
        [[ -n "$part" && "$part" != "null" ]] || continue
        merged=$(harness_jq -cn --argjson a "$merged" --argjson b "$part" '$a + $b | unique' 2>/dev/null) || continue
    done
    printf '%s' "$merged"
}

# Set meta.enabled to "true" or "false" atomically. Creates the file if it
# doesn't already exist.
mcp_set_enabled() {
    # Name-based wrapper over the path-based _mcp_set_enabled_file (defined
    # alongside the register helpers). register writes a staging meta directly
    # via the path-based form before the entry is named.
    _mcp_set_enabled_file "$(mcp_meta_file "$1")" "$2"
}

# Generate the runtime override file in-place. The file is rewritten on
# every invocation that runs `compose`, so toggling state via
# `harness net open/close` propagates immediately on the next
# `harness start` / `harness restart`.
#
# Two pieces of state can land in the override:
#   1. .harness-net-overrides.json — per-service `firewall_disabled: true`
#      becomes an environment block on that service that the firewall
#      init-script honors as an opt-out.
#   2. prompt_mode_override — an ephemeral `--prompt-mode <mode>` from this
#      start/restart invocation, injected as PROXY_PROMPT_MODE on the proxy
#      service. Folded into the proxy block from (1) when proxy also has a
#      firewall opt-out, so only one `proxy:` mapping is emitted.
#
# When both are empty the override file is removed entirely (compose
# is invoked without the -f flag). This keeps `harness start` exactly as it
# was for installs that don't use any of these features.
write_runtime_override() {
    # Build the body in a temp variable, write only if non-empty.
    local body=""

    # 1. Per-service firewall opt-out.
    #
    # Every service that has firewall_disabled=true in the JSON gets a
    # `HARNESS_FIREWALL_DISABLED=1` env entry. The firewall init script
    # short-circuits on that variable. We never replace the service's
    # entrypoint or remove its cap_add — option A from the design docs.
    #
    # The 'agent' pseudo-service is filtered out here: agent containers
    # are not in the compose model (they're started by direct docker run
    # from run_agent / cmd_shell). The agent launch path
    # reads the override file directly. Emitting a services.agent block
    # would either create a phantom compose service or trigger validation
    # warnings depending on the compose version.
    #
    # Recursion guard: harness_jq's container fallback runs `compose build
    # proxy` when the proxy image isn't built yet, and compose() calls
    # write_runtime_override at its top. Without the guard a jq-less host
    # would re-enter here and call harness_jq again → infinite recursion.
    # On the re-entrant call we skip this block: the `compose build proxy`
    # invocation has no use for per-service overrides, and the outer call
    # still emits them once its harness_jq returns. `local` gives the flag
    # dynamic scope so it clears automatically when the outer call returns.
    local proxy_emitted=0
    if [[ -f "$net_overrides_path" && -z "${_harness_wro_in_progress:-}" ]]; then
        local _harness_wro_in_progress=1
        local svc
        while IFS= read -r svc; do
            svc=${svc%$'\r'}
            [[ -z "$svc" ]] && continue
            [[ "$svc" == "agent" ]] && continue
            body+="  ${svc}:"$'\n'
            body+="    environment:"$'\n'
            body+="      HARNESS_FIREWALL_DISABLED: \"1\""$'\n'
            # Fold an ephemeral --prompt-mode override into the SAME proxy
            # environment block rather than emitting a second `proxy:` mapping
            # below (duplicate top-level service keys are invalid compose YAML).
            if [[ "$svc" == "proxy" && -n "$prompt_mode_override" ]]; then
                body+="      PROXY_PROMPT_MODE: \"${prompt_mode_override}\""$'\n'
                proxy_emitted=1
            fi
        done < <(harness_jq -r '
            (.services // {})
            | to_entries[]
            | select(.value.firewall_disabled == true)
            | .key
        ' "$net_overrides_path" 2>/dev/null || true)
    fi

    # 2. Ephemeral cooperative-prompt mode (`start/restart --prompt-mode`).
    # Injected into the proxy container env for this launch only. If the
    # firewall loop above already emitted a `proxy:` block we appended it
    # there; otherwise emit a standalone block here.
    if [[ -n "$prompt_mode_override" && "$proxy_emitted" -eq 0 ]]; then
        body+="  proxy:"$'\n'
        body+="    environment:"$'\n'
        body+="      PROXY_PROMPT_MODE: \"${prompt_mode_override}\""$'\n'
    fi

    if [[ -z "$body" ]]; then
        rm -f "$runtime_override"
        return 0
    fi
    mkdir -p "$(dirname "$runtime_override")"
    {
        echo "# Generated by harness; do not edit. Regenerated on every invocation."
        echo "services:"
        printf '%s' "$body"
    } >"$runtime_override"
}

# Wrap `<runtime> compose` with all the args we always pass. The runtime is
# either `docker` or `podman` (see scripts/lib/platform.sh:harness_container_runtime).
# Both runtimes accept `compose` as a subcommand: docker uses its compose v2
# plugin, podman 4.x+ ships a built-in `podman compose` that delegates to
# docker-compose / podman-compose under the hood.
#
# INSTALL_ROOT, HARNESS_ALLOWLIST_PATH, and HARNESS_PROJECTS_ROOT are exported
# so MCP compose snippets can reference them via plain ${VAR} (no defaults).
# The fallback for HARNESS_PROJECTS_ROOT is computed here in bash rather than
# in YAML because compose's interpolation parser doesn't reliably resolve
# nested defaults like ${A:-${B}} — keeping compose snippets to single-level
# ${VAR} references avoids that whole class of bug.
compose() {
    write_runtime_override
    # Host paths passed to docker compose must be pre-translated on Git Bash
    # for Windows: harness_docker (below) sets MSYS_NO_PATHCONV=1 so MSYS
    # won't auto-translate args, and docker.exe interprets `/c/Users/...`
    # literally as `C:\c\Users\...`. harness_docker_path runs cygpath -m on
    # Windows and is a no-op on Linux/macOS.
    local args=(
        compose
        --project-name "$project_name"
        -f "$(harness_docker_path "$clone_dir/docker-compose.yml")"
    )
    if [[ -f "$env_file" ]]; then
        args+=(--env-file "$(harness_docker_path "$env_file")")
    fi
    if [[ -f "$runtime_override" ]]; then
        args+=(-f "$(harness_docker_path "$runtime_override")")
    fi

    # Splice in any active MCP compose snippets. Each one assumes the
    # external network harness_harness-net is reachable; it is iff this
    # project's compose has already been brought up (see cmd_start).
    local mcp_arg
    while IFS= read -r mcp_arg; do
        [[ -n "$mcp_arg" ]] && args+=("$mcp_arg")
    done < <(mcp_compose_files)

    # HARNESS_PROJECTS_ROOT may be set in .env (which compose reads via
    # --env-file) or absent. If absent, fall back to the host's $HOME so
    # the serena bind-mount always has a non-empty source.
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"

    # HARNESS_HOST_OS lets the proxy tell agents which host platform the user
    # will reproduce work on (the proxy itself always runs in a Linux
    # container). docker-compose.yml passes it to the proxy service; the proxy
    # injects it into the recency reminder's Environment line.
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        HARNESS_HOST_OS="$(harness_detect_os)" \
        harness_docker "${args[@]}" "$@"
}

# Best-effort check: is the proxy running for this project?
services_up() {
    local proxy_id
    proxy_id=$(compose ps -q proxy 2>/dev/null || true)
    [[ -n "$proxy_id" ]] || return 1
    harness_docker inspect -f '{{.State.Running}}' "$proxy_id" 2>/dev/null | grep -q '^true$' || return 1
    return 0
}

# Bring services up if they aren't already. Used before launching agents.
ensure_services_up() {
    if ! services_up; then
        echo "harness: services not running; starting..."
        cmd_start
    fi
    # Reconcile host MCPs on every launch (idempotent): a host MCP may have been
    # registered, or its process died, since the container stack came up. Cheap
    # when they're already running (a kill -0 liveness check each).
    host_mcp_start_enabled
}

# Tear down the shared stack (proxy + enabled MCPs, both container and host)
# when no agent containers remain for this project. Called from the agent
# launch paths on exit. The stack's lifecycle is bound to the agents':
# `ensure_services_up` brings it up on launch and the last agent to exit brings
# it down, so the control plane never lingers with no agent using it. The
# just-exited interactive agent's own container is already gone (--rm), so a
# zero count means it was the last one. Both interactive and print agents carry
# the `harness.agent` label, so a concurrent agent of either kind keeps the
# count non-zero and holds the stack up until the final interactive exit.
stop_stack_if_last_agent() {
    local remaining
    remaining=$(harness_docker ps -q \
        --filter "label=harness.project=$project_name" \
        --filter "label=harness.agent=true" 2>/dev/null | wc -l | tr -d ' ')
    [[ "$remaining" == "0" ]] || return 0
    echo "[harness] last agent exited; stopping proxy/MCP" >&2
    # Best-effort teardown, in a subshell: cmd_down → require_docker can `exit 1`
    # if the runtime probe fails, and a bare `cmd_down ... || true` catches only a
    # non-zero *return*, not an `exit`. Without the subshell that `exit` would
    # terminate run_agent_interactive before it propagates the container's exit
    # code via `exit "$rc"` (#81). Isolating it means a failed teardown is a no-op
    # for the caller, never a clobbered exit status.
    ( cmd_down ) >/dev/null 2>&1 || true
}

# Unique container name for one agent launch. Discovery (list/stop/picker)
# is entirely label-based (harness.agent/tool/mount), so the name needs no
# determinism — only uniqueness, so concurrent launches of the same tool
# from the same directory never collide on Docker's unique-name constraint.
agent_container_name() {
    local tool="$1"
    local rand
    if ! { [[ -r /dev/urandom ]] && rand=$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n') && [[ -n "$rand" ]]; }; then
        # /dev/urandom unavailable: mix the PID with two $RANDOM draws.
        rand=$(printf '%s' "$$:$RANDOM:$RANDOM" | sha256sum | cut -c1-8)
    fi
    printf 'harness-%s-%s' "$tool" "$rand"
}

# Pre-launch check: if the firewall is currently disabled (either via --net
# for this invocation or via persistent `harness net open <service>` state),
# print a loud warning and prompt the user before continuing.
#
# Args: <agent_net_open_int> <tool>
# Returns: 0 to proceed, 1 to abort.
#
# HARNESS_NET_CONFIRM=1 short-circuits the prompt (used by tests and by
# users who've decided they don't want to be re-prompted every launch).
warn_if_firewall_open() {
    local agent_net_open="${1:-0}"
    local tool="${2:-agent}"

    local warn_messages=()
    if (( agent_net_open )); then
        warn_messages+=("This agent is being launched with --net (firewall DISABLED for this invocation).")
    fi
    if [[ -f "$net_overrides_path" ]]; then
        local opened
        opened=$(harness_jq -r '
            (.services // {})
            | to_entries[]?
            | select(.value.firewall_disabled == true)
            | .key
        ' "$net_overrides_path" 2>/dev/null || true)
        if [[ -n "$opened" ]]; then
            local list
            list=$(printf '%s' "$opened" | tr '\n' ' ' | sed 's/ *$//')
            warn_messages+=("These services are running with firewall DISABLED: $list")
        fi
    fi

    if (( ${#warn_messages[@]} == 0 )); then
        return 0
    fi

    echo >&2
    echo "WARNING: NETWORK FIREWALL IS DISABLED" >&2
    local msg
    for msg in "${warn_messages[@]}"; do
        echo "  ! $msg" >&2
    done
    echo >&2
    echo "Network egress from these contexts is NOT filtered by the harness allowlist." >&2
    echo >&2

    if [[ "${HARNESS_NET_CONFIRM:-0}" == "1" ]]; then
        echo "  (auto-confirmed via HARNESS_NET_CONFIRM=1)" >&2
        return 0
    fi

    if [[ ! -e /dev/tty ]]; then
        err "non-interactive shell without /dev/tty; refusing to launch $tool"
        err "set HARNESS_NET_CONFIRM=1 to skip this prompt in automation"
        return 1
    fi

    local ans
    printf 'Continue starting %s? [y/n]: ' "$tool" >&2
    if ! IFS= read -r ans </dev/tty; then
        err "no input received; aborting"
        return 1
    fi
    case "${ans:-}" in
        y|Y|yes|YES) return 0 ;;
        *) err "aborted by user"; return 1 ;;
    esac
}

# --- subcommands ------------------------------------------------------------

# Probe the upstream API to verify the key is valid and unlocked. Returns:
#   0 — key works, proceed
#   1 — auth failed; the launch must abort. Two sub-cases, both print a
#       prominent banner: a LOCKED key (401/403 carrying a recoverable unlock
#       URL, shown so the user can re-enable it), or a REJECTED key (401/403
#       with no unlock URL and no "key-is-fine" error type — #108). The agent
#       cannot launch until the key is fixed/unlocked.
#   2 — upstream unhealthy or returned a non-actionable, key-is-fine error
#       (5xx, 429, network failure, OR a 401/403 whose error.type is in the
#       invalid_request family — #43: the probe request was malformed but the
#       key itself is valid). Warn but allow proceed.
#
# Why a no-unlock-URL 401/403 aborts by default (#108): a rejected key
# otherwise warned-and-continued, dropping the user into an agent with NO
# models registered and nothing working. A 401 means "Unauthorized" — stop —
# UNLESS the upstream positively says the *request* (not the key) was
# malformed via an invalid_request-family error.type (#43), the one case still
# allowed to warn-and-continue. An empty/unknown type on a 401/403 is treated
# as auth failure. HARNESS_SKIP_AUTH_PROBE=1 bypasses the probe entirely.
#
# Why we always dump the response body on a 401/403: providers vary in
# how they shape error responses, and an unlock_url (or error type) under an
# unexpected JSON path is unhelpfully invisible. Printing the raw body means
# the user can always see what came back, even if our field extraction
# missed something.
# Normalize PROXY_API_URL to a scheme://host[/prefix] base, mirroring
# proxy.py's _normalize_api_base. PROXY_API_URL is a base; the chat endpoint is
# {base}/v1/chat/completions and the models endpoint is {base}/v1/models. Strip
# a trailing full chat URL or /v1 first so either form works. Keep in sync with
# proxy/proxy.py.
_api_base() {
    local base="${PROXY_API_URL:-}"
    base="${base%/}"
    case "$base" in
        */v1/chat/completions) base="${base%/v1/chat/completions}" ;;
        */chat/completions)    base="${base%/chat/completions}" ;;
    esac
    base="${base%/}"
    base="${base%/v1}"
    base="${base%/}"
    printf '%s' "$base"
}

# Decide whether a 401/403 with no unlock URL is the #43 "key is fine, the probe
# request was bad" case (warn and continue) rather than the #108 "rejected key"
# case (abort). Only an upstream error.type in the invalid_request family
# qualifies; an empty or unrecognized type falls through to abort. The allowlist
# is deliberately tight — calibrated on the only key-is-fine type observed.
_auth_probe_type_is_request_error() {
    local t
    t=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
    case "$t" in
        invalid_request*) return 0 ;;
        *) return 1 ;;
    esac
}

_probe_upstream_auth() {
    local api_url
    api_url="$(_api_base)/v1/chat/completions"
    local api_key="${PROXY_API_KEY:-}"
    local api_model="${DEFAULT_MODEL_NAME:-}"

    if [[ -z "${PROXY_API_URL:-}" || -z "$api_key" ]]; then
        # Missing config; let other validators surface this clearly.
        return 0
    fi

    if ! command -v curl >/dev/null 2>&1; then
        # Probe needs curl. Surface it and let the user proceed without
        # the probe — other validators will catch a fundamentally broken
        # setup.
        echo "[harness] WARN: curl not available on host; skipping upstream auth probe" >&2
        return 2
    fi

    # Cheapest possible request: max_tokens=1, body just ".".
    local probe_body
    probe_body=$(printf '{"model":"%s","messages":[{"role":"user","content":"."}],"max_tokens":1}' \
        "${api_model:-default}")

    local response status_code body
    response=$(curl -sSL -k -w "\n__HTTP_STATUS__%{http_code}" \
        --connect-timeout 5 --max-time 30 \
        -X POST "$api_url" \
        -H "Authorization: Bearer $api_key" \
        -H "Content-Type: application/json" \
        -d "$probe_body" 2>&1) || true

    status_code=$(grep -o "__HTTP_STATUS__[0-9]*$" <<<"$response" | sed 's/__HTTP_STATUS__//')
    body=$(sed 's/__HTTP_STATUS__[0-9]*$//' <<<"$response" | sed '$ s/[[:space:]]*$//')

    # No status = curl failed entirely (network / DNS / connection).
    if [[ -z "$status_code" ]]; then
        echo "[harness] WARN: upstream auth probe failed (network/connection)" >&2
        echo "[harness]       starting anyway; agents may fail until upstream is reachable" >&2
        return 2
    fi

    case "$status_code" in
        2*)
            return 0
            ;;
        401|403)
            # Provider error shapes vary. Try Anthropic-style nesting
            # (.error.unlock_url), the metadata variant, and a top-level
            # fallback. Same for type/message. jq is preferred when present;
            # the grep fallback handles well-formed JSON when host jq is
            # absent (common on Windows Git Bash).
            local unlock_url="" err_type="" err_message=""
            if command -v jq >/dev/null 2>&1; then
                unlock_url=$(jq -r '.error.unlock_url // .error.metadata.unlock_url // .unlock_url // empty' <<<"$body" 2>/dev/null || true)
                err_type=$(jq -r '.error.type // .type // empty' <<<"$body" 2>/dev/null || true)
                err_message=$(jq -r '.error.message // .message // empty' <<<"$body" 2>/dev/null || true)
            fi
            if [[ -z "$unlock_url" ]]; then
                unlock_url=$(grep -oE '"unlock_url"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$body" \
                    | head -1 \
                    | sed 's/"unlock_url"[[:space:]]*:[[:space:]]*"\(.*\)"/\1/')
            fi
            if [[ -z "$err_message" ]]; then
                err_message=$(grep -oE '"message"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$body" \
                    | head -1 \
                    | sed 's/"message"[[:space:]]*:[[:space:]]*"\(.*\)"/\1/')
            fi
            if [[ -z "$err_type" ]]; then
                err_type=$(grep -oE '"type"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$body" \
                    | head -1 \
                    | sed 's/"type"[[:space:]]*:[[:space:]]*"\(.*\)"/\1/')
            fi

            if [[ -n "$unlock_url" ]]; then
                # Actionable lockout: deliver the URL, abort the launch.
                echo "" >&2
                echo "================================================================" >&2
                echo " ERROR: Upstream API key is locked" >&2
                echo "================================================================" >&2
                [[ -n "$err_type" ]]    && echo " upstream error type: $err_type" >&2
                [[ -n "$err_message" ]] && echo " upstream message:    $err_message" >&2
                echo "" >&2
                echo " Visit this URL in your browser to unlock the key:" >&2
                echo "" >&2
                echo "   $unlock_url" >&2
                echo "" >&2
                echo " You must be signed in to the provider's web console for" >&2
                echo " the unlock to take effect." >&2
                echo "" >&2
                echo " Full upstream response body:" >&2
                printf '%s\n' "$body" | sed 's/^/   /' >&2
                echo "================================================================" >&2
                echo "" >&2
                return 1
            fi

            # No unlock URL recovered. #43 carve-out: if the upstream says the
            # probe *request* was malformed (invalid_request-family type), the
            # key is fine — warn and continue. Anything else on a 401/403 is a
            # rejected key; abort so the proxy never starts with a key that
            # can't reach the upstream.
            if _auth_probe_type_is_request_error "$err_type"; then
                echo "" >&2
                echo "[harness] WARN: upstream returned $status_code on the auth probe, but the" >&2
                echo "[harness]       error type ($err_type) says the probe REQUEST—not the API" >&2
                echo "[harness]       key—was rejected, so the launch will continue." >&2
                [[ -n "$err_message" ]] && echo "[harness]       upstream message:    $err_message" >&2
                echo "[harness]       Full upstream response body:" >&2
                printf '%s\n' "$body" | sed 's/^/[harness]         /' >&2
                echo "[harness]       To bypass this probe entirely, set HARNESS_SKIP_AUTH_PROBE=1." >&2
                echo "" >&2
                return 2
            fi

            # Rejected key (#108): a 401/403 with no unlock URL and no
            # key-is-fine error type. Abort with an actionable banner instead of
            # warning and dropping the user into an agent with no models.
            echo "" >&2
            echo "================================================================" >&2
            echo " ERROR: Upstream rejected the API key (HTTP $status_code)" >&2
            echo "================================================================" >&2
            [[ -n "$err_type" ]]    && echo " upstream error type: $err_type" >&2
            [[ -n "$err_message" ]] && echo " upstream message:    $err_message" >&2
            echo "" >&2
            echo " This usually means PROXY_API_KEY in your .env is wrong:" >&2
            echo "   - a stray character (e.g. a leading '/') or surrounding quotes" >&2
            echo "   - a truncated or mis-pasted key, or an expired key" >&2
            echo " A valid key is a JWT and starts with 'eyJ'. Run 'harness doctor'" >&2
            echo " to see it as <first4>...<last4>." >&2
            echo "" >&2
            echo " Full upstream response body:" >&2
            printf '%s\n' "$body" | sed 's/^/   /' >&2
            echo "" >&2
            echo " To bypass this probe, set HARNESS_SKIP_AUTH_PROBE=1." >&2
            echo "================================================================" >&2
            echo "" >&2
            return 1
            ;;
        429)
            echo "[harness] WARN: upstream rate-limited (429); starting anyway" >&2
            return 2
            ;;
        5*)
            echo "[harness] WARN: upstream returned $status_code; starting anyway" >&2
            return 2
            ;;
        *)
            echo "[harness] WARN: upstream returned unexpected status $status_code; starting anyway" >&2
            return 2
            ;;
    esac
}

# Wrapper used by both `cmd_start` and `run_agent` (opencode launch).
# Runs `_probe_upstream_auth` and converts its tri-state return into the
# desired control flow:
#   rc=0 → key OK, return 0
#   rc=1 → locked/invalid, return 1 (caller aborts, unlock URL already printed)
#   rc=2 → upstream unhealthy, return 0 (warn already logged, allow proceed)
# HARNESS_SKIP_AUTH_PROBE=1 bypasses the probe entirely (CI / offline use).
_gate_on_upstream_auth() {
    if [[ "${HARNESS_SKIP_AUTH_PROBE:-0}" == "1" ]]; then
        return 0
    fi
    local probe_rc=0
    _probe_upstream_auth || probe_rc=$?
    if (( probe_rc == 1 )); then
        return 1
    fi
    return 0
}

# Best-effort: print the upstream's model catalog at start so the user sees
# what's available. Tolerant of an unreachable upstream (e.g. tests where the
# upstream is an in-network mock the host can't reach) — the agent entrypoint
# discovers the available models from the proxy's /v1/models route at
# config-build time. Only a locked-key 401/403 carrying an unlock URL returns 1
# (aborting the start, mirroring _gate_on_upstream_auth). HARNESS_SKIP_AUTH_PROBE=1
# bypasses it.
_print_upstream_models() {
    [[ "${HARNESS_SKIP_AUTH_PROBE:-0}" == "1" ]] && return 0
    [[ -z "${PROXY_API_URL:-}" || -z "${PROXY_API_KEY:-}" ]] && return 0
    command -v curl >/dev/null 2>&1 || return 0

    local url response status body
    url="$(_api_base)/v1/models"
    response=$(curl -sSL -k -w $'\n__HTTP_STATUS__%{http_code}' \
        --connect-timeout 5 --max-time 30 \
        -H "Authorization: Bearer ${PROXY_API_KEY}" \
        "$url" 2>&1) || true
    status=$(grep -o '__HTTP_STATUS__[0-9]*$' <<<"$response" | sed 's/__HTTP_STATUS__//')
    body=$(sed 's/__HTTP_STATUS__[0-9]*$//' <<<"$response")

    if [[ -n "$status" && "${status:0:1}" == "2" ]]; then
        local ids=""
        if command -v jq >/dev/null 2>&1; then
            ids=$(jq -r '.data[].id // empty' <<<"$body" 2>/dev/null | paste -sd ' ' - || true)
        fi
        [[ -n "$ids" ]] && echo "[harness] upstream models available: $ids"
        return 0
    fi

    case "$status" in
        401|403)
            local unlock_url=""
            if command -v jq >/dev/null 2>&1; then
                unlock_url=$(jq -r '.error.unlock_url // .error.metadata.unlock_url // .unlock_url // empty' <<<"$body" 2>/dev/null || true)
            fi
            if [[ -n "$unlock_url" ]]; then
                echo "" >&2
                echo "[harness] ERROR: upstream API key is locked (models endpoint returned $status)." >&2
                echo "[harness]   Visit this URL in a signed-in browser to unlock it:" >&2
                echo "[harness]   $unlock_url" >&2
                echo "" >&2
                return 1
            fi
            ;;
    esac
    # Unreachable / non-actionable: don't block. The agent falls back to
    # DEFAULT_MODEL_NAME and the proxy surfaces real errors later.
    return 0
}

cmd_unlock() {
    # Run the same probe `cmd_start` runs. On locked, prints the unlock URL.
    # On success, prints "key OK". Useful for mid-session lockouts: user
    # runs this, sees the URL, unlocks in the browser, and the agent's
    # next request goes through.
    if _probe_upstream_auth; then
        echo "[harness] upstream API key is OK; no unlock needed"
        return 0
    fi
    return 1
}

