# Parse the optional `--prompt-mode <mode>` flag out of start/restart args and
# set the global prompt_mode_override (validated against the three modes the
# proxy accepts). The mode is ephemeral — see prompt_mode_override and
# write_runtime_override. Any other argument is rejected so a typo doesn't pass
# silently. Accepts both `--prompt-mode hybrid` and `--prompt-mode=hybrid`.
_parse_prompt_mode_flag() {
    while (( $# )); do
        case "$1" in
            --prompt-mode)
                shift
                prompt_mode_override="${1:-}"
                if [[ -z "$prompt_mode_override" ]]; then
                    err "--prompt-mode requires a value (hybrid, user_front, or passthrough)"
                    exit 1
                fi
                ;;
            --prompt-mode=*)
                prompt_mode_override="${1#--prompt-mode=}"
                ;;
            *)
                err "unknown option '$1' (start/restart accept only --prompt-mode <mode>)"
                exit 1
                ;;
        esac
        shift
    done
    case "$prompt_mode_override" in
        ""|hybrid|user_front|passthrough) ;;
        *)
            err "invalid --prompt-mode '$prompt_mode_override' (expected hybrid, user_front, or passthrough)"
            exit 1
            ;;
    esac
}

cmd_start() {
    _parse_prompt_mode_flag "$@"
    require_runtime_config
    require_docker
    ensure_dirs

    # Probe the upstream auth state before bringing up the stack. A locked
    # key reads as a confusing chain of failures once agents start hitting
    # the proxy; surfacing it here lets the user click through the unlock
    # URL before any container has tried to talk to the upstream.
    _gate_on_upstream_auth || return 1

    # Print the upstream model catalog (best-effort; aborts only on a locked
    # key). The agent entrypoint discovers models from the proxy's /v1/models
    # route at config-build time.
    _print_upstream_models || return 1

    # Stop anything still running from a prior session so up brings a clean
    # state. The 2>/dev/null || true handles a fresh install where there's
    # nothing to stop. --remove-orphans is required because `compose` only
    # splices in -f for currently-enabled MCPs; a previously-enabled MCP that
    # was disabled becomes an orphan container without it and would never
    # actually go down on `harness start`.
    compose down --remove-orphans 2>/dev/null || true

    # HARNESS_NO_BUILD=1 skips the --build flag — useful when all needed
    # images already exist locally and re-running buildkit (which can pull
    # the build context from git for some MCPs, e.g. Serena) is wasteful
    # or impossible due to disk pressure. CI/integration tests pre-warm
    # the heavy images and then set this for the actual harness start.
    local build_flag=(--build)
    if [[ "${HARNESS_NO_BUILD:-0}" == "1" ]]; then
        build_flag=()
    fi

    # Consolidate enabled MCPs' tool-recency descriptions into one env var the
    # proxy reads at startup. Computed here (not in compose()) and exported so
    # docker-compose.yml interpolates it into the proxy service env, mirroring
    # HARNESS_HOST_OS. Recomputed on every start/restart, so editing a
    # recency.json takes effect on the next `harness restart`.
    export HARNESS_MCP_TOOL_RECENCY="$(mcp_tool_recency_json)"
    # Companion array: tools flagged state_check in recency.json. The proxy marks
    # them [state-check] and adds an orient-first reminder. Same per-start
    # recompute as the recency map above.
    export HARNESS_MCP_STATE_CHECK="$(mcp_state_check_json)"

    # Active MCPs sit behind the `mcp` profile so they're only brought up
    # when something has been `harness mcp enable`d. Without --profile they
    # are silently ignored even though the -f file is on the compose argv.
    local up_rc=0
    if any_mcp_active; then
        compose --profile mcp up -d "${build_flag[@]}" || up_rc=$?
    else
        compose up -d "${build_flag[@]}" || up_rc=$?
    fi

    # When compose fails (typically a service container failing its
    # healthcheck), print actionable diagnostics. Without this hint the
    # user sees only "dependency failed to start: container ... is
    # unhealthy" with no guidance on how to look inside.
    if (( up_rc != 0 )); then
        echo
        echo "[harness] start failed (exit $up_rc). Common causes:"
        echo "  - PROXY_API_URL or PROXY_API_KEY missing/wrong in .env"
        echo "  - Upstream API hostname not in .harness-allowlist"
        echo "  - Stale Docker resources (try: harness down)"
        echo
        echo "To diagnose, run:"
        echo "  harness preflight                   # validates configuration"
        echo "  $(harness_container_runtime) logs harness-proxy-1         # what the proxy printed on startup"
        return $up_rc
    fi

    # Bring enabled host MCPs (non-container processes on the host) up alongside
    # the container stack, so a bare `harness start` / `harness` starts them too.
    host_mcp_start_enabled
}

cmd_down() {
    # The host proxy (harness host) runs outside the container stack, so tear it
    # down here too — a no-op when nothing is running. Done before require_docker
    # so both a host-only box (no runtime) and a leftover 'harness host -p' proxy
    # on a container box get cleaned up by the muscle-memory teardown verb.
    host_proxy_stop

    # Host-only install: there is no container stack to tear down. Stop any host
    # MCP processes and return rather than hard-failing on require_docker.
    if ! harness_runtime_installed; then
        host_mcp_stop_all
        return 0
    fi

    require_docker

    # Stop any agent containers attached to this project's network. They were
    # started by `harness opencode` via direct docker run (not
    # compose), so compose doesn't know about them — but they hold the
    # network in use, blocking compose's network teardown and forcing the
    # user to clean up by hand.
    local agent_cids
    agent_cids=$(harness_docker ps -q \
        --filter "label=harness.project=$project_name" \
        --filter "label=harness.agent=true" 2>/dev/null)
    if [[ -n "$agent_cids" ]]; then
        local agent_names
        agent_names=$(harness_docker ps \
            --filter "label=harness.project=$project_name" \
            --filter "label=harness.agent=true" \
            --format '{{.Names}}' | tr '\n' ' ')
        echo "[harness] stopping agent containers: $agent_names"
        # shellcheck disable=SC2086
        harness_docker stop $agent_cids >/dev/null 2>&1 || true
        # shellcheck disable=SC2086
        harness_docker rm -f $agent_cids >/dev/null 2>&1 || true
    fi

    # Stop supervised host MCP processes too: they have no container, so the
    # compose teardown below never touches them. Bound to the stack's lifecycle
    # like everything else — `harness down` (and last-agent teardown, which
    # calls it) brings them down with the rest.
    host_mcp_stop_all

    # Belt-and-suspenders: clear jq sidecars leaked by crashed harness
    # invocations. The EXIT trap and pre-exec reaps handle the common
    # cases; this catches the rest on an explicit teardown.
    _sweep_stale_jq_sidecars

    # Active MCPs sit behind the `mcp` profile (mirrors cmd_start). Without
    # --profile they're silently ignored even though their -f file is on the
    # compose argv, so a bare `down` orphans the enabled MCP container and the
    # network teardown then fails ("resource is still in use").
    if any_mcp_active; then
        compose --profile mcp down "$@"
    else
        compose down "$@"
    fi
}

# Restart core services. Convenience for the common "I edited .env or
# .harness-allowlist or .harness-net-overrides and want it picked up" loop.
# Implementation is exactly down + start so any future change to either is
# inherited automatically.
cmd_restart() {
    _parse_prompt_mode_flag "$@"
    # 'restart' manages the container stack; it has no meaning on a host-only
    # box, where host mode is launched directly. Give clear guidance instead of
    # hard-failing on require_docker with a generic docker-required error.
    if ! harness_runtime_installed; then
        err "no container runtime: 'restart' manages the container stack."
        err "for host mode, stop and relaunch directly: harness host down && harness host"
        return 1
    fi
    require_docker
    cmd_down
    # prompt_mode_override is already set as a global; cmd_start re-parses an
    # empty arg list (a no-op that leaves the global intact).
    cmd_start
}

cmd_update() {
    # Code-only fast-forward pull. On a diverged history it offers the same
    # interactive `reset --hard` recovery as `harness upgrade` (no auto-reset
    # without confirmation; aborts as before when there's no terminal).
    if ! _upgrade_pull_or_reset 1; then
        err "update aborted"
        return 1
    fi
}

# y/n confirmation prompt for cmd_upgrade. Reads from /dev/tty by default
# to insulate the prompt from any stdin/terminal residue left by upstream
# subprocesses. On Windows Git Bash the harness_jq Docker fallback runs
# `docker.exe -i` immediately before this prompt; docker.exe interacts
# with the parent ConPTY and can leave the regular stdin in a state where
# `read` from FD 0 hangs even when the user types a valid response.
# Reading from /dev/tty bypasses that. Mirrors pick_agent's prompt.
#
# The trailing \r strip is defensive against MSYS line endings — same
# motivation as the CR fixes elsewhere in this script.
#
# HARNESS_CONFIRM_FROM_STDIN=1 reads from FD 0 instead of /dev/tty; this
# is a test hook only — production callers must leave it unset.
#
# Returns 0 to proceed, 1 to abort. y/Y/yes/YES proceed; n/N/no/NO and any
# other keystroke abort. An empty answer (Enter) resolves to the optional
# second argument `default`: "y" → proceed (the historical behavior, kept
# for existing callers), "n" → abort (used by destructive prompts like the
# divergence reset). Defaults to "y" so callers that omit it are unchanged.
_upgrade_confirm() {
    local prompt="$1"
    local default="${2:-y}"
    local ans
    if [[ "${HARNESS_CONFIRM_FROM_STDIN:-0}" == "1" ]]; then
        IFS= read -rp "$prompt" ans || ans=""
    else
        IFS= read -rp "$prompt" ans </dev/tty
    fi
    ans=${ans%$'\r'}
    if [[ -z "${ans:-}" ]]; then
        case "$default" in
            n|N) return 1 ;;
            *)   return 0 ;;
        esac
    fi
    case "$ans" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# Resolve the upstream tracking ref of the clone's current branch (e.g.
# "origin/dev"), or empty if the branch has no upstream configured.
_git_upstream_ref() {
    git -C "$clone_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null
}

# Return 0 if the clone's HEAD and its upstream have genuinely DIVERGED —
# each carries commit(s) the other lacks — and 1 otherwise (no upstream,
# fast-forwardable, only-ahead, identical, or any git error). Divergence is
# the one state where `git pull --ff-only` cannot proceed yet a
# `reset --hard @{u}` is a meaningful recovery: a merely-behind branch
# fast-forwards on its own, and a merely-ahead branch has nothing upstream
# to reset to. Callers must fetch first so @{u} reflects the real remote.
_git_branches_diverged() {
    local counts behind ahead
    # `@{u}...HEAD` with --left-right --count prints "<behind>\t<ahead>":
    # left = commits in upstream not in HEAD, right = commits in HEAD not
    # in upstream.
    counts=$(git -C "$clone_dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null) || return 1
    behind=${counts%%[[:space:]]*}
    ahead=${counts##*[[:space:]]}
    [[ "$behind" =~ ^[0-9]+$ && "$ahead" =~ ^[0-9]+$ ]] || return 1
    if (( behind > 0 && ahead > 0 )); then
        return 0
    fi
    return 1
}

# Pull latest code into the clone, recovering from a diverged history when
# possible. Returns 0 if the working tree is now at the upstream tip (the
# pull fast-forwarded, OR the user accepted a reset), non-zero if the
# caller should abort its operation.
#
# On an --ff-only failure we re-fetch and check for true divergence. Only
# then — and only when allow_prompt=1 with a terminal available — do we
# offer a `git reset --hard @{u}`. Any other failure (offline, dirty tree,
# no upstream) aborts unchanged, and CI / --no-prompt (allow_prompt=0)
# never auto-resets: silently discarding history is too dangerous for
# automation. .env, .harness-allowlist and state/ are gitignored, so a
# reset only rolls back tracked harness code — user config/state survive.
_upgrade_pull_or_reset() {
    local allow_prompt="${1:-0}"

    if git -C "$clone_dir" pull --ff-only; then
        return 0
    fi

    # The pull failed. Re-fetch so the divergence check sees the true
    # upstream tip, then distinguish the recoverable diverged-history case
    # from failures a reset must NOT paper over.
    git -C "$clone_dir" fetch --quiet 2>/dev/null || true
    if ! _git_branches_diverged; then
        return 1
    fi

    local upstream ahead
    upstream=$(_git_upstream_ref)
    ahead=$(git -C "$clone_dir" rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead="?"

    err "git pull failed: your branch has diverged from ${upstream}"
    err "(${ahead} local commit(s) not on ${upstream}; a fast-forward isn't possible)."

    if (( ! allow_prompt )); then
        err "refusing to auto-reset without confirmation; aborting."
        return 1
    fi
    if [[ ! -t 0 && ! -e /dev/tty ]]; then
        err "no terminal to confirm a reset on; aborting. Re-run interactively to recover."
        return 1
    fi

    if _upgrade_confirm "Reset --hard to ${upstream}? This DISCARDS those local commit(s) and any uncommitted changes to tracked files. [y/N] " n; then
        if git -C "$clone_dir" reset --hard '@{u}'; then
            err "reset to ${upstream} complete."
            return 0
        fi
        err "git reset --hard failed; aborting."
        return 1
    fi
    err "reset declined; aborting. Resolve the divergence manually (e.g. cd into the install dir and run 'git reset --hard @{u}')."
    return 1
}

cmd_upgrade() {
    local check_only=0
    local no_prompt=0
    local no_restart=0
    local rebuild=0
    local resume_after_pull=0
    local orig_args=("$@")

    while (( $# > 0 )); do
        case "$1" in
            --check) check_only=1 ;;
            --no-prompt) no_prompt=1 ;;
            --no-restart) no_restart=1 ;;
            --rebuild) rebuild=1 ;;
            --resume-after-pull) resume_after_pull=1 ;;
            -h|--help)
                cat <<'EOF'
harness upgrade — pull latest code, apply upgrade actions, rebuild images,
                  restart services.

usage:
  harness upgrade [--check] [--no-prompt] [--no-restart] [--rebuild]

flags:
  --check         preview the upgrade actions in dry-run mode without
                  performing 'git pull' or any file modifications.
  --no-prompt     skip the interactive "apply?" prompt (CI / automation).
  --no-restart    apply upgrade actions but skip the build/down/start cycle.
  --rebuild       force a clean rebuild (compose build --no-cache). Slower
                  but bypasses any cache-poisoning from earlier failed
                  builds.

Declining the "apply?" prompt skips only the file merges — the upgrade
still rebuilds images and restarts. Use Ctrl-C to abort entirely.

If 'git pull' can't fast-forward because the clone's branch has diverged
from its upstream (e.g. the remote was rebased), upgrade offers a
'git reset --hard' to the upstream that DISCARDS local commits/changes to
tracked files — defaults to N, and is never offered under --no-prompt.

The set of upgrade actions is driven by scripts/upgrade-manifest.json. Each
action describes how a file harness manages inside the install root (which
is the same directory as the clone, post-B4) is brought forward when the
repo changes — env vars, firewall hostnames, MCP registry definitions.
User-set values are NEVER overwritten.

Image rebuild is run between manifest-apply and start so image-level
changes (Dockerfile, proxy.py, agent entrypoint) take effect on upgrade.

Internal flag (do not pass manually): --resume-after-pull. Used when
harness re-execs into the freshly-pulled script after 'git pull'
advanced HEAD; tells the new instance the pull is already done.
EOF
                return 0
                ;;
            *)
                err "harness upgrade: unknown flag '$1'"
                exit 1
                ;;
        esac
        shift
    done

    # Host-only installs (no container runtime present) can't rebuild images or
    # restart a container stack, and must NOT abort on require_docker the way the
    # container path does. Detect that here and take a host-aware path: still
    # pull code + merge config, but skip the image rebuild / container restart
    # and point the user at 'harness host'. The proxy runs from the (updated)
    # clone and its venv refreshes lazily on the next launch, so there is
    # genuinely nothing to rebuild. A --check preview is runtime-agnostic.
    local host_only=0
    if (( ! check_only )) && ! harness_runtime_installed; then
        host_only=1
        echo "harness: no container runtime found — running a host-only upgrade"
        echo "         (pull + config merge; no image rebuild or container restart)."
    elif (( ! check_only )); then
        require_docker
    fi

    if (( ! check_only )); then
        # HARNESS_UPGRADE_SKIP_PULL lets tests run the upgrade flow without
        # touching the real git remote. Production users should never set
        # this; without a pull the manifest reflects whatever is in the
        # already-cloned working tree.
        # --resume-after-pull is the in-band signal that this process is the
        # post-pull re-exec — the previous (pre-pull) harness already ran
        # 'git pull', so we must NOT run it again.
        if [[ -n "${HARNESS_UPGRADE_SKIP_PULL:-}" ]]; then
            echo "harness: skipping git pull (HARNESS_UPGRADE_SKIP_PULL set)"
        elif (( resume_after_pull )); then
            echo "harness: skipping git pull (continuing from re-exec after pull)"
        else
            local head_before head_after
            head_before=$(git -C "$clone_dir" rev-parse HEAD 2>/dev/null) || head_before=""
            echo "harness: pulling latest..."
            # On a diverged history, offer a reset --hard recovery unless
            # this is a non-interactive run (--no-prompt): a silent
            # history-discarding reset is too dangerous for automation.
            local allow_reset_prompt=1
            (( no_prompt )) && allow_reset_prompt=0
            if ! _upgrade_pull_or_reset "$allow_reset_prompt"; then
                err "aborting upgrade"
                exit 1
            fi
            head_after=$(git -C "$clone_dir" rev-parse HEAD 2>/dev/null) || head_after=""
            # If the pull advanced HEAD, re-exec into the freshly-pulled
            # harness so cmd_upgrade's own orchestration shell — flag
            # parsing, the rebuild/restart sequence, manifest-runner — runs
            # from new bytes on THIS upgrade instead of waiting for the
            # next invocation. (scripts/lib/upgrade_actions.sh and the
            # manifest are already re-sourced/re-read post-pull and so
            # don't need this; only changes to the harness script itself
            # were previously stuck behind a second `harness upgrade`.)
            #
            # Gate on `bash -n` so a syntax-broken new harness leaves the
            # already-loaded in-memory orchestrator to limp through with
            # the new manifest — strictly no worse than today's behavior.
            if [[ -n "$head_before" && -n "$head_after" && "$head_before" != "$head_after" ]]; then
                local new_harness="$clone_dir/harness"
                if [[ -f "$new_harness" ]] && bash -n "$new_harness" 2>/dev/null; then
                    echo "harness: re-executing into freshly-pulled harness (${head_before:0:7} → ${head_after:0:7})"
                    # The exec replaces this process; the EXIT trap that
                    # would reap our jq sidecar won't fire, so reap now.
                    _reap_jq_sidecar 2>/dev/null || true
                    exec "$new_harness" upgrade --resume-after-pull "${orig_args[@]}"
                else
                    err "warning: freshly-pulled harness failed syntax check; continuing with in-memory orchestrator"
                fi
            fi
        fi
    fi

    local manifest="$clone_dir/scripts/upgrade-manifest.json"
    local lib="$clone_dir/scripts/lib/upgrade_actions.sh"
    if [[ ! -f "$manifest" || ! -f "$lib" ]]; then
        err "no upgrade manifest or actions library found; falling back to legacy upgrade"
        if (( ! host_only && ! no_restart && ! check_only )); then
            cmd_down --remove-orphans 2>/dev/null || true
            cmd_start
        fi
        return 0
    fi

    # shellcheck disable=SC1090
    source "$lib"

    # --check is a full preview: list every action and dry-run them all.
    if (( check_only )); then
        echo
        echo "Upgrade actions to apply:"
        harness_jq -r '.actions[] | "  - \(.id): \(.description)"' "$manifest"
        harness_jq -r '.registry_actions[]? | "  - \(.id) [\(.condition // "always")]: \(.description)"' "$manifest"
        echo
        echo "(--check: dry-run; no changes will be made)"
        echo
        apply_upgrade_actions "$manifest" 1
        return 0
    fi

    # Precheck which actions actually have work to do. The config-file
    # prechecks (.env / .harness-allowlist) are pure bash + awk — no jq, no
    # container — so when nothing changed we skip the prompt AND the jq-backed
    # merges entirely, instead of prompting + running jq on every upgrade.
    local needed_ids=""
    local skip_actions=0
    if (( host_only )) && ! command -v jq >/dev/null 2>&1; then
        # The manifest merge runs through harness_jq, which on a jq-less host
        # falls back to a docker jq sidecar. A host-only box has no docker, so
        # without host jq the merge can't run. The pull already succeeded (code
        # is updated), so skip the config merges rather than hard-fail.
        echo
        echo "harness: 'jq' not found on the host; skipping config-file merges."
        echo "         Code is updated. Install jq and re-run 'harness upgrade'"
        echo "         to pick up any new .env variables."
        skip_actions=1
    else
        needed_ids=$(_upgrade_actions_needing_work "$manifest")

        # Declining the prompt skips only the file merges — the rest of the
        # upgrade still runs. Nothing about applying the manifest gates the
        # rest of the upgrade, and the git pull has already happened, so a
        # decline that aborts everything just leaves the user on new code with
        # stale images. Ctrl-C is the way to bail out entirely.
        if [[ -z "$needed_ids" ]]; then
            echo
            echo "Configuration files are up to date — no merges needed."
            skip_actions=1
        else
            echo
            echo "Updates available for:"
            local nid
            while IFS= read -r nid; do
                [[ -n "$nid" ]] || continue
                harness_jq -r --arg id "$nid" \
                    '(.actions[]?, .registry_actions[]?) | select(.id == $id) | "  - \(.id): \(.description)"' \
                    "$manifest"
            done <<<"$needed_ids"
            echo
            if (( ! no_prompt )); then
                if [[ -t 0 ]]; then
                    if ! _upgrade_confirm "Apply these upgrade actions? [y/n] (n skips the merges; the rest of the upgrade continues): "; then
                        skip_actions=1
                        echo "harness: skipping upgrade actions; continuing with the rest of the upgrade"
                    fi
                else
                    err "non-interactive shell; pass --no-prompt to apply without confirmation"
                    exit 1
                fi
            fi
        fi
    fi

    if (( ! skip_actions )); then
        apply_upgrade_actions "$manifest" 0 "$needed_ids"
    fi

    # Container path rebuilds images + restarts the stack so image-level changes
    # take effect. A host-only install has neither: the proxy runs from the
    # now-updated clone and its venv refreshes lazily on the next 'harness host',
    # so there is nothing to rebuild — report and point the user at the relaunch.
    if (( host_only )); then
        echo
        echo "[harness] host-only upgrade complete."
        echo "  Code is updated. proxy.py runs from the clone; the host proxy venv"
        echo "  refreshes automatically on your next 'harness host' if"
        echo "  proxy/requirements.txt changed."
        if host_proxy_running; then
            echo "  A host proxy is currently running — restart it to pick up the new"
            echo "  code:  harness host down  &&  harness host"
        else
            echo "  Run 'harness host' to use the new code."
        fi
        return 0
    fi

    if (( ! no_restart )); then
        cmd_down --remove-orphans 2>/dev/null || true

        # Rebuild images so image-level changes (Dockerfile, proxy.py, agent
        # entrypoint) take effect. Without this, the existing local images
        # are reused and the user runs stale containers without realizing.
        # --rebuild adds --no-cache for a force-rebuild; otherwise BuildKit
        # uses its layer cache and only changed layers are re-run.
        local build_args=()
        if (( rebuild )); then
            build_args+=(--no-cache)
        fi
        echo "[harness] rebuilding container images..."
        # --profile agent ensures the agent service (which is profile-gated
        # in docker-compose.yml) is included in the rebuild set; without it,
        # only default-profile services (proxy) get rebuilt and
        # image-level changes to agents/Dockerfile or agents/entrypoint.sh
        # silently slip past the upgrade.
        if ! compose --profile agent build "${build_args[@]}"; then
            err "compose build failed; aborting upgrade"
            return 1
        fi

        # Force docker compose to re-resolve every bind-mount source path
        # (notably .harness-allowlist) before `cmd_start` issues `compose up`.
        # Why: on Windows + Docker Desktop, the linefile_merge step in
        # apply_upgrade_actions writes to .harness-allowlist via a tmp-file +
        # atomic-mv. The Git-Bash-side mv lands the new inode on disk
        # immediately, but Docker Desktop's bind-mount source lookup runs
        # against its WSL2/virtiofs filesystem cache, which may still hold a
        # stale "missing" entry for that path right after the rename. When
        # the next `compose up` then mounts the source, Docker sees nothing
        # there, auto-creates an empty *directory* at the bind source, and
        # the proxy container boots but fails its firewall init
        # with "allowlist file not found at /etc/harness/allowlist". A bare
        # `compose config` triggers compose's path-resolution pass and gives
        # the daemon a chance to refresh that cache before the real `up`.
        # On Linux this is just YAML re-validation — effectively a no-op.
        compose config >/dev/null 2>&1 || true

        # The 'compose --profile agent build' above already built everything;
        # skip cmd_start's redundant --build pass.
        HARNESS_NO_BUILD=1 cmd_start
    fi
}

# Resolve the release tag that `harness downgrade` should move the clone to.
# Topological, not version-parsing (`git describe`), so any tag scheme works,
# including the two-number scheme (v0.1 / v1.0):
#   - HEAD sits exactly on a tag  -> the tag immediately before it in history
#   - HEAD is past the latest tag -> the most recent tag reachable from HEAD
# Echoes the target tag and returns 0; returns 1 with no output when there is
# no earlier release tag to land on. Reads local tags only — callers fetch
# first so newly-pushed tags are visible.
_downgrade_target_tag() {
    local exact target
    exact=$(git -C "$clone_dir" describe --tags --exact-match HEAD 2>/dev/null || true)
    if [[ -n "$exact" ]]; then
        target=$(git -C "$clone_dir" describe --tags --abbrev=0 "${exact}^" 2>/dev/null || true)
    else
        target=$(git -C "$clone_dir" describe --tags --abbrev=0 HEAD 2>/dev/null || true)
    fi
    [[ -n "$target" ]] || return 1
    printf '%s\n' "$target"
}

cmd_downgrade() {
    # Move the clone's CURRENT branch back to the previous release tag with
    # `git reset --hard`, then re-run the upgrade machinery (config merge +
    # rebuild + restart) so the running images match the older code. Staying on
    # the branch (rather than a detached tag checkout) is deliberate: a later
    # `harness update`/`upgrade` fast-forwards the user back to the tip with no
    # special detached-HEAD handling.
    local no_prompt=0 no_restart=0 rebuild=0
    while (( $# > 0 )); do
        case "$1" in
            --no-prompt) no_prompt=1 ;;
            --no-restart) no_restart=1 ;;
            --rebuild) rebuild=1 ;;
            -h|--help)
                cat <<'EOF'
harness downgrade — reset the clone to the previous release tag, then run the
                    upgrade machinery so the images match the older code.

usage:
  harness downgrade [--no-prompt] [--no-restart] [--rebuild]

Moves the clone's CURRENT branch back to the previous release tag with
'git reset --hard', staying on the branch so a later 'harness update' /
'harness upgrade' fast-forwards you back to the tip. The first downgrade from
the tip lands on the latest release tag; a second steps to the one before it.
Tags are resolved topologically (git describe), so any scheme works, including
two-number tags like v0.1 / v1.0.

After the reset it re-execs the downgraded 'harness upgrade
--resume-after-pull', so the same config merge + image rebuild + restart that
'upgrade' runs are applied from the older code (config vars removed since the
target release are merged back in).

WARNING: 'git reset --hard' DISCARDS commits and uncommitted changes to
tracked files between the target tag and HEAD. .env, .harness-allowlist and
state/ are gitignored and are NOT touched. The confirm prompt shows how many
commits will be dropped and defaults to N; --no-prompt skips it (automation).

flags:
  --no-prompt   skip the confirmation prompt (CI / automation).
  --no-restart  reset only; skip the config merge + rebuild + restart.
  --rebuild     force a clean rebuild (compose build --no-cache).
EOF
                return 0
                ;;
            *)
                err "harness downgrade: unknown flag '$1'"
                exit 1
                ;;
        esac
        shift
    done

    # The reset itself is pure git; only the rebuild/restart needs docker, so
    # fail fast on a missing daemon BEFORE the destructive reset (but allow a
    # code-only --no-restart downgrade on a host without docker).
    if (( ! no_restart )); then
        require_docker
    fi

    git -C "$clone_dir" fetch --tags --quiet 2>/dev/null || true

    local target
    if ! target=$(_downgrade_target_tag); then
        err "no earlier release tag to downgrade to."
        err "downgrade moves the clone to the previous release tag; none was found in this checkout's history."
        return 1
    fi

    local current drop
    current=$(git -C "$clone_dir" rev-parse --short HEAD 2>/dev/null) || current="?"
    drop=$(git -C "$clone_dir" rev-list --count "${target}..HEAD" 2>/dev/null) || drop="?"

    echo "harness: downgrade target is ${target} (current HEAD ${current})."
    echo "harness: this resets --hard to ${target}, discarding ${drop} commit(s) and any uncommitted changes to tracked files."
    echo "harness: .env, .harness-allowlist and state/ are gitignored and will NOT be touched."

    if (( ! no_prompt )); then
        # HARNESS_CONFIRM_FROM_STDIN=1 (test hook) reads the answer from FD 0;
        # production has no terminal-less interactive path, so without it a
        # missing TTY must refuse rather than hang on `read`.
        if [[ "${HARNESS_CONFIRM_FROM_STDIN:-0}" != "1" && ! -t 0 && ! -e /dev/tty ]]; then
            err "non-interactive shell; pass --no-prompt to downgrade without confirmation"
            exit 1
        fi
        if ! _upgrade_confirm "Reset --hard to ${target}? This DISCARDS ${drop} commit(s) and uncommitted changes to tracked files. [y/N] " n; then
            err "downgrade declined; nothing changed."
            return 1
        fi
    fi

    if ! git -C "$clone_dir" reset --hard "$target"; then
        err "git reset --hard ${target} failed; aborting downgrade."
        return 1
    fi
    echo "harness: reset to ${target} complete."

    if (( no_restart )); then
        echo "harness: --no-restart given; skipping config merge + rebuild + restart."
        echo "harness: run 'harness upgrade --resume-after-pull' to bring images in line with ${target}."
        return 0
    fi

    # Re-exec the DOWNGRADED harness's upgrade orchestration so the config
    # merge + image rebuild + restart run from the older code we just reset to,
    # not from this still-in-memory newer process. --resume-after-pull skips
    # the git pull (we moved HEAD ourselves). This mirrors cmd_upgrade's own
    # post-pull re-exec and relies on the same cross-version contract that
    # keeps --resume-after-pull a valid flag (see install-and-upgrade.md). Gate
    # on `bash -n` so a syntax-broken older harness doesn't strand us; fall
    # back to running the orchestration in-process.
    local new_harness="$clone_dir/harness"
    local upgrade_args=(upgrade --resume-after-pull)
    (( no_prompt )) && upgrade_args+=(--no-prompt)
    (( rebuild )) && upgrade_args+=(--rebuild)
    if [[ -f "$new_harness" ]] && bash -n "$new_harness" 2>/dev/null; then
        echo "harness: re-executing into ${target} harness for config merge + rebuild + restart..."
        _reap_jq_sidecar 2>/dev/null || true
        exec "$new_harness" "${upgrade_args[@]}"
    fi
    err "warning: downgraded harness failed syntax check; running upgrade orchestration from the current process instead"
    cmd_upgrade "${upgrade_args[@]}"
}

# Echo (newline-delimited) the IDs of manifest actions that actually have
# work to do. Config-file merges (envfile_merge / linefile_merge) are
# prechecked via the pure-bash upgrade_*_needs_merge helpers — no jq, no
# container — so a clean install yields empty output and the caller can skip
# the prompt + the merge entirely. Registry directory_overwrite actions have
# no cheap content precheck; an installed MCP whose target tree exists is
# always reported as needing work (the overwrite itself is idempotent).
#
# Requires scripts/lib/upgrade_actions.sh to be sourced (for the
# upgrade_*_needs_merge functions). Reading the manifest uses harness_jq, but
# this only runs from cmd_upgrade where the manifest is already being parsed,
# so no new container cost is introduced relative to the existing flow.
_upgrade_actions_needing_work() {
    local manifest="$1"
    local action_json id type src_rel target_rel src target fields cond

    while IFS= read -r action_json; do
        action_json=${action_json%$'\r'}
        fields=$(_upg_strip_cr "$(harness_jq -r '[.id,.type,.source,.target_relative]|@tsv' <<<"$action_json")")
        IFS=$'\t' read -r id type src_rel target_rel <<<"$fields"
        src="$clone_dir/$src_rel"
        target="$install_root/$target_rel"
        case "$type" in
            envfile_merge)
                upgrade_envfile_needs_merge "$src" "$target" && printf '%s\n' "$id"
                ;;
            linefile_merge)
                upgrade_linefile_needs_merge "$src" "$target" && printf '%s\n' "$id"
                ;;
        esac
    done < <(harness_jq -c '.actions[]?' "$manifest")

    while IFS= read -r action_json; do
        action_json=${action_json%$'\r'}
        fields=$(_upg_strip_cr "$(harness_jq -r '[.id,.type,.target_relative,(.condition // "always")]|@tsv' <<<"$action_json")")
        IFS=$'\t' read -r id type target_rel cond <<<"$fields"
        target="$install_root/$target_rel"
        case "$type" in
            directory_overwrite)
                if [[ "$cond" == "installed" && ! -d "$target" ]]; then
                    continue
                fi
                [[ -d "$target" ]] && printf '%s\n' "$id"
                ;;
        esac
    done < <(harness_jq -c '.registry_actions[]?' "$manifest")
}

# Iterate the manifest's actions and registry_actions, dispatch to the
# right upgrade_* function in scripts/lib/upgrade_actions.sh, accumulate
# JSON results, and print a final summary.
#
# Args: <manifest_path> <dry_run_int> [filter_ids]
# filter_ids: optional newline-delimited set of action IDs. When non-empty,
# actions whose id is not in the set are skipped (used by cmd_upgrade to run
# only the actions the precheck flagged). Empty/unset runs every action.
apply_upgrade_actions() {
    local manifest="$1"
    local dry_run="$2"
    local filter_ids="${3:-}"
    local results="[]"
    local failed=0

    # 1. Unconditional actions.
    while IFS= read -r action_json; do
        action_json=${action_json%$'\r'}
        local id type src_rel src target_rel target result rc fields acc
        # One jq call pulls all four manifest fields as a TSV row instead
        # of four separate harness_jq invocations — on a jq-less host each
        # invocation is a container round-trip.
        fields=$(_upg_strip_cr "$(harness_jq -r '[.id,.type,.source,.target_relative]|@tsv' <<<"$action_json")")
        IFS=$'\t' read -r id type src_rel target_rel <<<"$fields"
        src="$clone_dir/$src_rel"
        target="$install_root/$target_rel"

        if [[ -n "$filter_ids" ]] && ! grep -Fxq -- "$id" <<<"$filter_ids"; then
            continue
        fi

        echo "[$id] $type" >&2

        result=""
        rc=0
        case "$type" in
            envfile_merge)
                result=$(upgrade_envfile_merge "$src" "$target" "$dry_run") || rc=$?
                ;;
            linefile_merge)
                result=$(upgrade_linefile_merge "$src" "$target" "$dry_run") || rc=$?
                ;;
            *)
                err "[$id] unknown action type '$type'; skipping"
                continue
                ;;
        esac

        if (( rc != 0 )); then
            err "[$id] action returned rc=$rc; continuing"
            failed=$((failed+1))
        fi
        result=$(_upg_strip_cr "$result")
        # --argjson validates $result as JSON itself (non-zero exit on
        # malformed input), so the old separate `jq -e .` guard call is
        # redundant. Capture into a temp var and only commit it when the
        # call succeeds — a failed accumulate must never clobber the
        # running results array.
        if [[ -n "$result" ]] && \
           acc=$(harness_jq --argjson r "$result" --arg id "$id" '. + [($r + {id: $id})]' <<<"$results" 2>/dev/null); then
            results=$(_upg_strip_cr "$acc")
        fi
    done < <(harness_jq -c '.actions[]?' "$manifest")

    # 2. Registry actions (gated on `condition`).
    while IFS= read -r action_json; do
        action_json=${action_json%$'\r'}
        local id type src_rel src target_rel target cond result rc fields acc
        # One jq call for all five scalar manifest fields (see the
        # unconditional loop above). `.preserve[]` is an array, so it
        # stays a separate read below.
        fields=$(_upg_strip_cr "$(harness_jq -r '[.id,.type,.source,.target_relative,(.condition // "always")]|@tsv' <<<"$action_json")")
        IFS=$'\t' read -r id type src_rel target_rel cond <<<"$fields"
        src="$clone_dir/$src_rel"
        target="$install_root/$target_rel"

        if [[ -n "$filter_ids" ]] && ! grep -Fxq -- "$id" <<<"$filter_ids"; then
            continue
        fi

        if [[ "$cond" == "installed" && ! -d "$target" ]]; then
            echo "[$id] not installed; skipping" >&2
            continue
        fi

        local preserve_args=()
        local p
        while IFS= read -r p; do
            p=${p%$'\r'}
            [[ -n "$p" ]] && preserve_args+=("$p")
        done < <(harness_jq -r '.preserve[]?' <<<"$action_json")

        echo "[$id] $type" >&2

        result=""
        rc=0
        case "$type" in
            directory_overwrite)
                result=$(upgrade_directory_overwrite "$src" "$target" "$dry_run" "${preserve_args[@]}") || rc=$?
                ;;
            *)
                err "[$id] unknown registry action type '$type'; skipping"
                continue
                ;;
        esac

        if (( rc != 0 )); then
            err "[$id] action returned rc=$rc; continuing"
            failed=$((failed+1))
        fi
        result=$(_upg_strip_cr "$result")
        # See the unconditional loop above: --argjson validates $result on
        # its own, and a failed accumulate must not clobber $results.
        if [[ -n "$result" ]] && \
           acc=$(harness_jq --argjson r "$result" --arg id "$id" '. + [($r + {id: $id})]' <<<"$results" 2>/dev/null); then
            results=$(_upg_strip_cr "$acc")
        fi
    done < <(harness_jq -c '.registry_actions[]?' "$manifest")

    # 3. Forward-compat: warn if the manifest declares a newer schema
    # version than this runner knows how to handle. We only reach this
    # point after the loop above, so we've already applied any actions
    # that match types we recognize.
    local mver
    mver=$(_upg_strip_cr "$(harness_jq -r '.version // 1' "$manifest" 2>/dev/null || echo 1)")
    if [[ "$mver" =~ ^[0-9]+$ ]] && (( mver > 1 )); then
        err "manifest version=$mver is newer than this runner (1); applied known action types only"
    fi

    # 4. Summary.
    echo
    if (( dry_run )); then
        echo "Upgrade preview (--check, no changes applied):"
    else
        echo "Upgrade summary:"
    fi
    local n_total
    n_total=$(_upg_strip_cr "$(harness_jq 'length' <<<"$results")")
    if (( n_total == 0 )); then
        echo "  (no actions applied)"
        return 0
    fi
    # Per-action one-liner.
    harness_jq -r '
        .[] | . as $r |
        ($r.added_keys // $r.added_lines // $r.added_paths // $r.files_updated // []) as $changes |
        ($r.warnings // []) as $warns |
        "  [\($r.id)] \($r.action): \($changes | length) change(s)" +
            (if ($warns | length) > 0 then ", \($warns | length) warning(s)" else "" end)
    ' <<<"$results"

    # Surface warnings and skipped/error reasons so the user sees them.
    local warns
    warns=$(harness_jq -r '.[] | select((.warnings // []) | length > 0) | .warnings[] | "    WARN: " + .' <<<"$results")
    if [[ -n "$warns" ]]; then
        echo
        echo "$warns"
    fi
    local skipped
    skipped=$(harness_jq -r '.[] | select(.skipped == true) | "    SKIPPED [" + (.id // "?") + "]: " + (.reason // "unknown")' <<<"$results")
    if [[ -n "$skipped" ]]; then
        echo
        echo "$skipped"
    fi

    # An "action failure" here is rc=1 from an upgrade_* helper, which in
    # practice means a single merge couldn't apply (target had user
    # customization, jq merge filter returned an error, etc.) — the per-
    # action JSON line records a `skipped: true` with a `reason`, and the
    # SKIPPED summary block above prints those for the user. The upgrade
    # itself is not in a broken state. Don't print scary "N action(s) failed"
    # text and don't propagate a nonzero rc to cmd_upgrade.
    if (( failed > 0 )); then
        echo "[harness] ${failed} action(s) skipped (likely safe — file already matches or has user customization). Upgrade continues." >&2
    fi
    return 0
}

cmd_logs() {
    require_docker
    compose logs -f "$@"
}

# Single shared agent image and home directory.
#
# The agent image and persistent home are shared across modes. The
# entrypoint dispatches on a mode arg (opencode/shell) so user-installed
# skills and tools (pipx, pip --user, ~/.gitconfig, etc.) are visible across
# all modes. Build-time skel content is restored on first run by the
# entrypoint via /etc/skel/harness/.
agent_image() { printf 'harness-agent:latest'; }
agent_home_dir() { printf '%s' "$state_root/agent/home"; }

# Write the merged MCP client config to <install-root>/state/agent/home/
# .harness-mcp-servers.json so the entrypoint picks it up at startup. The
# harness emits a single canonical
# `{"mcpServers": {"<name>": {...}}}` shape — and the entrypoint translates
# to opencode's `mcp` block when needed. We rewrite this file on every agent
# launch so disabling an MCP propagates without leaving stale entries.
#
# When no MCPs are active, the file is removed so the entrypoint's "merge
# if file exists" path becomes a no-op. Without this, a previously enabled
# MCP would linger forever in the agent's config.
write_agent_mcp_config() {
    local out_file
    out_file="$(agent_home_dir)/.harness-mcp-servers.json"

    # Collect every installed-and-enabled MCP's client-config.json. Disabled
    # MCPs are skipped so toggling enabled=false hides the entry from agents
    # without an uninstall. If jq is unavailable on the host or no entries
    # remain, skip the merge entirely and clean up any stale side file.
    local entries=()
    if [[ -d "$mcp_active_dir" ]]; then
        local mcp_dir name
        for mcp_dir in "$mcp_active_dir"/*/; do
            [[ -f "$mcp_dir/client-config.json" ]] || continue
            name=$(basename "$mcp_dir")
            mcp_is_enabled "$name" || continue
            entries+=("$mcp_dir/client-config.json")
        done
    fi

    if (( ${#entries[@]} == 0 )); then
        rm -f "$out_file" 2>/dev/null || true
        return 0
    fi

    # Reduce each {"mcpServers": {...}} into a single combined object.
    # Later entries win on key collision (predictable, alphabetic order).
    # Slurp the entries via stdin (cat | harness_jq -s) rather than as
    # positional file args: harness_jq's container fallback can only map a
    # single trailing file arg into the container, so multi-file args would
    # break on a jq-less host. Concatenating to stdin works for both the
    # host-jq and container-jq paths, so the merge runs on a docker-only host.
    mkdir -p "$(dirname "$out_file")"
    if ! cat "${entries[@]}" | harness_jq -s 'reduce .[] as $i ({"mcpServers": {}}; .mcpServers += ($i.mcpServers // {}))' \
        >"$out_file" 2>/dev/null
    then
        # Bad json in one of the entries — don't let it stop the agent.
        rm -f "$out_file" 2>/dev/null || true
        err "warning: failed to merge MCP client configs; agent will start without MCP"
    fi
}

# True if at least one installed-and-enabled MCP is a host MCP (runs as a
# process on the host, reached at http://host.docker.internal:<port>/mcp).
# Used to gate the host.docker.internal reachability wiring below so we never
# widen the agent's egress to the host when no host MCP is in play.
any_host_mcp_enabled() {
    [[ -d "$mcp_active_dir" ]] || return 1
    local mcp_dir name
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -f "$mcp_dir/client-config.json" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_host "$name" || continue
        mcp_is_enabled "$name" || continue
        return 0
    done
    return 1
}

# Emit (NUL-delimited) the extra `docker run` args that make an enabled host
# MCP reachable from the agent container. A host MCP runs on the host, so two
# things are needed and NEITHER is automatic on Linux:
#   1. --add-host=host.docker.internal:host-gateway so the name resolves to the
#      host. Docker Desktop (Windows/macOS) injects this name already; a plain
#      Linux docker engine does not, so the agent can't even resolve it.
#   2. A signal to the in-container firewall to allow that host. The firewall
#      resolves allowlist hosts with `dig`, which queries DNS and ignores
#      /etc/hosts — so host.docker.internal can't ride the normal allowlist.
#      We pass it via HARNESS_HOST_MCP_HOSTS and init-firewall.sh resolves it
#      from /etc/hosts and opens just that IP.
# Honors the owner's intent that an enabled MCP be reachable by default with no
# manual `harness net allow` / --add-host. Narrow on purpose: host loopback to
# the user's own machine, only while a host MCP is enabled — it does not relax
# the "operator opens third-party egress deliberately" rule for other domains.
emit_host_mcp_docker_args() {
    any_host_mcp_enabled || return 0
    printf '%s\0' "--add-host=host.docker.internal:host-gateway"
    printf '%s\0' "-e"
    printf '%s\0' "HARNESS_HOST_MCP_HOSTS=host.docker.internal"
}

# --- host MCP process supervision -------------------------------------------
#
# A host MCP runs as a plain process on the host (no container), launched by its
# run.sh — which ends in `exec python server.py`, so the PID we background and
# record stays valid as the server process itself. harness supervises it with a
# pidfile + logfile under the MCP's registration dir, mirroring the jq-sidecar
# pidfile model: start is idempotent, the last agent's teardown stops it, and
# `harness mcp up/down/logs/status` drive it directly. run.sh stays runnable
# standalone for the host operator — this is supervision layered on top.

host_mcp_src_dir() { printf '%s/host-mcp/%s' "$install_root" "$1"; }
host_mcp_pidfile() { printf '%s/%s/server.pid' "$mcp_active_dir" "$1"; }
host_mcp_logfile() { printf '%s/%s/server.log' "$mcp_active_dir" "$1"; }

# Echo the live PID for a host MCP, or nothing. Cleans a stale pidfile whose
# process is gone so callers see an accurate state. Always returns 0.
host_mcp_pid() {
    local pf pid
    pf=$(host_mcp_pidfile "$1")
    [[ -f "$pf" ]] || return 0
    pid=$(tr -d ' \t\r\n' <"$pf" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        printf '%s' "$pid"
        return 0
    fi
    rm -f "$pf" 2>/dev/null || true
    return 0
}

host_mcp_running() { [[ -n "$(host_mcp_pid "$1")" ]]; }

# Echo the host MCP's port from its meta, or nothing.
host_mcp_port() {
    local meta
    meta=$(mcp_meta_file "$1")
    [[ -f "$meta" ]] || return 0
    harness_jq -r '.host_port // empty' "$meta" 2>/dev/null || true
}

# True if something is already listening on the host MCP's port — e.g. the
# operator started it by hand with ./run.sh, or a stale instance is still up.
# Used to keep harness from double-spawning a server it doesn't own. localhost
# connect is instant for refused/accepted, so no timeout is needed (same
# /dev/tcp probe the host_mcp_e2e test uses).
host_mcp_port_open() {
    local port
    port=$(host_mcp_port "$1")
    [[ -n "$port" ]] || return 1
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || return 1
    exec 3>&- 3<&- 2>/dev/null || true
    return 0
}

# Start a host MCP's server in the background (idempotent). Records the PID and
# pipes stdout+stderr to the logfile. run.sh cd's into its own dir, so launching
# it by absolute path is fine. First-run venv/pip work happens in the background;
# the agent may launch before the server is listening — opencode connects when
# it comes up, same as the manual-run.sh flow.
host_mcp_start() {
    local name="$1" src pf lf
    src=$(host_mcp_src_dir "$name")
    if [[ ! -f "$src/run.sh" ]]; then
        err "host MCP $name has no run.sh at $src"
        return 1
    fi
    host_mcp_running "$name" && return 0
    # Don't fight a server already on the port (e.g. a manual ./run.sh). harness
    # just won't have a pidfile for it; it can still reach it over the port.
    host_mcp_port_open "$name" && return 0
    pf=$(host_mcp_pidfile "$name")
    lf=$(host_mcp_logfile "$name")
    mkdir -p "$(dirname "$pf")"
    nohup bash "$src/run.sh" >"$lf" 2>&1 &
    printf '%s\n' "$!" >"$pf"
}

# Stop a host MCP's supervised server: TERM, brief wait, then KILL. On Windows
# Git Bash also taskkill the tree (the exec'd/forked python may be a native
# process MSYS `kill` can't reach). Removes the pidfile. Always returns 0.
host_mcp_stop() {
    local name="$1" pid pf i
    pid=$(host_mcp_pid "$name")
    pf=$(host_mcp_pidfile "$name")
    if [[ -z "$pid" ]]; then
        rm -f "$pf" 2>/dev/null || true
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    for i in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
    if harness_is_git_bash && command -v taskkill >/dev/null 2>&1; then
        # //T kills the child tree, //F forces it. Double-slash so MSYS doesn't
        # rewrite the flags into paths.
        taskkill //PID "$pid" //T //F >/dev/null 2>&1 || true
    fi
    rm -f "$pf" 2>/dev/null || true
}

# Start every enabled host MCP (idempotent). Folded into the start/launch paths
# so a plain `harness` brings host MCPs up alongside the container stack.
host_mcp_start_enabled() {
    [[ -d "$mcp_active_dir" ]] || return 0
    local mcp_dir name
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -d "$mcp_dir" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_host "$name" || continue
        mcp_is_enabled "$name" || continue
        # Skip if harness already supervises it, or if the port is already
        # served (a manual ./run.sh) — host_mcp_start re-checks, but skipping
        # here avoids the needless "starting" log line.
        host_mcp_running "$name" && continue
        host_mcp_port_open "$name" && continue
        echo "[harness] starting host MCP: $name" >&2
        host_mcp_start "$name" || err "failed to start host MCP $name (see $(host_mcp_logfile "$name"))"
    done
}

# Stop every supervised host MCP (enabled or not). Folded into `harness down`
# so last-agent teardown brings host MCPs down with the rest of the stack.
host_mcp_stop_all() {
    [[ -d "$mcp_active_dir" ]] || return 0
    local mcp_dir name
    for mcp_dir in "$mcp_active_dir"/*/; do
        [[ -d "$mcp_dir" ]] || continue
        name=$(basename "$mcp_dir")
        mcp_is_host "$name" || continue
        host_mcp_running "$name" || continue
        echo "[harness] stopping host MCP: $name" >&2
        host_mcp_stop "$name"
    done
}

# --- host mode (containerless) ----------------------------------------------
#
# `harness host` runs the whole stack as plain host processes — no docker, no
# containers. The translating proxy runs from a lazily-built venv under
# state/host/; opencode runs directly off the host PATH against it. This is the
# light-footprint mode: it drops the docker daemon and the multi-GB images, at
# the cost of the egress firewall — which is container-bound (it lays a
# host-global iptables default-deny that cannot be scoped to one process) and so
# is simply ABSENT here. Because there is no firewall and the agent runs as the
# full host user, every launch is gated behind an explicit confirmation
# (host_confirm_gate), worded harder than --net. v1 is deliberately minimal:
# single CWD, no host-MCP wiring. Runs on Linux, macOS, and Windows (Git Bash /
# MSYS); on Windows the toolchain provisioner fetches the windows jq.exe, the
# Node .zip, and the npm opencode shim, but opencode's own Git Bash support is
# rough (see docs/WINDOWS.md "Host mode on Windows").
# See architecture/harness-cli.md (Host mode).

host_state_dir()       { printf '%s/host' "$state_root"; }
host_venv_dir()        { printf '%s/host/venv' "$state_root"; }
host_proxy_pidfile()   { printf '%s/host/proxy.pid' "$state_root"; }
host_proxy_fpfile()    { printf '%s/host/proxy.fp' "$state_root"; }
host_proxy_logfile()   { printf '%s/host/proxy.log' "$state_root"; }
host_opencode_config() { printf '%s/host/opencode.json' "$state_root"; }
host_proxy_port()      { printf '%s' "${PROXY_PORT:-8000}"; }

# --- host toolchain auto-provisioning --------------------------------------
#
# Goal: a user runs `harness install` then `harness host` with nothing else
# installed but python3. python3 is irreducible (it bootstraps the proxy venv);
# the other three host-mode deps — jq, Node, opencode — are fetched on first
# `harness host` into state/host/toolchain and put on PATH for the launch.
#
# Pins mirror the container (agents/Dockerfile) so the host runs the same
# opencode + provider the container suite is validated against; a unit test
# asserts the opencode/provider pins stay in sync with the Dockerfile ARGs.
# This makes host mode self-installing, NOT offline or fully reproducible:
# opencode still fetches its provider over the (unfirewalled) network on first
# use, exactly as the container does on its first run.
#
# jq and Node prefer a satisfactory host binary when present (jq any version;
# Node major >= 20). opencode is preferred from the host ONLY when its version
# equals the pin — host_run_opencode's `opencode export` / `session list
# --format json` handling is version-fragile (see agents/Dockerfile), so an
# arbitrary system opencode can silently break print mode.
HARNESS_HOST_JQ_VERSION="${HARNESS_HOST_JQ_VERSION:-1.7.1}"
HARNESS_HOST_NODE_VERSION="${HARNESS_HOST_NODE_VERSION:-20.20.2}"
HARNESS_HOST_OPENCODE_VERSION="${HARNESS_HOST_OPENCODE_VERSION:-1.15.7}"
HARNESS_HOST_OPENAI_COMPAT_VERSION="${HARNESS_HOST_OPENAI_COMPAT_VERSION:-2.0.47}"

host_tool_dir()     { printf '%s/host/toolchain' "$state_root"; }
host_tool_bin_dir() { printf '%s/host/toolchain/bin' "$state_root"; }   # holds vendored jq; prepended to PATH
host_node_dir()     { printf '%s/host/toolchain/node' "$state_root"; }  # extracted Node tarball lives under here
host_opencode_dir() { printf '%s/host/toolchain/opencode' "$state_root"; } # npm --prefix target for opencode

# A fingerprint of the config the running proxy captured when it started: the
# bind port plus the required upstream vars and the opt-in OUTPUT_DIR. Stored
# beside the pidfile; host_proxy_start compares it against the current .env so
# an edited config (new port / url / key / model) restarts the proxy instead of
# silently reusing a stale one — and a port change can't strand the readiness
# probe on a port nothing is listening on (CONCERNS M2).
host_proxy_fingerprint() {
    local data
    data=$(printf 'port=%s\nurl=%s\nkey=%s\nmodel=%s\noutput=%s\n' \
        "$(host_proxy_port)" "${PROXY_API_URL:-}" "${PROXY_API_KEY:-}" \
        "${DEFAULT_MODEL_NAME:-}" "${OUTPUT_DIR:-}")
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$data" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$data" | cksum | tr -d ' '
    fi
}

# Echo the live PID for the host proxy, or nothing. Cleans a stale pidfile whose
# process is gone. Mirrors host_mcp_pid. Always returns 0.
host_proxy_pid() {
    local pf pid
    pf=$(host_proxy_pidfile)
    [[ -f "$pf" ]] || return 0
    pid=$(tr -d ' \t\r\n' <"$pf" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        printf '%s' "$pid"
        return 0
    fi
    rm -f "$pf" 2>/dev/null || true
    return 0
}

host_proxy_running() { [[ -n "$(host_proxy_pid)" ]]; }

# --- toolchain fetch primitives --------------------------------------------

# Verify $1's sha256 equals hex $2. Uses sha256sum (Linux) or shasum (macOS).
host_sha256_check() {
    local f="$1" want="$2" got=""
    if command -v sha256sum >/dev/null 2>&1; then
        got=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)
    elif command -v shasum >/dev/null 2>&1; then
        got=$(shasum -a 256 "$f" 2>/dev/null | cut -d' ' -f1)
    else
        err "host mode: no sha256 tool (sha256sum/shasum) available to verify downloads"
        return 1
    fi
    [[ -n "$got" && "$got" == "$want" ]]
}

# Download $1 -> $2, verifying sha256 $3 when given. Atomic: a partial or
# checksum-mismatched download never lands at the destination path.
host_fetch() {
    local url="$1" dest="$2" want="${3:-}" tmp
    command -v curl >/dev/null 2>&1 || { err "host mode: curl required to download dependencies"; return 1; }
    tmp="${dest}.part.$$"
    if ! curl -fsSL --max-time 300 -o "$tmp" "$url"; then
        err "host mode: download failed: $url"; rm -f "$tmp"; return 1
    fi
    if [[ -n "$want" ]] && ! host_sha256_check "$tmp" "$want"; then
        err "host mode: checksum mismatch for $url (refusing to install)"; rm -f "$tmp"; return 1
    fi
    mv -f "$tmp" "$dest"
}

# Extract archive $1 into dir $2. $3 is the kind: `tar.gz` (Linux/macOS Node
# tarball) or `zip` (the Windows Node distribution). zip prefers `unzip`, then
# falls back to `tar -xf` — Git for Windows ships bsdtar as `tar`, which reads
# zip natively, so no extra tool is needed on a stock Git Bash.
host_extract_archive() {
    local file="$1" dest="$2" kind="$3"
    case "$kind" in
        zip)
            if command -v unzip >/dev/null 2>&1; then
                unzip -q -o "$file" -d "$dest"
            elif command -v tar >/dev/null 2>&1; then
                tar -xf "$file" -C "$dest"
            else
                err "host mode: need 'unzip' or 'tar' to unpack $file"; return 1
            fi
            ;;
        tar.gz|tgz)
            command -v tar >/dev/null 2>&1 || { err "host mode: 'tar' required to unpack $file"; return 1; }
            tar -xzf "$file" -C "$dest"
            ;;
        *) err "host mode: unknown archive kind '$kind'"; return 1 ;;
    esac
}

# Fetch a `<sha256>  <filename>` manifest at $1 and echo the hash for entry $2.
# Used for jq's sha256sum.txt and Node's SHASUMS256.txt (same format).
host_sha_from_manifest() {
    local url="$1" name="$2" line
    command -v curl >/dev/null 2>&1 || return 1
    line=$(curl -fsSL --max-time 60 "$url" 2>/dev/null | grep -E "[[:space:]]\*?${name}\$" | head -1 || true)
    [[ -n "$line" ]] || return 1
    printf '%s' "${line%%[[:space:]]*}"
}

# Map uname -m to the arch token each upstream uses. "unsupported" otherwise.
host_jq_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo amd64 ;;
        aarch64|arm64) echo arm64 ;;
        *) echo unsupported ;;
    esac
}
host_node_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo x64 ;;
        aarch64|arm64) echo arm64 ;;
        *) echo unsupported ;;
    esac
}
# Echo the os-arch platform token, or fail (return 1) on an unsupported combo.
host_jq_platform() {
    local os arch; os=$(harness_detect_os); arch=$(host_jq_arch)
    [[ "$arch" == unsupported ]] && return 1
    case "$os" in
        linux) printf 'linux-%s' "$arch" ;;
        macos) printf 'macos-%s' "$arch" ;;
        # jq 1.7.1 ships only windows-amd64 / windows-i386 — no arm64 build.
        windows) [[ "$arch" == amd64 ]] && printf 'windows-amd64' || return 1 ;;
        *) return 1 ;;
    esac
}
host_node_platform() {
    local os arch; os=$(harness_detect_os); arch=$(host_node_arch)
    [[ "$arch" == unsupported ]] && return 1
    case "$os" in
        linux) printf 'linux-%s' "$arch" ;;
        macos) printf 'darwin-%s' "$arch" ;;
        windows) printf 'win-%s' "$arch" ;;   # win-x64 / win-arm64
        *) return 1 ;;
    esac
}

# --- per-OS executable layout helpers ---------------------------------------
# Everything routes through harness_detect_os so a single stub flips the whole
# platform in tests. On Windows the user runs harness under Git Bash (MSYS):
# binaries carry a .exe suffix, the Node zip lays node.exe at its ROOT (no bin/
# subdir), npm puts global shims in the prefix root rather than bin/, and a venv
# is Scripts/python.exe rather than bin/python.

# Executable suffix for native binaries we download (jq, node): ".exe" on
# Windows, empty elsewhere. (opencode's npm shim is an extensionless sh wrapper,
# so it does NOT take this suffix.)
host_exe_suffix() { [[ "$(harness_detect_os)" == windows ]] && printf '.exe' || printf ''; }

# Full path to the vendored jq binary (…/bin/jq or …/bin/jq.exe).
host_jq_vendored() { printf '%s/jq%s' "$(host_tool_bin_dir)" "$(host_exe_suffix)"; }

# Given an extracted Node root, the dir that holds node/npm on this OS (…/bin on
# unix, the root itself on Windows) and the node binary's full path.
host_node_exe_dir() {
    local root="$1"
    [[ "$(harness_detect_os)" == windows ]] && printf '%s' "$root" || printf '%s/bin' "$root"
}
host_node_exe() { printf '%s/node%s' "$(host_node_exe_dir "$1")" "$(host_exe_suffix)"; }

# opencode install layout: npm links the global shim into <prefix>/bin on unix,
# into the <prefix> root on Windows (npm's documented per-OS global-folders
# rule). The shim is `opencode` (sh wrapper) on both — no .exe suffix.
host_opencode_exe_dir() {
    [[ "$(harness_detect_os)" == windows ]] && printf '%s' "$(host_opencode_dir)" || printf '%s/bin' "$(host_opencode_dir)"
}
host_opencode_exe() { printf '%s/opencode' "$(host_opencode_exe_dir)"; }

# Resolve a Python 3 interpreter command. python3 on Linux/macOS; on Windows
# (Git Bash) the python.org build ships `python`/`py` rather than `python3`, so
# fall back. Echoes an invocable command word (may be the two-token `py -3`).
#
# Every candidate is VERIFIED by actually running `--version` and confirming it
# reports Python 3 — `command -v` alone is not enough on Windows, where an
# "App execution alias" stub named python3.exe (and python.exe) sits on PATH by
# default and, when Python is installed under a different name, prints "Python
# was not found..." instead of running. Trusting `command -v python3` there
# picks the stub, and the later `python3 -m venv` fails as if Python were
# missing even though a real `python` is right there. Probing `--version`
# rejects the stub and falls through to the interpreter that actually works.
host_python_bin() {
    local c
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" --version 2>&1 | grep -q '^Python 3'; then
            printf '%s' "$c"; return 0
        fi
    done
    if command -v py >/dev/null 2>&1 && py -3 --version 2>&1 | grep -q '^Python 3'; then
        printf 'py -3'; return 0
    fi
    return 1
}

# Path to the venv's python interpreter for this OS.
host_venv_python() {
    if [[ "$(harness_detect_os)" == windows ]]; then
        printf '%s/Scripts/python.exe' "$(host_venv_dir)"
    else
        printf '%s/bin/python' "$(host_venv_dir)"
    fi
}

# --- per-tool provisioners (idempotent; stamp gated on a --version smoke run) ---

# Vendor jq into toolchain/bin/jq unless a host jq is already present.
host_ensure_jq() {
    command -v jq >/dev/null 2>&1 && return 0
    local ver plat asset bin stamp base sha
    ver="$HARNESS_HOST_JQ_VERSION"
    plat=$(host_jq_platform) || { err "host mode: cannot vendor jq for $(harness_detect_os)/$(uname -m)"; return 1; }
    asset="jq-${plat}$(host_exe_suffix)"   # jq-linux-amd64 | jq-windows-amd64.exe
    bin="$(host_jq_vendored)"
    stamp="$(host_tool_dir)/.stamp-jq"
    if [[ -x "$bin" && -f "$stamp" && "$(cat "$stamp" 2>/dev/null)" == "$ver-$plat" ]] \
       && "$bin" --version >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$(host_tool_bin_dir)"
    base="https://github.com/jqlang/jq/releases/download/jq-${ver}"
    sha=$(host_sha_from_manifest "$base/sha256sum.txt" "$asset") \
        || { err "host mode: could not resolve jq checksum from $base/sha256sum.txt"; return 1; }
    echo "[harness] host mode: fetching jq ${ver} (${plat}, ~1 MB)..." >&2
    host_fetch "$base/$asset" "$bin" "$sha" || return 1
    chmod +x "$bin" 2>/dev/null || true
    if ! "$bin" --version >/dev/null 2>&1; then
        err "host mode: vendored jq failed to run ($bin)"; rm -f "$bin"; return 1
    fi
    printf '%s\n' "$ver-$plat" >"$stamp" 2>/dev/null || true
}

# Vendor Node into toolchain/node/node-v<ver>-<plat>/ unless a host Node >= 20
# is already present. Node is the install-time runtime for opencode's npm
# install (and its launcher); the pin tracks the container's `FROM node:NN`.
host_ensure_node() {
    if command -v node >/dev/null 2>&1; then
        local maj; maj=$(node --version 2>/dev/null | sed -E 's/^v?([0-9]+).*/\1/')
        [[ -n "$maj" ]] && (( maj >= 20 )) && return 0
    fi
    local ver plat root stamp base ext archive sha tmp nodeexe
    ver="$HARNESS_HOST_NODE_VERSION"
    plat=$(host_node_platform) || { err "host mode: cannot vendor Node for $(harness_detect_os)/$(uname -m)"; return 1; }
    root="$(host_node_dir)/node-v${ver}-${plat}"
    stamp="$(host_tool_dir)/.stamp-node"
    nodeexe="$(host_node_exe "$root")"   # …/bin/node on unix, …/node.exe on Windows
    if [[ -x "$nodeexe" && -f "$stamp" && "$(cat "$stamp" 2>/dev/null)" == "$ver-$plat" ]] \
       && "$nodeexe" --version >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$(host_node_dir)"
    rm -rf "$root"   # clear any partial/older tree so a crashed prior run can't be trusted
    base="https://nodejs.org/dist/v${ver}"
    # Windows ships a .zip (node.exe + npm at the root); Linux/macOS a .tar.gz.
    if [[ "$(harness_detect_os)" == windows ]]; then ext="zip"; else ext="tar.gz"; fi
    archive="node-v${ver}-${plat}.${ext}"
    sha=$(host_sha_from_manifest "$base/SHASUMS256.txt" "$archive") \
        || { err "host mode: could not resolve Node checksum from $base/SHASUMS256.txt"; return 1; }
    tmp="$(host_node_dir)/$archive"
    echo "[harness] host mode: fetching Node ${ver} (${plat}, ~30 MB download / ~150 MB unpacked)..." >&2
    host_fetch "$base/$archive" "$tmp" "$sha" || return 1
    echo "[harness] host mode: unpacking Node..." >&2
    if ! host_extract_archive "$tmp" "$(host_node_dir)" "$ext"; then
        err "host mode: Node archive failed to extract"; rm -f "$tmp"; rm -rf "$root"; return 1
    fi
    rm -f "$tmp"
    if [[ ! -x "$nodeexe" ]] || ! "$nodeexe" --version >/dev/null 2>&1; then
        err "host mode: Node did not unpack to $nodeexe"; rm -rf "$root"; return 1
    fi
    printf '%s\n' "$ver-$plat" >"$stamp" 2>/dev/null || true
}

# Install opencode (+ the openai-compatible provider, mirroring the container)
# into toolchain/opencode via npm, unless a host opencode of the pinned version
# is already present. Requires npm on PATH — host_ensure_toolchain prepends the
# vendored Node before calling this.
host_ensure_opencode() {
    local ver compat prefix stamp bin sv
    ver="$HARNESS_HOST_OPENCODE_VERSION"
    compat="$HARNESS_HOST_OPENAI_COMPAT_VERSION"
    if command -v opencode >/dev/null 2>&1; then
        sv=$(opencode --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
        [[ "$sv" == "$ver" ]] && return 0
    fi
    prefix="$(host_opencode_dir)"
    stamp="$(host_tool_dir)/.stamp-opencode"
    bin="$(host_opencode_exe)"   # …/bin/opencode on unix, …/opencode shim at prefix root on Windows
    if [[ -x "$bin" && -f "$stamp" && "$(cat "$stamp" 2>/dev/null)" == "$ver-$compat" ]] \
       && "$bin" --version >/dev/null 2>&1; then
        return 0
    fi
    command -v npm >/dev/null 2>&1 || { err "host mode: npm unavailable to install opencode (Node provisioning failed?)"; return 1; }
    mkdir -p "$prefix"
    echo "[harness] host mode: installing opencode ${ver} + provider via npm (one-time, a few hundred MB)..." >&2
    if ! npm install -g --prefix "$prefix" "opencode-ai@${ver}" "@ai-sdk/openai-compatible@${compat}" >&2; then
        err "host mode: npm install of opencode failed (see output above)"; return 1
    fi
    if [[ ! -x "$bin" ]] || ! "$bin" --version >/dev/null 2>&1; then
        err "host mode: opencode did not install to $bin"; return 1
    fi
    printf '%s\n' "$ver-$compat" >"$stamp" 2>/dev/null || true
}

# Echo the colon-joined PATH prefix for whatever tools we vendored (existing
# binaries only). Referenced by exact version-named dirs — never a glob — so a
# leftover older Node tree can't sneak onto PATH after a version bump.
host_toolchain_path_prefix() {
    local dirs=() np node_root
    [[ -x "$(host_jq_vendored)" ]] && dirs+=("$(host_tool_bin_dir)")
    if np=$(host_node_platform 2>/dev/null); then
        node_root="$(host_node_dir)/node-v${HARNESS_HOST_NODE_VERSION}-${np}"
        [[ -x "$(host_node_exe "$node_root")" ]] && dirs+=("$(host_node_exe_dir "$node_root")")
    fi
    [[ -x "$(host_opencode_exe)" ]] && dirs+=("$(host_opencode_exe_dir)")
    local IFS=:
    printf '%s' "${dirs[*]}"
}

# Provision every host-mode dependency (jq, Node, opencode) and prepend the
# vendored dirs to PATH for the rest of this invocation. Each provisioner is a
# no-op (silent) once its tool is satisfied, so re-runs only re-wire PATH.
# Linux, macOS, and Windows (Git Bash / MSYS).
host_ensure_toolchain() {
    local os; os=$(harness_detect_os)
    if [[ "$os" != linux && "$os" != macos && "$os" != windows ]]; then
        err "host mode: automatic dependency provisioning supports Linux, macOS, and Windows (Git Bash); got $os"
        return 1
    fi
    host_ensure_jq   || return 1
    host_ensure_node || return 1
    # opencode's npm install needs node/npm visible; prepend what we have so far.
    local tp
    tp=$(host_toolchain_path_prefix); [[ -n "$tp" ]] && export PATH="$tp:$PATH"
    host_ensure_opencode || return 1
    tp=$(host_toolchain_path_prefix); [[ -n "$tp" ]] && export PATH="$tp:$PATH"
    return 0
}

# python3 is the one host-mode dependency harness does NOT auto-provision: it
# bootstraps the proxy venv, so it must already exist to fetch anything. Checked
# early (before the confirm gate) so a python3-less host fails fast without
# prompting or downloading.
host_require_python3() {
    if ! host_python_bin >/dev/null 2>&1; then
        err "host mode needs Python 3 (runs the translating proxy and bootstraps its venv); none found in PATH"
        err "  install Python 3 (python3 / python / py) from your OS package manager, then re-run."
        err "  on Windows (Git Bash) the python.org installer provides 'python' and 'py'."
        return 1
    fi
}

# Verify host mode's deps are satisfied. Python 3 is the user's responsibility;
# jq / Node / opencode are auto-provisioned by host_ensure_toolchain and on PATH
# by the time this runs, so this is a post-provision assertion (each must both
# resolve AND execute). Names every missing dep. Returns non-zero if any fail.
host_preflight() {
    local missing_dep=0

    # host_python_bin resolves python3 / a Python-3 'python' / 'py -3', so a
    # Windows Git Bash box without a literal 'python3' still passes.
    if ! host_python_bin >/dev/null 2>&1; then
        err "host mode needs Python 3 (python3/python/py; runs the translating proxy); not found in PATH"
        missing_dep=1
    fi

    if ! command -v jq >/dev/null 2>&1 || ! jq --version >/dev/null 2>&1; then
        err "host mode: jq unavailable after provisioning (looked in state/host/toolchain and PATH)"
        missing_dep=1
    fi

    if ! command -v node >/dev/null 2>&1 || ! node --version >/dev/null 2>&1; then
        err "host mode: node unavailable after provisioning (looked in state/host/toolchain and PATH)"
        missing_dep=1
    fi

    if ! command -v opencode >/dev/null 2>&1 || ! opencode --version >/dev/null 2>&1; then
        err "host mode: opencode unavailable after provisioning (looked in state/host/toolchain and PATH)"
        missing_dep=1
    fi

    (( missing_dep == 0 ))
}

# Lighter sibling of require_runtime_config: host mode reads the same three
# REQUIRED proxy vars but has no firewall allowlist to validate (the allowlist
# only governs container mode). .env is already sourced into this shell.
host_require_config() {
    if [[ ! -f "$env_file" ]]; then
        err "missing $env_file"
        err "  cp $clone_dir/.env.example $env_file"
        err "  then set PROXY_API_URL / PROXY_API_KEY / DEFAULT_MODEL_NAME"
        exit 1
    fi
    local missing=() v
    for v in PROXY_API_URL PROXY_API_KEY DEFAULT_MODEL_NAME; do
        [[ -z "${!v:-}" ]] && missing+=("$v")
    done
    if (( ${#missing[@]} > 0 )); then
        err "required value(s) empty in $env_file: ${missing[*]}"
        err "edit $env_file and set them, then re-run."
        exit 1
    fi
}

# Mandatory pre-launch gate for host mode. Host mode runs opencode as the full
# host user with no egress firewall — a strictly bigger blast radius than --net
# — so this fires on EVERY launch (unlike --net's per-invocation flag). Worded
# harder than warn_if_firewall_open accordingly. HARNESS_HOST_CONFIRM=1 bypasses
# it (automation); refuses non-interactive without /dev/tty.
host_confirm_gate() {
    local yolo="${1:-0}"
    echo >&2
    echo "WARNING: HOST MODE RUNS WITH NO CONTAINER ISOLATION" >&2
    echo >&2
    echo "  ! opencode runs as your full host user ($(id -un)) — it can read and" >&2
    echo "    write every file your account can, including ~/.ssh, ~/.aws, ~/.config." >&2
    echo "  ! There is NO egress firewall. Outbound network is UNRESTRICTED (the" >&2
    echo "    harness allowlist only applies to container mode)." >&2
    if [[ "$yolo" == "1" ]]; then
        echo "  ! --yolo auto-approves every edit and shell command with no prompt." >&2
    fi
    echo >&2
    echo "  This is a bigger blast radius than 'harness --net'. Only continue on a" >&2
    echo "  machine and in a directory where you accept that." >&2
    echo >&2

    if [[ "${HARNESS_HOST_CONFIRM:-0}" == "1" ]]; then
        echo "  (auto-confirmed via HARNESS_HOST_CONFIRM=1)" >&2
        return 0
    fi
    if [[ ! -e /dev/tty ]]; then
        err "non-interactive shell without /dev/tty; refusing to launch host mode"
        err "set HARNESS_HOST_CONFIRM=1 to skip this prompt in automation"
        return 1
    fi
    local ans
    printf 'Continue launching host-mode opencode? [y/n]: ' >&2
    if ! IFS= read -r ans </dev/tty; then
        err "no input received; aborting"
        return 1
    fi
    case "${ans:-}" in
        y|Y|yes|YES) return 0 ;;
        *) err "aborted by user"; return 1 ;;
    esac
}

# Build (once) the lazy venv that runs the proxy and install its two pure-python
# deps (flask, requests) from proxy/requirements.txt. A stamp keyed on the
# requirements file's hash means pip only re-runs when that file changes.
host_proxy_ensure_venv() {
    local venv reqs stamp want vpy py
    venv=$(host_venv_dir)
    reqs="$clone_dir/proxy/requirements.txt"
    stamp="$venv/.harness-reqs-sha"
    vpy="$(host_venv_python)"   # …/bin/python on unix, …/Scripts/python.exe on Windows
    want=""
    if command -v sha256sum >/dev/null 2>&1; then
        want=$(sha256sum "$reqs" 2>/dev/null | cut -d' ' -f1)
    fi
    if [[ -x "$vpy" && -n "$want" && -f "$stamp" \
          && "$(cat "$stamp" 2>/dev/null)" == "$want" ]]; then
        return 0
    fi
    if [[ ! -x "$vpy" ]]; then
        py=$(host_python_bin) || { err "host mode: no Python 3 interpreter found to create the proxy venv"; return 1; }
        echo "[harness] host mode: creating proxy venv (one-time)..." >&2
        # $py may be the two-token `py -3` on Windows; intentional word-split.
        # shellcheck disable=SC2086
        if ! $py -m venv "$venv"; then
            err "failed to create venv at $venv (is the python3 venv module installed?)"
            return 1
        fi
    fi
    echo "[harness] host mode: installing proxy deps (flask, requests)..." >&2
    if ! "$vpy" -m pip install --quiet --disable-pip-version-check -r "$reqs"; then
        err "pip install of proxy deps failed (see output above)"
        return 1
    fi
    [[ -n "$want" ]] && printf '%s\n' "$want" >"$stamp" 2>/dev/null || true
    return 0
}

# Start the host proxy in the background (idempotent). Binds 127.0.0.1 only —
# the host proxy must never be reachable off-box. The proxy reads its REQUIRED
# env (PROXY_API_URL/KEY, DEFAULT_MODEL_NAME, etc.) straight from this shell,
# which sourced .env with `set -a`, so only the host-specific overrides are set
# here. Records the PID; pipes stdout+stderr to the logfile.
host_proxy_start() {
    local venv port pf fpf lf cur_fp
    fpf=$(host_proxy_fpfile)
    cur_fp=$(host_proxy_fingerprint)
    # Reuse a live proxy only when its captured config still matches .env.
    # Otherwise restart it so an edited port/url/key/model takes effect (M2).
    if host_proxy_running; then
        if [[ -f "$fpf" && "$(cat "$fpf" 2>/dev/null)" == "$cur_fp" ]]; then
            return 0
        fi
        echo "[harness] host mode: .env changed since the proxy started; restarting it" >&2
        host_proxy_stop
    fi
    host_proxy_ensure_venv || return 1
    venv=$(host_venv_dir)
    port=$(host_proxy_port)
    pf=$(host_proxy_pidfile)
    lf=$(host_proxy_logfile)
    mkdir -p "$(host_state_dir)"
    echo "[harness] host mode: starting proxy on 127.0.0.1:$port" >&2
    echo "[harness] host mode: proxy log -> $lf" >&2
    # Debug dumps are OPT-IN, same as container mode (docker-compose.yml passes
    # OUTPUT_DIR=${OUTPUT_DIR:-}). We do NOT force OUTPUT_DIR here: the proxy
    # inherits it from .env (sourced with set -a) only when the user opts in,
    # and writes nothing by default. Host mode is the higher-blast-radius mode
    # (full host user, no firewall); it must not silently capture every prompt
    # to disk as plaintext (CONCERNS H3).
    # HARNESS_FORCE_LOOPBACK is belt-and-suspenders for the no-firewall mode:
    # proxy.py refuses to bind a non-loopback PROXY_HOST when it is set, so a
    # one-line regression in this launch path can't expose the keyed proxy on
    # the LAN (CONCERNS M3).
    PROXY_HOST=127.0.0.1 \
        HARNESS_FORCE_LOOPBACK=1 \
        PROXY_PORT="$port" \
        HARNESS_HOST_OS="$(harness_detect_os)" \
        nohup "$(host_venv_python)" "$clone_dir/proxy/proxy.py" >"$lf" 2>&1 &
    printf '%s\n' "$!" >"$pf"
    printf '%s\n' "$cur_fp" >"$fpf"
}

# Wait for the host proxy to accept connections on its loopback port. The proxy
# calls app.run() last (after all config validation), so an accepted connect
# means it is serving. A plain /dev/tcp probe avoids a curl dependency (mirrors
# host_mcp_port_open). Surfaces the proxy log on failure — the common cause is a
# config error that made _validate_config sys.exit(1).
host_proxy_wait_ready() {
    local port i=0
    port=$(host_proxy_port)
    while (( i < 50 )); do
        if ! host_proxy_running; then
            err "host proxy exited during startup; last log lines:"
            tail -n 20 "$(host_proxy_logfile)" >&2 2>/dev/null || true
            err "  full log: $(host_proxy_logfile)"
            return 1
        fi
        if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
            exec 3>&- 3<&- 2>/dev/null || true
            return 0
        fi
        sleep 0.2
        i=$((i+1))
    done
    err "host proxy did not start listening on 127.0.0.1:$port within ~10s"
    tail -n 20 "$(host_proxy_logfile)" >&2 2>/dev/null || true
    err "  full log: $(host_proxy_logfile)"
    return 1
}

# Stop the supervised host proxy: TERM, brief wait, then KILL. Removes the
# pidfile. Mirrors host_mcp_stop. Always returns 0.
host_proxy_stop() {
    local pid pf i
    pid=$(host_proxy_pid)
    pf=$(host_proxy_pidfile)
    if [[ -z "$pid" ]]; then
        rm -f "$pf" "$(host_proxy_fpfile)" 2>/dev/null || true
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    for i in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
    rm -f "$pf" "$(host_proxy_fpfile)" 2>/dev/null || true
}

# Write the host opencode config to a scoped file and point OPENCODE_CONFIG at
# it (done by the caller) so the user's global ~/.config/opencode/opencode.json
# is never touched. Same shape as the container entrypoint's
# ensure_opencode_config, but baseURL → 127.0.0.1 and built with harness_jq.
# curl is optional: the model dropdown comes from the proxy's /v1/models when
# curl is present, else falls back to DEFAULT_MODEL_NAME alone.
host_write_opencode_config() {
    # host_preflight (run first in cmd_host) guarantees host jq is present, so
    # the harness_jq calls below resolve to bare jq, never the docker sidecar —
    # which would fail in the no-docker mode. Assert it directly so any future
    # caller that reaches here without preflight, or a refactor that makes
    # preflight non-fatal, fails loud instead of silently pulling in docker
    # (CONCERNS M4).
    command -v jq >/dev/null 2>&1 || {
        err "host mode: 'jq' not found on host; cannot build the opencode config"
        return 1
    }
    local config_file port proxy_url default_model ctx
    config_file=$(host_opencode_config)
    mkdir -p "$(dirname "$config_file")"
    port=$(host_proxy_port)
    proxy_url="http://127.0.0.1:${port}/v1"
    default_model="${DEFAULT_MODEL_NAME:-}"
    ctx="${MODEL_CONTEXT_LENGTH:-${OLLAMA_CONTEXT_LENGTH:-200000}}"

    local model_ids=() catalog
    if command -v curl >/dev/null 2>&1; then
        catalog=$(curl -fsS --max-time 10 "${proxy_url}/models" 2>/dev/null || true)
        if [[ -n "$catalog" ]]; then
            mapfile -t model_ids < <(printf '%s' "$catalog" \
                | harness_jq -r '.data[]?.id' 2>/dev/null | sort -u || true)
        fi
    fi
    if [[ -n "$default_model" ]]; then
        local found=0 m
        for m in "${model_ids[@]}"; do [[ "$m" == "$default_model" ]] && found=1; done
        (( found == 0 )) && model_ids+=("$default_model")
    fi
    if (( ${#model_ids[@]} == 0 )); then
        model_ids=("${default_model:-default}")
    fi

    local selected="$default_model"
    [[ -z "$selected" ]] && selected="${model_ids[0]}"

    local models_json
    models_json=$(printf '%s\n' "${model_ids[@]}" | harness_jq -R . | harness_jq -s \
        --argjson ctx "$ctx" \
        'map({key: ., value: {name: ., limit: {context: $ctx, output: 8192}}}) | from_entries')

    # apiKey is a deliberate dummy: the real upstream key lives in the proxy's
    # Authorization header, never in opencode's config. opencode requires the
    # field to be non-empty, so we pass a placeholder it never sends anywhere
    # (the proxy talks to upstream; opencode only talks to 127.0.0.1).
    harness_jq -n \
        --arg provider_name "GenAI Harness" \
        --arg proxy_url "$proxy_url" \
        --arg selected "harness/${selected}" \
        --argjson models "$models_json" \
        '{
          "$schema": "https://opencode.ai/config.json",
          "provider": {
            "harness": {
              "npm": "@ai-sdk/openai-compatible",
              "name": $provider_name,
              "options": {"baseURL": $proxy_url, "apiKey": "harness-dummy"},
              "models": $models
            }
          },
          "model": $selected,
          "small_model": $selected,
          "agent": {
            "yolo": {
              "description": "Auto-approve all permissions; harness yolo mode",
              "permission": {"edit": "allow", "bash": {"*": "allow"}, "webfetch": "allow", "websearch": "allow"}
            }
          }
        }' > "$config_file"
}

# Launch opencode against the host proxy. Mirrors agents/entrypoint.sh
# run_opencode (provider env, --agent yolo, and the headless `-p` json-events +
# `opencode export` dance that dodges opencode 1.15.x's render race). Interactive
# runs as a child (not exec) so the proxy is torn down on exit; print mode leaves
# the proxy up so a scripted `-p` loop doesn't thrash it (`harness host down`
# stops it).
host_run_opencode() {
    local yolo="$1" print_mode="$2"; shift 2
    local pass_args=("$@")

    export OPENCODE_CONFIG="$(host_opencode_config)"
    export OPENCODE_DISABLE_AUTOUPDATE=1
    # Exa web-search parity with container mode. Intentional in host mode too:
    # host mode already runs with NO egress firewall (the confirm gate makes
    # that explicit), so enabling a web-search provider adds no new exposure
    # beyond the unrestricted outbound the user already accepted (CONCERNS L4).
    export OPENCODE_ENABLE_EXA=1

    local args=()
    [[ "$yolo" == "1" ]] && args+=(--agent yolo)

    echo "============================================================" >&2
    echo " harness host (opencode, containerless)" >&2
    echo "   provider: GenAI Harness" >&2
    echo "   model:    harness/${DEFAULT_MODEL_NAME:-default}" >&2
    echo "   proxy:    http://127.0.0.1:$(host_proxy_port)/v1" >&2
    echo "   yolo:     ${yolo}" >&2
    echo "   print:    ${print_mode}" >&2
    echo "============================================================" >&2

    if [[ "$print_mode" == "1" ]]; then
        # opencode has no -p flag — strip a leading -p/--print and hand the rest
        # to `opencode run`. Same as the container entrypoint.
        local op_args=() seen_p=0 arg
        if (( ${#pass_args[@]} )); then
            for arg in "${pass_args[@]}"; do
                if [[ "$seen_p" == "0" && ( "$arg" == "-p" || "$arg" == "--print" ) ]]; then
                    seen_p=1
                    continue
                fi
                op_args+=("$arg")
            done
        fi

        local events_file rc sid text
        events_file="$(mktemp)"
        local -a runcmd=(opencode run --format json)
        (( ${#args[@]} )) && runcmd+=("${args[@]}")
        (( ${#op_args[@]} )) && runcmd+=("${op_args[@]}")
        rc=0
        "${runcmd[@]}" >"${events_file}" || rc=$?
        sid="$(harness_jq -rs 'map(select(.sessionID))[0].sessionID // empty' "${events_file}" 2>/dev/null || true)"
        if [[ -z "${sid}" ]]; then
            sid="$(opencode session list --format json 2>/dev/null \
                | harness_jq -r --arg dir "$PWD" '((map(select(.directory==$dir)) | max_by(.created) | .id) // (max_by(.created) | .id)) // empty' 2>/dev/null || true)"
        fi
        text=""
        if [[ -n "${sid}" ]]; then
            text="$(opencode export "${sid}" 2>/dev/null \
                | harness_jq -r '([.messages[] | select(.info.role=="assistant")] | last | (.parts[]? | select(.type=="text") | .text)) // empty' 2>/dev/null || true)"
        fi
        if [[ -z "${text}" ]]; then
            text="$(harness_jq -rs '[.[] | select(.type=="text") | .part.text] | join("")' "${events_file}" 2>/dev/null || true)"
        fi
        [[ -n "${text}" ]] && printf '%s\n' "${text}"
        rm -f "${events_file}"
        # Print mode deliberately leaves the proxy up so a scripted `-p` loop
        # doesn't thrash it. Remind the user it is now orphaned, since nothing
        # reaps it (CONCERNS M1). Goes to stderr so it never pollutes -p stdout.
        if host_proxy_running; then
            err "[harness] host proxy still running on 127.0.0.1:$(host_proxy_port) (pid $(host_proxy_pid)); stop it with: harness host down"
        fi
        return "${rc}"
    fi

    # Interactive: child process (not exec) so we can stop the proxy after.
    local -a cmd=(opencode)
    (( ${#args[@]} )) && cmd+=("${args[@]}")
    (( ${#pass_args[@]} )) && cmd+=("${pass_args[@]}")
    local rc=0
    "${cmd[@]}" || rc=$?
    host_proxy_stop
    return "$rc"
}

# `harness host` — containerless launch. `harness host down` stops the proxy.
cmd_host() {
    if [[ "${1:-}" == "down" ]]; then
        cmd_host_down
        return
    fi

    # Intercept -h/--help BEFORE any side effects (preflight, confirm gate,
    # proxy start). Without this, 'harness host --help' would fall through to
    # opencode and only print its help after launching the proxy.
    case "${1:-}" in
        -h|--help)
            cat <<'EOF'
harness host — run CONTAINERLESS: the proxy + opencode as plain host processes.

usage:
  harness host [--yolo] [-p "PROMPT"] [agent flags...]
  harness host down            stop the background host proxy

No docker, no images, no egress firewall; opencode runs as your full host user,
so every launch prompts to confirm (set HARNESS_HOST_CONFIRM=1 to skip it in
automation). Only Python 3 is required on the host: jq, Node >= 20, and opencode
are fetched automatically on first run into state/host/toolchain (a satisfactory
host jq/Node/opencode is reused instead). The proxy binds 127.0.0.1 only; its log
lives at state/host/proxy.log. Any other flag is forwarded to opencode unchanged.

notes:
  - v1: single CWD, no host-MCP wiring. Runs on Linux, macOS, and Windows
    (Git Bash). On Windows, Python 3 is 'python'/'py' (the python.org build);
    opencode's own Git Bash support is rough — see docs/WINDOWS.md "Host mode
    on Windows" before relying on it.
  - debug dumps are OFF by default (opt in via OUTPUT_DIR in .env, same as
    container mode).
  - interactive runs stop the proxy on exit; `-p` (print mode) leaves it
    running for scripted loops — stop it with `harness host down`.
  - host-only installs (no docker) upgrade with `harness upgrade`, which pulls
    code + merges .env and skips the image rebuild.
EOF
            return 0
            ;;
    esac

    local yolo=0 print_mode=0
    local pass_args=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --yolo)      yolo=1 ;;
            -p|--print)  print_mode=1; pass_args+=("$arg") ;;
            *)           pass_args+=("$arg") ;;
        esac
    done

    host_require_python3 || exit 1
    host_require_config
    host_confirm_gate "$yolo" || exit 1

    ensure_dirs
    host_ensure_toolchain || exit 1   # fetch jq/Node/opencode (downloads happen here, post-confirm)
    host_preflight || exit 1          # verify the toolchain resolves before launching
    host_proxy_start || exit 1
    host_proxy_wait_ready || { host_proxy_stop; exit 1; }
    host_write_opencode_config

    local rc=0
    if (( ${#pass_args[@]} )); then
        host_run_opencode "$yolo" "$print_mode" "${pass_args[@]}" || rc=$?
    else
        host_run_opencode "$yolo" "$print_mode" || rc=$?
    fi
    exit "$rc"
}

cmd_host_down() {
    if host_proxy_running; then
        echo "[harness] host mode: stopping proxy" >&2
        host_proxy_stop
    else
        echo "[harness] host mode: no proxy running" >&2
    fi
}

# Run an opencode agent in the current directory.
#
# The agent's CWD is bind-mounted at the same absolute host path inside the
# container (e.g. /home/me/proj → /home/me/proj, /c/Users/you/proj →
# /c/Users/you/proj on Windows Git Bash) so paths are identical from host
# to container. Additional `--mount <path>` flags (and HARNESS_EXTRA_MOUNTS
# from .env) bind in extra host folders at their absolute paths too.
#
# The shared agent home is bind-mounted from <install-root>/state/agent/home
# at /home/harness; the firewall allowlist at /etc/harness/allowlist:ro.
#
# -p / --print uses the same foreground path with HARNESS_PRINT_MODE=1 set
# (which makes opencode use `opencode run`).
run_agent() {
    local tool="$1"; shift

    # Parse --yolo, --net, --mount, and -p/--print. --yolo and --net can
    # appear anywhere; -p/--print is preserved in pass_args (opencode's
    # entrypoint detects it and switches to `opencode run`). --mount takes
    # a path argument and is
    # repeatable; the path is resolved+validated here (relative paths
    # become absolute, missing paths error out) and never reaches the
    # agent CLI.
    local yolo=0
    local print_mode=0
    local net_open=0
    local pass_args=()
    local extra_mounts=()
    local expecting_mount_arg=0
    for arg in "$@"; do
        if (( expecting_mount_arg )); then
            extra_mounts+=("$arg")
            expecting_mount_arg=0
            continue
        fi
        case "$arg" in
            --yolo)
                yolo=1
                ;;
            --net)
                # Per-invocation firewall opt-out. Loud audit log on stderr
                # so the choice shows up in scrollback / shell logs even if
                # the user runs the agent unattended.
                net_open=1
                err "WARNING: --net disables the egress firewall for this $tool launch."
                err "         The container will have unrestricted outbound network."
                ;;
            --mount)
                expecting_mount_arg=1
                ;;
            --mount=*)
                extra_mounts+=("${arg#--mount=}")
                ;;
            -p|--print)
                print_mode=1
                pass_args+=("$arg")
                ;;
            *)
                pass_args+=("$arg")
                ;;
        esac
    done
    if (( expecting_mount_arg )); then
        err "--mount requires a path argument"
        exit 1
    fi

    require_docker

    # Probe upstream auth before doing anything expensive. When services are
    # already up (the common case for `harness` / `harness opencode`),
    # `ensure_services_up` is a no-op and `cmd_start`'s probe never runs —
    # the agent would otherwise launch and surface a locked key as an opaque
    # error from the proxy. Gating here makes the unlock URL appear before
    # any container is touched.
    _gate_on_upstream_auth || exit 1

    ensure_services_up
    ensure_dirs

    # Synchronous bounded check (4s) so "update available" surfaces on the
    # first invocation that sees drift, not the run after it. On timeout or
    # network failure this falls back to a cached value and continues —
    # never blocks the launch. The trailing `|| true` is a hard guarantee
    # that nothing inside the helper can ever abort agent launch via set -e.
    _update_check_and_banner 4 || true

    # Offer to merge newly-introduced config keys/hosts (e.g. after a
    # `harness update` pulled new code) before launch. Pure-bash precheck;
    # silent no-op when nothing changed. Skipped in headless mode and never
    # gates the launch (the `|| true` is belt-and-braces under set -e).
    _check_and_offer_config_merge "$print_mode" || true

    # Persistent agent firewall override: `harness net open agent` writes
    # an `agent` entry to .harness-net-overrides.json. Honor it here so
    # the launch picks up the disabled-firewall state without needing
    # --net per invocation. Either the per-launch flag or the persistent
    # override is enough.
    if [[ -f "$net_overrides_path" ]]; then
        local agent_override
        agent_override=$(harness_jq -r '.services.agent.firewall_disabled // false' "$net_overrides_path" 2>/dev/null || echo "false")
        if [[ "$agent_override" == "true" ]]; then
            net_open=1
        fi
    fi

    # Pre-launch: prompt user if any firewall is currently open. Skipped via
    # HARNESS_NET_CONFIRM=1 (set by tests). --net is part of the prompt
    # decision; we pass the flag in.
    warn_if_firewall_open "$net_open" "$tool" || exit 1

    local mount_path
    mount_path=$(harness_abs_path "$PWD") || {
        err "cannot resolve current directory: $PWD"
        exit 1
    }

    # Merge --mount flags with HARNESS_EXTRA_MOUNTS (colon-separated, like
    # PATH). Validate each entry: must exist as a directory; rejected if
    # under container infrastructure (/etc, /usr, /home/harness, ...).
    # The resolved set is deduped against $mount_path and against itself,
    # so passing the same dir twice (or passing the CWD as an extra mount)
    # is a no-op rather than a mount-conflict error.
    if [[ -n "${HARNESS_EXTRA_MOUNTS:-}" ]]; then
        local IFS_save="$IFS"
        IFS=':'
        for em in $HARNESS_EXTRA_MOUNTS; do
            [[ -z "$em" ]] && continue
            extra_mounts+=("$em")
        done
        IFS="$IFS_save"
    fi
    local resolved_mounts=()
    declare -A seen_mounts=()
    seen_mounts["$mount_path"]=1
    if (( ${#extra_mounts[@]} > 0 )); then
        local raw abs
        for raw in "${extra_mounts[@]}"; do
            abs=$(harness_validate_mount "$raw") || exit 1
            if [[ -z "${seen_mounts[$abs]:-}" ]]; then
                resolved_mounts+=("$abs")
                seen_mounts["$abs"]=1
            fi
        done
    fi

    # Resolve unified image + shared home.
    local image agent_home
    image=$(agent_image)
    agent_home=$(agent_home_dir)
    mkdir -p "$agent_home"

    # Refresh the MCP side file before launch so the entrypoint sees the
    # current set of enabled MCPs. Done after mkdir so the dir exists.
    write_agent_mcp_config

    # Build image on demand if missing — different from the per-tool
    # behavior pre-13a where `harness start` was the only build path.
    # `harness <tool>` is the natural first command users try; auto-build
    # avoids the "no, you have to run start first" dance.
    if ! harness_docker image inspect "$image" >/dev/null 2>&1; then
        echo "harness: building $image (one-time)..."
        compose --profile agent build agent || {
            err "agent image build failed; cannot launch $tool"
            exit 1
        }
    fi

    local network="${project_name}_harness-net"

    # Serialize the resolved extras as a single newline-delimited string so
    # we can pass it through positional args without forcing every callee
    # to accept a varargs array. The launchers split it back on newlines.
    local mounts_blob=""
    if (( ${#resolved_mounts[@]} > 0 )); then
        mounts_blob=$(printf '%s\n' "${resolved_mounts[@]}")
    fi

    if (( print_mode )); then
        run_agent_print "$tool" "$yolo" "$net_open" "$mount_path" "$image" \
            "$agent_home" "$network" "$mounts_blob" "${pass_args[@]}"
    else
        run_agent_interactive "$tool" "$yolo" "$net_open" "$mount_path" "$image" \
            "$agent_home" "$network" "$mounts_blob" "${pass_args[@]}"
    fi
}

# Common -e flags shared between print and interactive launchers. Echoes
# one flag per line so the caller can splice them into a docker_args array.
agent_common_env() {
    local tool="$1"
    local yolo="$2"
    local net_open="${3:-0}"
    local mount_path="${4:-}"
    printf -- '-e\nHOST_UID=%s\n' "$(id -u)"
    printf -- '-e\nHOST_GID=%s\n' "$(id -g)"
    printf -- '-e\nHARNESS_YOLO=%s\n' "$yolo"
    printf -- '-e\nDEFAULT_MODEL_NAME=%s\n' "$agent_model"
    # opencode talks directly to the translating proxy over its OpenAI-
    # compatible interface; the entrypoint builds the provider baseURL
    # (http://proxy:${PROXY_PORT}/v1) and discovers models off /v1/models.
    # PROXY_PORT is sourced from .env into this shell; default 8000.
    printf -- '-e\nPROXY_PORT=%s\n' "${PROXY_PORT:-8000}"
    # Declared context window for opencode's model config. The same knob caps
    # the proxy's local token estimate. Legacy alias OLLAMA_CONTEXT_LENGTH is
    # honored as a fallback so existing .env files keep working.
    printf -- '-e\nMODEL_CONTEXT_LENGTH=%s\n' "${MODEL_CONTEXT_LENGTH:-${OLLAMA_CONTEXT_LENGTH:-200000}}"
    # Container CWD is also bind-mounted at this exact path; the entrypoint
    # cd's here after the gosu drop. Surfaced as an env var so agents (and
    # any user scripts inside the container) can identify the host launch
    # path without parsing /proc/self/cwd.
    if [[ -n "$mount_path" ]]; then
        printf -- '-e\nHARNESS_HOST_CWD=%s\n' "$mount_path"
    fi
    if [[ "$net_open" == "1" ]]; then
        # Honored by firewall/init-firewall.sh — full opt-out. Setting it to
        # "0" explicitly when not opted-in is intentional: a stale value in
        # the environment can't accidentally re-enable the bypass.
        printf -- '-e\nHARNESS_FIREWALL_DISABLED=1\n'
    fi
}

# Build the env-flag array from agent_common_env's newline-delimited output.
collect_agent_env() {
    local tool="$1" yolo="$2" net_open="${3:-0}" mount_path="${4:-}"
    local -a out=()
    while IFS= read -r line; do
        out+=("$line")
    done < <(agent_common_env "$tool" "$yolo" "$net_open" "$mount_path")
    printf '%s\0' "${out[@]}"
}

# Footer shown after an interactive agent session exits. Mirrors the
# "report a bug" line harness-install.sh prints at the end of install.
# Written to stderr (never stdout, so captured/piped output stays clean)
# and only after the run — anything printed before the TUI launches is
# wiped when opencode takes the alt-screen. Not emitted in -p/print mode,
# which is for scripts and pipes.
_print_agent_issue_footer() {
    echo "" >&2
    echo "Found a bug or have an improvement to suggest, however small?" >&2
    echo "  https://github.com/HandelSim/harness/issues" >&2
}

run_agent_interactive() {
    local tool="$1" yolo="$2" net_open="$3" mount_path="$4" image="$5"
    local agent_home="$6" network="$7" mounts_blob="$8"
    shift 8
    local pass_args=("$@")
    local extra_mounts=()
    if [[ -n "$mounts_blob" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && extra_mounts+=("$line")
        done <<<"$mounts_blob"
    fi

    local cname
    cname=$(agent_container_name "$tool")

    # The name carries a per-launch random suffix, so multiple agents can run
    # from the same directory at once — no collision check, no pre-launch rm.
    # --rm cleans each container up on exit.

    # --user 0:0 overrides the image's USER harness directive so the
    # entrypoint can remap the harness uid/gid to the host caller before
    # gosu-dropping back to harness. Without this, the container runs as
    # harness uid 1000 directly and the remap block is bypassed (matching
    # the test-mode path used by full_pipeline_test.sh).
    #
    # --rm + -it: the agent CLI is the container's foreground process. The
    # user's terminal connects directly to its PTY; container exits when
    # the agent exits, and Docker removes it.
    #
    # On Windows, bash's `[[ -t 0 ]]` and the native docker.exe disagree about
    # whether stdin is a terminal (issue #82); harness_resolve_interactive_tty
    # reconciles them and may route the launch through winpty. On Linux/macOS
    # it reduces to the historical `-it` if stdin is a tty, else `-i`.
    local tty_strategy tty_flag="-it" use_winpty=0
    tty_strategy=$(harness_resolve_interactive_tty "$image")
    case "$tty_strategy" in
        it-winpty) tty_flag="-it"; use_winpty=1 ;;
        i)         tty_flag="-i" ;;
        *)         tty_flag="-it" ;;
    esac

    local docker_args=(
        run --rm "$tty_flag"
        --name "$cname"
        --user 0:0
        --network "$network"
        # The agent entrypoint runs init-firewall.sh as root before gosu-
        # dropping to harness; iptables/ipset need NET_ADMIN/NET_RAW.
        --cap-add NET_ADMIN
        --cap-add NET_RAW
        # The firewall is IPv4-only; disable the kernel IPv6 stack so dualstack
        # hosts' AAAA records can't draw an unroutable IPv6 connect attempt
        # (instant ENETUNREACH) and v6 egress can't slip past the v4 rules.
        # Must be set at creation: /proc/sys is read-only inside the container.
        --sysctl net.ipv6.conf.all.disable_ipv6=1
    )

    local env_line
    while IFS= read -r -d '' env_line; do
        docker_args+=("$env_line")
    done < <(collect_agent_env "$tool" "$yolo" "$net_open" "$mount_path")

    # If an enabled host MCP is present, map host.docker.internal into the
    # container and tell the firewall to open it. No-op otherwise.
    while IFS= read -r -d '' env_line; do
        docker_args+=("$env_line")
    done < <(emit_host_mcp_docker_args)

    # Normalize host bind-mount sources for Windows Docker Desktop.
    # On Linux/macOS these are passthrough; on Windows they're rewritten
    # to C:/Users/... form which Docker Desktop's WSL2 backend mounts
    # reliably (raw /tmp/... or /c/Users/... paths sometimes mount empty).
    local mp_host ah_host alp_host
    mp_host=$(harness_docker_path "$mount_path")
    ah_host=$(harness_docker_path "$agent_home")
    alp_host=$(harness_docker_path "$allowlist_path")

    # CWD bind-mounted at the same absolute host path inside the container,
    # the harness home, and the read-only firewall allowlist. Emitted via
    # harness_add_bind_mount so Windows gets the `--mount` form that survives
    # MSYS/winpty path-list conversion (issue #112); Linux/macOS get `-v`.
    harness_add_bind_mount docker_args "$mp_host" "$mount_path"
    harness_add_bind_mount docker_args "$ah_host" "/home/harness"
    # Universal firewall allowlist, read-only. The init script aborts the
    # container if this is missing.
    harness_add_bind_mount docker_args "$alp_host" "/etc/harness/allowlist" ro
    # Extra --mount entries land at their own host paths too. Docker handles
    # nested bind mounts (e.g. /c/user mounted alongside /c/user/handel)
    # by applying the more-specific mount within its target subtree.
    if (( ${#extra_mounts[@]} > 0 )); then
        local em em_host
        for em in "${extra_mounts[@]}"; do
            em_host=$(harness_docker_path "$em")
            harness_add_bind_mount docker_args "$em_host" "$em"
        done
    fi
    docker_args+=(
        -w "$(harness_container_workdir "$mount_path")"
        --label "harness.agent=true"
        --label "harness.project=$project_name"
        --label "harness.tool=$tool"
        --label "harness.mount=$mount_path"
        "$image"
        "$tool"
    )
    if (( ${#pass_args[@]} > 0 )); then
        docker_args+=("${pass_args[@]}")
    fi

    # Run docker as a child (not exec) so the issue footer can print once the
    # session exits. _reap_jq_sidecar runs here and again from the EXIT trap on
    # `exit` below; it's idempotent, so the second call is a cheap no-op.
    _reap_jq_sidecar
    local rc=0
    if (( use_winpty )); then
        harness_docker_winpty "${docker_args[@]}" || rc=$?
    else
        harness_docker "${docker_args[@]}" || rc=$?
    fi
    _print_agent_issue_footer

    # When this was the LAST agent for the project, tear the shared stack
    # (proxy + enabled MCPs) down too, so an exited agent never leaves the
    # control plane running with nothing using it. `stop_stack_if_last_agent`
    # counts remaining labeled agent containers (both interactive and print);
    # this agent's own container is already gone (--rm), so a zero count means
    # it was the last. Only the interactive exit triggers teardown — a print
    # agent that outlives this one still holds the count non-zero and keeps the
    # stack up, and print agents don't trigger teardown themselves (see
    # run_agent_print) so a scripted `-p` loop doesn't thrash the stack.
    stop_stack_if_last_agent
    exit "$rc"
}

# Headless single-shot agent invocation. No tmux, no detach. Carries the same
# harness.agent labels as an interactive launch (so it counts toward the
# project's agent total and protects the shared stack while it runs — it does
# appear in `harness list` for its duration). Container is auto-removed on exit.
# stdin handling: -it if running on a TTY, -i otherwise — the agent needs the
# TTY for some output formats but pipe-based callers shouldn't get a TTY.
run_agent_print() {
    local tool="$1" yolo="$2" net_open="$3" mount_path="$4" image="$5"
    local agent_home="$6" network="$7" mounts_blob="$8"
    shift 8
    local pass_args=("$@")
    local extra_mounts=()
    if [[ -n "$mounts_blob" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && extra_mounts+=("$line")
        done <<<"$mounts_blob"
    fi

    local tty_flag
    if [[ -t 0 ]]; then
        tty_flag="-it"
    else
        tty_flag="-i"
    fi

    local docker_args=(
        run --rm "$tty_flag"
        --user 0:0
        --network "$network"
        # See run_agent_interactive for the cap + IPv6 rationale.
        --cap-add NET_ADMIN
        --cap-add NET_RAW
        --sysctl net.ipv6.conf.all.disable_ipv6=1
    )

    local env_line
    while IFS= read -r -d '' env_line; do
        docker_args+=("$env_line")
    done < <(collect_agent_env "$tool" "$yolo" "$net_open" "$mount_path")

    # See run_agent_interactive: map host.docker.internal + signal the firewall
    # when an enabled host MCP is present. No-op otherwise.
    while IFS= read -r -d '' env_line; do
        docker_args+=("$env_line")
    done < <(emit_host_mcp_docker_args)

    # See run_agent_interactive for the harness_docker_path rationale.
    local mp_host ah_host alp_host
    mp_host=$(harness_docker_path "$mount_path")
    ah_host=$(harness_docker_path "$agent_home")
    alp_host=$(harness_docker_path "$allowlist_path")

    docker_args+=(
        -e "HARNESS_PRINT_MODE=1"
    )
    # See run_agent_interactive for why we mount at $mount_path and why these
    # go through harness_add_bind_mount (Windows `--mount` form, issue #112).
    harness_add_bind_mount docker_args "$mp_host" "$mount_path"
    harness_add_bind_mount docker_args "$ah_host" "/home/harness"
    harness_add_bind_mount docker_args "$alp_host" "/etc/harness/allowlist" ro
    if (( ${#extra_mounts[@]} > 0 )); then
        local em em_host
        for em in "${extra_mounts[@]}"; do
            em_host=$(harness_docker_path "$em")
            harness_add_bind_mount docker_args "$em_host" "$em"
        done
    fi
    docker_args+=(
        -w "$(harness_container_workdir "$mount_path")"
        # Labelled like an interactive agent so a running print agent counts
        # toward the project's agent total: an interactive agent exiting won't
        # tear the shared stack out from under a concurrent `-p` run (see
        # stop_stack_if_last_agent). Print agents don't trigger teardown
        # themselves, so a scripted `-p` loop doesn't churn the stack. The
        # trade-off: a `-p` agent now shows in `harness list` while it runs.
        --label "harness.agent=true"
        --label "harness.project=$project_name"
        --label "harness.tool=$tool"
        --label "harness.mount=$mount_path"
        "$image"
        "$tool"
    )
    if (( ${#pass_args[@]} > 0 )); then
        docker_args+=("${pass_args[@]}")
    fi

    # exec bypasses the EXIT trap — reap the jq sidecar before it.
    _reap_jq_sidecar
    harness_docker_exec "${docker_args[@]}"
}

# Drop into an interactive bash shell inside the unified agent container.
# Uses the same shared home as `harness opencode`, so any
# install (pipx, pip --user, etc.) the user does in here is visible to the
# agent commands later. Useful for installing skill-style tools (graphify),
# poking around, debugging.
cmd_shell() {
    require_docker
    ensure_dirs

    # Same --mount parsing as run_agent. The shell shares the same mount
    # contract with opencode: CWD at its host path, plus any
    # extras the user passed (or set in HARNESS_EXTRA_MOUNTS).
    local extra_mounts=()
    local expecting_mount_arg=0
    local arg
    for arg in "$@"; do
        if (( expecting_mount_arg )); then
            extra_mounts+=("$arg")
            expecting_mount_arg=0
            continue
        fi
        case "$arg" in
            --mount)        expecting_mount_arg=1 ;;
            --mount=*)      extra_mounts+=("${arg#--mount=}") ;;
            *)              err "unknown shell flag: $arg"; exit 1 ;;
        esac
    done
    if (( expecting_mount_arg )); then
        err "--mount requires a path argument"
        exit 1
    fi

    # Same banner as run_agent; see _update_check_and_banner. `|| true`
    # ensures the helper can never abort shell launch via set -e.
    _update_check_and_banner 4 || true

    # Same config-merge offer as run_agent (shell is always interactive, so
    # print_mode is 0). Never gates the shell launch.
    _check_and_offer_config_merge 0 || true

    local image
    image=$(agent_image)
    if ! harness_docker image inspect "$image" >/dev/null 2>&1; then
        echo "harness: building $image (one-time)..."
        compose --profile agent build agent || {
            err "agent image build failed; cannot launch shell"
            exit 1
        }
    fi

    local agent_home
    agent_home=$(agent_home_dir)
    mkdir -p "$agent_home"

    local mount_path
    mount_path=$(harness_abs_path "$PWD") || {
        err "cannot resolve current directory: $PWD"
        exit 1
    }

    # Merge HARNESS_EXTRA_MOUNTS, validate, dedupe against $mount_path.
    if [[ -n "${HARNESS_EXTRA_MOUNTS:-}" ]]; then
        local IFS_save="$IFS"
        IFS=':'
        for em in $HARNESS_EXTRA_MOUNTS; do
            [[ -z "$em" ]] && continue
            extra_mounts+=("$em")
        done
        IFS="$IFS_save"
    fi
    local resolved_mounts=()
    declare -A seen_mounts=()
    seen_mounts["$mount_path"]=1
    if (( ${#extra_mounts[@]} > 0 )); then
        local raw abs
        for raw in "${extra_mounts[@]}"; do
            abs=$(harness_validate_mount "$raw") || exit 1
            if [[ -z "${seen_mounts[$abs]:-}" ]]; then
                resolved_mounts+=("$abs")
                seen_mounts["$abs"]=1
            fi
        done
    fi

    local network="${project_name}_harness-net"
    if ! harness_docker network inspect "$network" >/dev/null 2>&1; then
        # Network doesn't exist (services never started). Use the default
        # bridge — the shell doesn't need to talk to the proxy.
        network="bridge"
    fi

    # See run_agent_interactive: on Windows reconcile bash's tty view with
    # what docker.exe accepts (issue #82); elsewhere `-it` vs `-i` as before.
    local tty_strategy tty_flag="-it" use_winpty=0
    tty_strategy=$(harness_resolve_interactive_tty "$image")
    case "$tty_strategy" in
        it-winpty) tty_flag="-it"; use_winpty=1 ;;
        i)         tty_flag="-i" ;;
        *)         tty_flag="-it" ;;
    esac

    local mp_host ah_host alp_host
    mp_host=$(harness_docker_path "$mount_path")
    ah_host=$(harness_docker_path "$agent_home")
    alp_host=$(harness_docker_path "$allowlist_path")

    # Persistent agent firewall override (`harness net open agent`) lets the
    # shell launch with the firewall disabled too. Mirrors the run_agent
    # logic for opencode launches.
    local fw_args=()
    if [[ -f "$net_overrides_path" ]]; then
        local agent_override
        agent_override=$(harness_jq -r '.services.agent.firewall_disabled // false' "$net_overrides_path" 2>/dev/null || echo "false")
        if [[ "$agent_override" == "true" ]]; then
            fw_args=(-e "HARNESS_FIREWALL_DISABLED=1")
        fi
    fi

    local shell_args=(
        run --rm "$tty_flag"
        --user 0:0
        --network "$network"
        --cap-add NET_ADMIN
        --cap-add NET_RAW
        # See run_agent_interactive: IPv4-only firewall ⇒ disable IPv6.
        --sysctl net.ipv6.conf.all.disable_ipv6=1
        -e "HOST_UID=$(id -u)"
        -e "HOST_GID=$(id -g)"
        -e "HARNESS_HOST_CWD=$mount_path"
        "${fw_args[@]}"
    )
    # CWD at its host path inside the container — same parity contract as
    # run_agent_interactive. harness_add_bind_mount emits the Windows
    # `--mount` form that survives MSYS/winpty conversion (issue #112).
    harness_add_bind_mount shell_args "$mp_host" "$mount_path"
    harness_add_bind_mount shell_args "$ah_host" "/home/harness"
    harness_add_bind_mount shell_args "$alp_host" "/etc/harness/allowlist" ro
    # Same host MCP reachability wiring as the agent launch, so `harness shell`
    # can reach an enabled host MCP (e.g. to curl it while debugging). No-op
    # when no host MCP is enabled.
    local hm_arg
    while IFS= read -r -d '' hm_arg; do
        shell_args+=("$hm_arg")
    done < <(emit_host_mcp_docker_args)
    if (( ${#resolved_mounts[@]} > 0 )); then
        local em em_host
        for em in "${resolved_mounts[@]}"; do
            em_host=$(harness_docker_path "$em")
            harness_add_bind_mount shell_args "$em_host" "$em"
        done
    fi
    shell_args+=(
        -w "$(harness_container_workdir "$mount_path")"
        "$image"
        shell
    )
    # Run docker as a child (not exec) so the issue footer can print once the
    # session exits. _reap_jq_sidecar runs here and again from the EXIT trap on
    # `exit` below; it's idempotent, so the second call is a cheap no-op.
    _reap_jq_sidecar
    local rc=0
    if (( use_winpty )); then
        harness_docker_winpty "${shell_args[@]}" || rc=$?
    else
        harness_docker "${shell_args[@]}" || rc=$?
    fi
    _print_agent_issue_footer
    exit "$rc"
}

cmd_list() {
    require_docker
    local rows
    rows=$(harness_docker ps \
        --filter "label=harness.agent=true" \
        --format '{{.Names}}\t{{.Label "harness.tool"}}\t{{.Label "harness.mount"}}\t{{.RunningFor}}')
    if [[ -z "$rows" ]]; then
        echo "no harness agents running"
        return 0
    fi
    {
        printf 'NAME\tTOOL\tMOUNT\tAGE\n'
        printf '%s\n' "$rows"
    } | column -t -s $'\t'
}

# List all running harness agents, returns lines: <name>\t<tool>\t<mount>.
list_agents_raw() {
    harness_docker ps \
        --filter "label=harness.agent=true" \
        --format '{{.Names}}\t{{.Label "harness.tool"}}\t{{.Label "harness.mount"}}'
}

# Render an interactive picker over the supplied newline-delimited list of
# agents (each line: name\ttool\tmount). Reads stdin for the selection.
# Echoes the chosen name on stdout.
pick_agent() {
    local rows="$1"
    if [[ ! -t 0 ]]; then
        err "ambiguous; provide a name explicitly"
        exit 1
    fi
    echo "running harness agents:" >&2
    local i=0
    local -a names=()
    while IFS=$'\t' read -r name tool mount; do
        i=$(( i + 1 ))
        names+=("$name")
        printf '  %d) %s  [%s]  %s\n' "$i" "$name" "$tool" "$mount" >&2
    done <<<"$rows"
    local choice
    read -rp "select [1-$i]: " choice </dev/tty
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > i )); then
        err "invalid selection"
        exit 1
    fi
    printf '%s\n' "${names[$((choice - 1))]}"
}

cmd_stop() {
    require_docker
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        local all
        all=$(list_agents_raw)
        if [[ -z "$all" ]]; then
            err "no harness agents running"
            exit 1
        fi
        local count
        count=$(printf '%s\n' "$all" | wc -l)
        if (( count == 1 )); then
            target=$(printf '%s' "$all" | cut -f1)
        else
            target=$(pick_agent "$all")
        fi
    fi

    harness_docker stop "$target" >/dev/null
    harness_docker rm "$target" >/dev/null 2>&1 || true
    echo "stopped: $target"
}

# --- mcp --------------------------------------------------------------------
#
# Long-running MCP services (Serena and friends) live in two parallel trees:
#
#   <repo>/mcp-registry/<name>/                # vetted definitions, source of truth
#   <install-root>/state/mcp/<name>/           # active copies; presence == enabled
#
# Enabling copies the registry entry into the active tree (preserving the
# upstream by-value, so the user can edit their copy without diverging the
# repo). Disabling removes everything except the optional `data/` dir,
# which holds per-MCP persistent state (indices, caches).

# Echo the registry entry directories that exist (one path per line). Names
# starting with `_` are reserved for fixtures (test entries) and excluded
# from the user-facing list view, but still resolvable by `enable`/`disable`
# for tests that target them by name.
list_registry_entries() {
    if [[ ! -d "$registry_dir" ]]; then
        return 0
    fi
    local d
    for d in "$registry_dir"/*/; do
        [[ -d "$d" ]] || continue
        printf '%s\n' "${d%/}"
    done
}

# Echo the active MCP entry directories that exist (one path per line).
list_active_entries() {
    if [[ ! -d "$mcp_active_dir" ]]; then
        return 0
    fi
    local d
    for d in "$mcp_active_dir"/*/; do
        [[ -d "$d" ]] || continue
        printf '%s\n' "${d%/}"
    done
}

# Best-effort runtime status for a single MCP service: parses
# `docker compose ps` to find a container whose service name matches the
# active entry. Container-name matching is brittle by design — MCP composes
# don't have a uniform service name — so we report the first active service
# we find inside the snippet.
mcp_runtime_status() {
    local name="$1"
    # Host MCPs run as a process on the host. harness supervises that process
    # (pidfile), so report its live state the same way it does for containers.
    if mcp_is_host "$name"; then
        if host_mcp_running "$name"; then
            printf -- 'host (running, pid %s)' "$(host_mcp_pid "$name")"
        else
            printf -- 'host (stopped)'
        fi
        return
    fi
    local compose_file="$mcp_active_dir/$name/compose.yml"
    [[ -f "$compose_file" ]] || { printf -- '-'; return; }
    if ! harness_docker info >/dev/null 2>&1; then
        printf -- 'runtime-down'; return
    fi
    # Pull the first service name out of the compose snippet. Naive YAML —
    # the snippet shape is constrained (we control the registry) so this is
    # deliberately not a full parser.
    local svc
    svc=$(awk '
        /^services:/ { in_svc=1; next }
        in_svc && /^[A-Za-z]/ { in_svc=0 }
        in_svc && /^  [A-Za-z][A-Za-z0-9_-]*:/ {
            sub(/:.*$/, "")
            sub(/^[[:space:]]+/, "")
            print
            exit
        }
    ' "$compose_file")
    if [[ -z "$svc" ]]; then
        printf 'unknown'
        return
    fi
    local cid
    cid=$(compose ps -q "$svc" 2>/dev/null || true)
    if [[ -z "$cid" ]]; then
        printf 'stopped'
        return
    fi
    local running health
    running=$(harness_docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null || echo "")
    health=$(harness_docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo "")
    if [[ "$running" != "true" ]]; then
        printf 'stopped'
        return
    fi
    case "$health" in
        healthy)   printf 'running (healthy)' ;;
        unhealthy) printf 'running (unhealthy)' ;;
        starting)  printf 'starting' ;;
        none|"")   printf 'running' ;;
        *)         printf 'running (%s)' "$health" ;;
    esac
}

cmd_mcp_help() {
    cat <<'EOF'
harness mcp — manage long-running MCP services.

usage:
  harness mcp <subcommand> [args...]

subcommands:
  list [--available]            show installed entries with state. With
                                  --available also list registry entries
                                  not yet installed.
  install <name> [--force]      copy a registry entry into the active tree
                                  and mark it enabled.
  register <name> --from <dir|git-url> [--ref <ref>] [--no-enable] [--start] [--force]
                                register an MCP from an arbitrary source (not
                                  the repo registry) — a registry-shaped dir or
                                  a git URL. The staged snippet is validated to
                                  merge into the compose graph (and not collide
                                  on service/container names) BEFORE it is
                                  armed, so it can't brick 'harness start'.
                                  --no-enable stages without auto-start; --start
                                  boots it now; --force re-registers (data/ kept).
  uninstall <name> [--force]    remove an installed entry; data/ is preserved
  enable <name>                 mark an installed MCP as auto-start.
                                  Brought up the next time the stack starts.
  disable <name>                mark an installed MCP as do-not-auto-start.
                                  Container is left alone; use 'mcp down' to
                                  stop one immediately or 'mcp up' to start
                                  one without flipping its enable state.
  up <name>                     start an installed MCP container immediately
  down <name>                   stop an installed MCP container
  logs <name>                   follow logs for a single MCP
  status <name>                 per-MCP diagnostic
  host-init <name> [--port <port>] [--force]
                                scaffold a HOST MCP (a build server that runs on
                                  the host, not in a container — e.g. MSVC/CMake
                                  on Windows) from the in-repo template and
                                  register it so agents get its URL. Default
                                  port 9100. No compose.yml; you run the server
                                  on the host. up/down/logs do not apply.
  host-setup <name> [agent flags...]
                                launch an agent inside the host MCP's folder so
                                  it reads AGENTS.md and helps you tailor the
                                  server (server.py + project.json).

state diagram:
  available --install/register--> installed-enabled <-> installed-disabled
                                          \--uninstall--> available

install reads the repo-tracked registry; register lands an external source
(dir or git URL) behind a compose-merge validation gate. Both converge on the
same installed entry; uninstall is the inverse of both.

The four canonical lifecycle verbs (install / uninstall / enable / disable)
are distinct: install/uninstall move between available and installed;
enable/disable flip the auto-start flag on an already-installed entry.

After install/uninstall/enable/disable, the change takes effect the next time
the stack starts: run 'harness' if it's down, or 'harness restart' if it's
already up. 'mcp up' / 'mcp down' bypass the restart cycle and act on a single
MCP.
EOF
}

cmd_mcp_list() {
    # Default: only show installed entries. With --available, also show
    # registry entries that haven't been installed yet (state: available).
    local show_available=0
    while (( $# > 0 )); do
        case "$1" in
            --available) show_available=1 ;;
            -*) err "unknown flag '$1'"; exit 1 ;;
            *) err "unexpected extra argument '$1'"; exit 1 ;;
        esac
        shift
    done

    local printed_header=0
    local seen_names=()

    # Walk the registry first (canonical order) and decorate with active state.
    while IFS= read -r entry_dir; do
        [[ -n "$entry_dir" ]] || continue
        local name
        name=$(basename "$entry_dir")
        # Hide reserved test fixture names from user output.
        [[ "$name" =~ ^_ ]] && continue
        local state status
        if mcp_is_installed "$name"; then
            if mcp_is_enabled "$name"; then
                state="installed-enabled"
            else
                state="installed-disabled"
            fi
            status=$(mcp_runtime_status "$name")
        else
            state="available"
            status="-"
            (( show_available )) || { seen_names+=("$name"); continue; }
        fi
        if (( printed_header == 0 )); then
            printf '%-20s %-22s %s\n' "NAME" "STATE" "STATUS"
            printed_header=1
        fi
        printf '%-20s %-22s %s\n' "$name" "$state" "$status"
        seen_names+=("$name")
    done < <(list_registry_entries)

    # Surface anything in the active tree that doesn't have a registry entry
    # (locally-edited copies; install-custom removed in 13b).
    while IFS= read -r entry_dir; do
        [[ -n "$entry_dir" ]] || continue
        local name
        name=$(basename "$entry_dir")
        [[ "$name" =~ ^_ ]] && continue
        local already=0 s
        for s in "${seen_names[@]}"; do
            if [[ "$s" == "$name" ]]; then already=1; break; fi
        done
        (( already )) && continue
        if (( printed_header == 0 )); then
            printf '%-20s %-22s %s\n' "NAME" "STATE" "STATUS"
            printed_header=1
        fi
        local state status
        if mcp_is_enabled "$name"; then
            state="installed-enabled"
        else
            state="installed-disabled"
        fi
        status=$(mcp_runtime_status "$name")
        printf '%-20s %-22s %s\n' "${name} (local)" "$state" "$status"
    done < <(list_active_entries)

    if (( printed_header == 0 )); then
        if (( show_available )); then
            echo "no MCP entries (registry: $registry_dir)"
        else
            echo "no MCPs installed; run 'harness mcp list --available' to see what's available"
        fi
    fi
}

# Names of available registry entries, comma-separated, for error messages.
mcp_registry_names_csv() {
    local out=""
    while IFS= read -r entry_dir; do
        [[ -n "$entry_dir" ]] || continue
        local name
        name=$(basename "$entry_dir")
        [[ "$name" =~ ^_ ]] && continue
        if [[ -z "$out" ]]; then
            out="$name"
        else
            out="$out, $name"
        fi
    done < <(list_registry_entries)
    printf '%s' "${out:-(none)}"
}

# Echo the service names declared in an MCP's compose snippet, one per line.
# Empty output means we couldn't enumerate (missing file or compose error).
#
# MCP compose snippets reference ${INSTALL_ROOT}, ${HARNESS_ALLOWLIST_PATH},
# and ${HARNESS_PROJECTS_ROOT} in volume specs. Without those exported,
# compose interpolates them to empty and rejects the file as invalid, so
# `config --services` returns empty and callers conclude "no services".
# Mirror the env contract the `compose` wrapper sets.
mcp_services_of() {
    # Thin name-based wrapper; the path-based compose_services_of_file (defined
    # with the register helpers) is shared with register's collision check.
    compose_services_of_file "$mcp_active_dir/$1/compose.yml"
}

# --- shared materialize + register helpers ----------------------------------
#
# `install` and `register` converge on the same job: copy a registry-shaped
# source dir into the active tree (+ optional upstream clone for a build
# context) and arm it for auto-start. The body is factored here so the two
# commands can't drift. `register` adds a staging+validation gate on top so an
# arbitrary (untrusted) source can't brick `harness start` — all MCP snippets
# splice into ONE `docker compose up`, so a snippet that fails to merge takes
# the proxy and agent down with it.

# Atomically write {"enabled": <value>} into a specific meta file. Path-based
# sibling of mcp_set_enabled (which is name-based and only ever writes the
# active tree); register needs to arm a meta inside a staging dir before the
# entry is moved into place.
_mcp_set_enabled_file() {
    local meta="$1" value="$2"
    mkdir -p "$(dirname "$meta")"
    if [[ -f "$meta" ]]; then
        local tmp="${meta}.tmp.$$"
        # harness_jq (host jq, else container jq) flips .enabled while
        # PRESERVING the meta's other fields (allowed_domains, repo
        # provenance). Single file arg → the container path maps it to
        # stdin. Works on a docker-only host, where the printf fallback
        # below would otherwise clobber every field but .enabled.
        if harness_jq ".enabled = $value" "$meta" >"$tmp" 2>/dev/null; then
            mv "$tmp" "$meta"
            return 0
        fi
        rm -f "$tmp" 2>/dev/null || true
    fi
    # Last resort: no existing meta (or neither host jq nor container jq is
    # reachable). Write a minimal meta carrying just the enabled flag.
    printf '{"enabled": %s}\n' "$value" >"$meta"
}

# Print this MCP's allowed_domains as `harness net allow` recommendations. We
# never auto-open the allowlist: MCPs are third-party code; the operator opens
# egress deliberately. Empty/absent arrays produce no output. Shared by
# install and register so the recommendation text can't drift.
mcp_print_firewall_recs() {
    local meta="$1"
    [[ -f "$meta" ]] || return 0
    local domains
    # harness_jq (host jq, else container jq) so the recommendations still
    # print on a docker-only host. Single file arg → container path → stdin.
    domains=$(harness_jq -r '(.allowed_domains // []) | .[]' "$meta" 2>/dev/null || true)
    [[ -n "$domains" ]] || return 0
    echo
    echo "this MCP recommends allowlisting the following domains for outbound traffic:"
    local d
    while IFS= read -r d; do
        [[ -z "$d" ]] && continue
        echo "  $d"
    done <<<"$domains"
    echo
    echo "to add them, run:"
    while IFS= read -r d; do
        [[ -z "$d" ]] && continue
        echo "  harness net allow $d"
    done <<<"$domains"
}

# Materialize a registry-shaped source dir into a target dir: copy the
# descriptor files (rendering harness-meta.json.template -> harness-meta.json),
# clone the declared upstream repo into <target>/repo for a build context, and
# set the enabled flag. The caller is responsible for any pre-clean of the
# target (install force-wipes all-but-data first; register stages into a fresh
# dir). Does NOT touch <target>/data beyond ensuring it exists.
#
# Args: <name> <src_dir> <target_dir> <enabled_value> [ref_override]
# A non-empty ref_override pins the upstream clone (register --ref); otherwise
# the source meta's repo_clone_ref (default "main") is used.
mcp_materialize_src() {
    local name="$1" src="$2" target="$3" enabled_value="$4" ref_override="${5:-}"
    mkdir -p "$target"
    local f base
    for f in "$src"/* "$src"/.[!.]*; do
        [[ -e "$f" ]] || continue
        base=$(basename "$f")
        # The .template is a source-side default for harness-meta.json — copy
        # it under the real filename rather than leaving a .template around.
        if [[ "$base" == "harness-meta.json.template" ]]; then
            cp -a "$f" "$target/harness-meta.json"
            continue
        fi
        # repo/ (an upstream clone already placed by register's git-url path)
        # is the build context, not a descriptor file — never recursively
        # copy it onto itself when src == target's parent staging.
        cp -a "$f" "$target/"
    done
    mkdir -p "$target/data"

    # If the meta declares an upstream repo_clone_url, clone it into
    # <target>/repo so the compose snippet has a local build context. A
    # git-URL build context fails on Windows (Docker Desktop mis-parses the
    # URL as a host path); cloning host-side avoids that whole class of bug.
    # Skipped when <target>/repo/.git already exists (register's git-url path
    # pre-clones there), so --from <url> never double-clones.
    local meta_file="$target/harness-meta.json"
    if [[ -f "$meta_file" ]]; then
        local clone_url clone_ref
        clone_url=$(harness_jq -r '.repo_clone_url // empty' "$meta_file" 2>/dev/null || true)
        clone_ref=$(harness_jq -r '.repo_clone_ref // "main"' "$meta_file" 2>/dev/null || true)
        [[ -n "$ref_override" ]] && clone_ref="$ref_override"
        if [[ -n "$clone_url" ]]; then
            local clone_dir_local="$target/repo"
            if [[ -d "$clone_dir_local/.git" ]]; then
                echo "[harness] $name: repo clone already present at $clone_dir_local; skipping clone"
            else
                rm -rf "$clone_dir_local" 2>/dev/null || true
                echo "[harness] $name: cloning $clone_url ($clone_ref) to $clone_dir_local..."
                local clone_ok=0
                if [[ "$clone_ref" =~ ^[0-9a-f]{40}$ ]]; then
                    if ( set -e
                         mkdir -p "$clone_dir_local"
                         cd "$clone_dir_local"
                         git init -q
                         git remote add origin "$clone_url"
                         git fetch --depth=1 origin "$clone_ref"
                         git checkout -q FETCH_HEAD ); then
                        clone_ok=1
                    fi
                else
                    if git clone --depth=1 --branch "$clone_ref" "$clone_url" "$clone_dir_local"; then
                        clone_ok=1
                    fi
                fi
                if [[ $clone_ok -ne 1 ]]; then
                    err "$name: repo clone failed (target: $clone_dir_local)"
                    err "         clone URL: $clone_url ($clone_ref)"
                    return 1
                fi
            fi
        fi
    fi

    _mcp_set_enabled_file "$meta_file" "$enabled_value"
}

# Enumerate the service names declared by a single compose snippet, standalone.
# `--profile mcp` is required or profiled MCP services are omitted (verified
# against compose v2). Any config error renders as empty output.
compose_services_of_file() {
    local compose_file="$1"
    [[ -f "$compose_file" ]] || return 0
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker compose -f "$compose_file" --profile mcp config --services 2>/dev/null || true
}

# Enumerate the container_name values a single compose snippet declares. A
# snippet can dodge the service-name collision check yet hardcode a
# container_name another service already uses (Serena does); that fails `up`
# with "container name already in use" at start time, after the proxy is up.
# Catch it at register time. Any config error renders as empty output.
compose_cnames_of_file() {
    local compose_file="$1"
    [[ -f "$compose_file" ]] || return 0
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker compose -f "$compose_file" --profile mcp config --format json 2>/dev/null \
        | harness_jq -r '.services // {} | to_entries[] | .value.container_name // empty' 2>/dev/null || true
}

# Run `docker compose` over the full harness graph (main compose + runtime
# override + every currently-enabled MCP snippet), optionally splicing in one
# extra (staged) snippet BEFORE the subcommand. register's validation gate
# needs the staged `-f` and `--profile` ahead of `config`, which the public
# `compose` wrapper can't do (it appends caller args AFTER the subcommand).
# Runs under a throwaway project name so it can never resolve to — or act on —
# the live stack's containers; only ever invoked with read-only `config`.
# Args: <extra_compose_file_or_empty> <compose subcommand args...>
harness_compose_graph() {
    local extra="$1"; shift
    write_runtime_override
    local args=(
        compose
        --project-name "${project_name}-regcheck"
        -f "$(harness_docker_path "$clone_dir/docker-compose.yml")"
    )
    if [[ -f "$env_file" ]]; then args+=(--env-file "$(harness_docker_path "$env_file")"); fi
    if [[ -f "$runtime_override" ]]; then args+=(-f "$(harness_docker_path "$runtime_override")"); fi
    local mcp_arg
    while IFS= read -r mcp_arg; do
        [[ -n "$mcp_arg" ]] && args+=("$mcp_arg")
    done < <(mcp_compose_files)
    if [[ -n "$extra" ]]; then args+=(-f "$(harness_docker_path "$extra")"); fi
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        HARNESS_HOST_OS="$(harness_detect_os)" \
        harness_docker "${args[@]}" "$@"
}

# The load-bearing gate. Validate a staged snippet against the live graph
# BEFORE it is armed. Two hard checks + one warning:
#   1. Merge check: `config -q` over (full graph + staged) catches bad YAML and
#      graphs that fail to merge — the only failure mode that takes down OTHER
#      services.
#   2. Collision check: every service-name AND container_name the staged
#      snippet declares must be NEW. Compose silently MERGES same-named
#      services (override semantics) and fails `up` on duplicate
#      container_names — neither surfaces from `config -q`, so diff explicitly.
#   3. Warn (don't fail) on duplicate published host ports (they fail only at
#      `up` time).
# Returns 0 if safe to arm, non-zero otherwise (caller discards staging).
# Args: <name> <staged_compose_file>
mcp_validate_staged() {
    local name="$1" staged="$2"

    # 1. Merge check.
    if ! harness_compose_graph "$staged" --profile mcp config -q 2>/tmp/harness-regcheck.$$; then
        err "$name: staged compose does not merge into the harness graph:"
        sed 's/^/         /' /tmp/harness-regcheck.$$ >&2 2>/dev/null || true
        rm -f /tmp/harness-regcheck.$$ 2>/dev/null || true
        return 1
    fi
    rm -f /tmp/harness-regcheck.$$ 2>/dev/null || true

    # The snippet must declare at least one service (an empty/serviceless
    # snippet means config silently produced nothing — fail closed rather than
    # treat "no services" as "no collisions").
    local snippet_services
    snippet_services=$(compose_services_of_file "$staged")
    if [[ -z "$snippet_services" ]]; then
        err "$name: staged compose declares no services (nothing to register, or config failed silently)"
        return 1
    fi

    # A --force re-register over an already-installed+enabled entry sees that
    # entry's OWN services/container_names in the live graph (mcp_compose_files
    # includes it until the swap). Those are precisely the names this register
    # replaces, so exclude them from the collision baselines — otherwise a
    # same-name --force re-register would always self-collide. A fresh register
    # (no existing compose) skips this and behaves as before.
    local self_compose="$mcp_active_dir/$name/compose.yml"
    local self_services="" self_cnames=""
    if [[ -f "$self_compose" ]]; then
        self_services=$(compose_services_of_file "$self_compose")
        self_cnames=$(compose_cnames_of_file "$self_compose")
    fi

    # 2a. Service-name collisions.
    local baseline_services
    baseline_services=$(harness_compose_graph "" --profile mcp config --services 2>/dev/null || true)
    local svc collisions=""
    while IFS= read -r svc; do
        [[ -z "$svc" ]] && continue
        [[ -n "$self_services" ]] && grep -qxF "$svc" <<<"$self_services" && continue
        if grep -qxF "$svc" <<<"$baseline_services"; then
            collisions+=" $svc"
        fi
    done <<<"$snippet_services"
    if [[ -n "$collisions" ]]; then
        err "$name: staged compose redefines service(s) already in the graph:$collisions"
        err "         compose would silently override them; pick distinct service names."
        return 1
    fi

    # 2b. container_name collisions.
    local snippet_cnames baseline_cnames cn cn_collisions=""
    snippet_cnames=$(compose_cnames_of_file "$staged")
    if [[ -n "$snippet_cnames" ]]; then
        baseline_cnames=$(harness_compose_graph "" --profile mcp config --format json 2>/dev/null \
            | harness_jq -r '.services // {} | to_entries[] | .value.container_name // empty' 2>/dev/null || true)
        while IFS= read -r cn; do
            [[ -z "$cn" ]] && continue
            [[ -n "$self_cnames" ]] && grep -qxF "$cn" <<<"$self_cnames" && continue
            if grep -qxF "$cn" <<<"$baseline_cnames"; then
                cn_collisions+=" $cn"
            fi
        done <<<"$snippet_cnames"
        if [[ -n "$cn_collisions" ]]; then
            err "$name: staged compose reuses container_name(s) already in the graph:$cn_collisions"
            err "         'harness start' would fail with 'container name already in use'."
            return 1
        fi
    fi

    # 3. Duplicate published host ports (warn only — fails at up time, not now).
    local merged_ports staged_ports p
    merged_ports=$(harness_compose_graph "" --profile mcp config --format json 2>/dev/null \
        | harness_jq -r '[.services // {} | .[]?.ports // [] | .[]? | .published // empty] | .[]' 2>/dev/null || true)
    staged_ports=$(compose_published_ports_of_file "$staged")
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        if grep -qxF "$p" <<<"$merged_ports"; then
            echo "[harness] warning: $name publishes host port $p, already bound in the graph — 'harness start' may fail at up time." >&2
        fi
    done <<<"$staged_ports"

    return 0
}

# Published host ports a single snippet declares (best-effort; for the
# duplicate-port warning). Empty on any config error.
compose_published_ports_of_file() {
    local compose_file="$1"
    [[ -f "$compose_file" ]] || return 0
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker compose -f "$compose_file" --profile mcp config --format json 2>/dev/null \
        | harness_jq -r '[.services // {} | .[]?.ports // [] | .[]? | .published // empty] | .[]' 2>/dev/null || true
}

# register: land an arbitrary source (a registry-shaped dir, or a git URL) into
# the active tree behind the validation gate. See .planning/proposals/
# mcp-register.md and architecture/mcp.md.
cmd_mcp_register() {
    local name="" from="" ref="" no_enable=0 do_start=0 force=0
    while (( $# > 0 )); do
        case "$1" in
            --from)      shift; from="${1:-}"; [[ -z "$from" ]] && { err "--from requires a value"; exit 1; } ;;
            --from=*)    from="${1#--from=}" ;;
            --ref)       shift; ref="${1:-}"; [[ -z "$ref" ]] && { err "--ref requires a value"; exit 1; } ;;
            --ref=*)     ref="${1#--ref=}" ;;
            --no-enable) no_enable=1 ;;
            --start)     do_start=1 ;;
            --force)     force=1 ;;
            -*)          err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"
                    exit 1
                fi
                ;;
        esac
        shift
    done

    if [[ -z "$from" ]]; then
        err "usage: harness mcp register <name> --from <dir|git-url> [--ref <ref>] [--no-enable] [--start] [--force]"
        exit 1
    fi

    # Resolve name: basename of --from when omitted (strip a trailing .git for
    # git URLs).
    if [[ -z "$name" ]]; then
        name=$(basename "$from")
        name="${name%.git}"
    fi
    if [[ -z "$name" || "$name" == "." || "$name" == ".." || "$name" == *"/"* ]]; then
        err "could not derive a valid MCP name from '$from'; pass an explicit <name>"
        exit 1
    fi

    require_docker

    # Refuse a name that's already installed (compose.yml present) unless
    # --force. A surviving post-uninstall dir (data/ only, no compose.yml) is
    # not "installed" and is allowed through.
    if mcp_is_installed "$name" && (( ! force )); then
        err "$name is already installed (use --force to overwrite; data/ is preserved)"
        exit 1
    fi

    # Shadow warning: a registered entry that later shares a registry name
    # would start being managed by `harness upgrade` (directory_overwrite fires
    # on condition: installed), silently overwriting the registered files.
    if [[ -d "$registry_dir/$name" ]]; then
        echo "[harness] warning: '$name' also names a registry entry ($registry_dir/$name)." >&2
        echo "[harness]          'harness upgrade' would later overwrite this registered copy from the registry." >&2
        echo "[harness]          Consider a distinct name to keep the registered entry independent." >&2
    fi

    local staging="$mcp_active_dir/.staging-$name"
    mkdir -p "$mcp_active_dir"
    # Clear any leftover staging from a prior crashed run (invisible to
    # discovery globs, so it would otherwise accumulate).
    rm -rf "$staging" 2>/dev/null || true

    local enabled_value="true"
    (( no_enable )) && enabled_value="false"

    # Resolve the source into a descriptor dir ($src) that mcp_materialize_src
    # can copy from. Two source kinds:
    local src=""
    if [[ -d "$from" ]]; then
        # Directory source. --ref only applies if the dir's meta declares an
        # upstream repo_clone_url (the clone mcp_materialize_src may run).
        src="$from"
    elif [[ "$from" == *"://"* || "$from" == git@* || "$from" == *.git ]]; then
        # Git-URL source: clone it ONCE (at --ref) into staging/repo, then look
        # for the descriptor files (compose.yml + client-config.json) at the
        # repo root or under harness-mcp/. The clone doubles as the build
        # context, so mcp_materialize_src's clone step is a no-op (repo/.git
        # present).
        mkdir -p "$staging"
        local clone_ref="${ref:-main}"
        echo "[harness] $name: cloning $from ($clone_ref) to $staging/repo..."
        local clone_ok=0
        if [[ "$clone_ref" =~ ^[0-9a-f]{40}$ ]]; then
            if ( set -e
                 mkdir -p "$staging/repo"
                 cd "$staging/repo"
                 git init -q
                 git remote add origin "$from"
                 git fetch --depth=1 origin "$clone_ref"
                 git checkout -q FETCH_HEAD ); then
                clone_ok=1
            fi
        else
            if git clone --depth=1 --branch "$clone_ref" "$from" "$staging/repo"; then
                clone_ok=1
            fi
        fi
        if (( ! clone_ok )); then
            err "$name: clone of $from ($clone_ref) failed"
            rm -rf "$staging" 2>/dev/null || true
            exit 1
        fi
        if [[ -f "$staging/repo/compose.yml" && -f "$staging/repo/client-config.json" ]]; then
            src="$staging/repo"
        elif [[ -f "$staging/repo/harness-mcp/compose.yml" && -f "$staging/repo/harness-mcp/client-config.json" ]]; then
            src="$staging/repo/harness-mcp"
        else
            err "$name: cloned repo has no MCP descriptor (need compose.yml + client-config.json at repo root or harness-mcp/)"
            err "        point --from at a directory containing those files instead."
            rm -rf "$staging" 2>/dev/null || true
            exit 1
        fi
    else
        err "$name: --from '$from' is neither an existing directory nor a git URL"
        exit 1
    fi

    # Enforce the four-file contract's two required files.
    if [[ ! -f "$src/compose.yml" ]]; then
        err "$name: source is missing required compose.yml ($src)"
        rm -rf "$staging" 2>/dev/null || true
        exit 1
    fi
    if [[ ! -f "$src/client-config.json" ]]; then
        err "$name: source is missing required client-config.json ($src)"
        rm -rf "$staging" 2>/dev/null || true
        exit 1
    fi

    # Materialize descriptors into staging (clone any declared upstream;
    # arm the enabled flag). For a git-URL source the repo is already at
    # staging/repo so the clone step is skipped.
    if ! mcp_materialize_src "$name" "$src" "$staging" "$enabled_value" "$ref"; then
        err "$name: materialize failed; nothing registered"
        rm -rf "$staging" 2>/dev/null || true
        exit 1
    fi

    # If the source itself synthesized no meta, materialize created one via the
    # enabled write — record the git-URL provenance so `harness upgrade` and a
    # later re-register can see where this came from.
    if [[ "$from" == *"://"* || "$from" == git@* || "$from" == *.git ]]; then
        local meta="$staging/harness-meta.json"
        if [[ -f "$meta" ]]; then
            local tmp="${meta}.tmp.$$"
            # harness_jq (host jq, else container jq) so provenance is
            # recorded even on a docker-only host. Single file arg → the
            # container path maps it to stdin.
            if harness_jq --arg u "$from" --arg r "${ref:-main}" \
                 '.repo_clone_url = (.repo_clone_url // $u) | .repo_clone_ref = (.repo_clone_ref // $r)' \
                 "$meta" >"$tmp" 2>/dev/null; then
                mv "$tmp" "$meta"
            fi
            rm -f "$tmp" 2>/dev/null || true
        fi
    fi

    # VALIDATE before arming anything in the live tree.
    if ! mcp_validate_staged "$name" "$staging/compose.yml"; then
        rm -rf "$staging" 2>/dev/null || true
        exit 1
    fi

    # Atomically swap staging into place WITHOUT ever moving dest/data: clear
    # the dest's non-data files (force-reinstall), then move staged non-data
    # entries in. data/ stays put through the whole operation, so a crash can
    # never orphan it.
    local dest="$mcp_active_dir/$name"
    mkdir -p "$dest"
    local f base
    for f in "$dest"/*; do
        [[ -e "$f" ]] || continue
        [[ "$(basename "$f")" == "data" ]] && continue
        rm -rf "$f"
    done
    for f in "$staging"/* "$staging"/.[!.]*; do
        [[ -e "$f" ]] || continue
        base=$(basename "$f")
        [[ "$base" == "data" ]] && continue
        rm -rf "${dest:?}/${base:?}"
        mv "$f" "$dest/$base"
    done
    mkdir -p "$dest/data"
    rm -rf "$staging" 2>/dev/null || true

    local state_label="installed-enabled"
    (( no_enable )) && state_label="installed-disabled"
    cat <<EOF
registered: $name (from $from)
state: $state_label
data: $dest/data
services: $(compose_services_of_file "$dest/compose.yml" | paste -sd, - 2>/dev/null)
EOF

    mcp_print_firewall_recs "$dest/harness-meta.json"

    if (( do_start )); then
        if (( no_enable )); then
            echo
            echo "[harness] --start with --no-enable: bringing it up now, but it will NOT auto-start on 'harness start'."
        fi
        echo
        cmd_mcp_up "$name"
    else
        echo
        if (( no_enable )); then
            echo "next: 'harness mcp enable $name' then 'harness start' (or 'harness mcp up $name' to run it now)."
        else
            echo "next: 'harness start' (or 'harness restart' if already up) brings it up; 'harness mcp up $name' runs it now."
        fi
    fi
}

# install: registry -> active tree. Default state is enabled.
#
# B3-MANAGED: mcp-active-tree — <install-root>/state/mcp/<name>/. Created by this
# function from mcp-registry/<name>/. `harness upgrade` runs a per-MCP
# `directory_overwrite` registry action (gated on `condition: installed`)
# that refreshes compose.yml, client-config.json, README.md, etc., while
# preserving harness-meta.json (user enable state) and data/ (indexed
# state). See scripts/upgrade-manifest.json's `registry_actions` block.
cmd_mcp_install() {
    local force=0 name=""
    while (( $# > 0 )); do
        case "$1" in
            --force) force=1 ;;
            -*)      err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"
                    exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        err "usage: harness mcp install <name> [--force]"
        exit 1
    fi

    local src="$registry_dir/$name"
    if [[ ! -d "$src" ]]; then
        err "unknown MCP '$name'; available: $(mcp_registry_names_csv)"
        exit 1
    fi
    if [[ ! -f "$src/compose.yml" ]]; then
        err "registry entry '$name' is missing compose.yml"
        exit 1
    fi

    local dest="$mcp_active_dir/$name"
    # "Already installed" means compose.yml is present. After uninstall the
    # directory may still exist (data/ is preserved), so checking only for
    # the directory would refuse a clean re-install after an uninstall.
    if mcp_is_installed "$name" && (( ! force )); then
        err "$name is already installed (use --force to overwrite)"
        exit 1
    fi

    mkdir -p "$mcp_active_dir"
    if (( force )) && [[ -d "$dest" ]]; then
        # Wipe everything except data/ so persistent state survives a force-
        # reinstall. data is sacred.
        local f
        for f in "$dest"/*; do
            [[ -e "$f" ]] || continue
            if [[ "$(basename "$f")" == "data" ]]; then
                continue
            fi
            rm -rf "$f"
        done
    fi
    # Copy descriptors, clone any declared upstream build context, and arm
    # enabled=true — shared with `register` via mcp_materialize_src so the two
    # commands can't drift. A fresh install is always enabled regardless of
    # what the template said.
    if ! mcp_materialize_src "$name" "$src" "$dest" "true"; then
        err "         install aborted; retry with 'harness mcp install $name --force' once resolved"
        exit 1
    fi

    cat <<EOF
installed: $name (from $src)
state: installed-enabled
data: $dest/data
next:
  run 'harness' to start the stack (or 'harness restart' if it's already up) to bring up the service.
  agents launched after that will see this MCP in their config.
EOF

    mcp_print_firewall_recs "$dest/harness-meta.json"
}

# uninstall: stop containers, remove active tree (preserve data/).
cmd_mcp_uninstall() {
    local force=0 name=""
    while (( $# > 0 )); do
        case "$1" in
            --force) force=1 ;;
            -*)      err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"
                    exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        err "usage: harness mcp uninstall <name> [--force]"
        exit 1
    fi

    local dest="$mcp_active_dir/$name"
    if [[ ! -d "$dest" ]]; then
        err "$name is not installed"
        exit 1
    fi

    if (( ! force )); then
        local ans
        printf 'this will stop and remove the active config for %s. ' "$name" >&2
        printf 'data dir at %s/data will be preserved. continue? [y/n]: ' "$dest" >&2
        if [[ -t 0 ]]; then
            read -r ans </dev/tty
        else
            err "non-interactive shell; pass --force to confirm"
            exit 1
        fi
        case "${ans:-}" in
            y|Y|yes|YES) ;;
            *) echo "aborted." >&2; exit 0 ;;
        esac
    fi

    # Stop and remove the MCP's containers if running. Enumerate services
    # via `compose config --services` (--profile mcp required to see them)
    # and `compose rm -sf` each one through the full project compose so we
    # don't disturb the core services or other MCPs.
    if [[ -f "$dest/compose.yml" ]] && harness_docker info >/dev/null 2>&1; then
        local svc
        while IFS= read -r svc; do
            [[ -z "$svc" ]] && continue
            compose --profile mcp rm -sf "$svc" 2>/dev/null || true
        done < <(mcp_services_of "$name")
    fi

    # A host MCP has no container but may have a supervised process. Stop it
    # before removing the registration dir (which holds its pidfile), or the
    # process would be orphaned with no way to track it down.
    if mcp_is_host "$name"; then
        host_mcp_stop "$name"
    fi

    local f
    for f in "$dest"/* "$dest"/.[!.]*; do
        [[ -e "$f" ]] || continue
        if [[ "$(basename "$f")" == "data" ]]; then
            continue
        fi
        rm -rf "$f"
    done
    if [[ ! -d "$dest/data" ]]; then
        rmdir "$dest" 2>/dev/null || true
    fi

    echo "uninstalled: $name"
    if [[ -d "$dest/data" ]]; then
        echo "data preserved at: $dest/data"
    fi
}

# enable: mark installed MCP as auto-start. Pure state-flag flip.
cmd_mcp_enable() {
    local name=""
    while (( $# > 0 )); do
        case "$1" in
            -*) err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"
                    exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        err "usage: harness mcp enable <name>"
        exit 1
    fi

    if ! mcp_is_installed "$name"; then
        if [[ -d "$registry_dir/$name" ]]; then
            err "$name is in the registry but not installed; use 'harness mcp install $name' first"
        else
            err "unknown MCP '$name'; available: $(mcp_registry_names_csv)"
        fi
        exit 1
    fi

    mcp_set_enabled "$name" "true"
    echo "enabled: $name"
    echo "next: run 'harness' to start the stack (or 'harness restart' if it's already up) to bring it up."
}

# disable: mark installed MCP as do-not-auto-start. Pure state-flag flip.
cmd_mcp_disable() {
    local name=""
    while (( $# > 0 )); do
        case "$1" in
            -*) err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"
                    exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        err "usage: harness mcp disable <name>"
        exit 1
    fi

    if ! mcp_is_installed "$name"; then
        err "$name is not installed"
        exit 1
    fi
    mcp_set_enabled "$name" "false"
    echo "disabled: $name (still installed; data + config preserved)"
    echo "next: 'harness mcp down $name' to stop a running container, or"
    echo "      'harness restart' to apply the change to a running stack."
}

# up: start an installed MCP's containers regardless of enabled flag.
cmd_mcp_up() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        err "usage: harness mcp up <name>"
        exit 1
    fi
    if ! mcp_is_installed "$name"; then
        err "$name is not installed"
        exit 1
    fi
    if mcp_is_host "$name"; then
        # Host MCP: supervise the host process (no container). Idempotent.
        if host_mcp_running "$name"; then
            echo "up: $name (already running, pid $(host_mcp_pid "$name"))"
            return
        fi
        if host_mcp_port_open "$name"; then
            echo "up: $name (port $(host_mcp_port "$name") already served, e.g. by a manual ./run.sh; not starting a second instance)"
            return
        fi
        if ! host_mcp_start "$name"; then
            err "failed to start host MCP $name (see $(host_mcp_logfile "$name"))"
            exit 1
        fi
        echo "up: $name (host process, pid $(host_mcp_pid "$name"); logs: $(host_mcp_logfile "$name"))"
        return
    fi
    require_docker

    local svc_list=()
    local svc
    while IFS= read -r svc; do
        [[ -z "$svc" ]] && continue
        svc_list+=("$svc")
    done < <(mcp_services_of "$name")
    if (( ${#svc_list[@]} == 0 )); then
        err "could not enumerate services in $mcp_active_dir/$name/compose.yml"
        exit 1
    fi

    # Force-add this MCP's compose file to the argv even if it's disabled —
    # `compose` (the wrapper) only adds enabled MCPs through mcp_compose_files.
    # Host paths are run through harness_docker_path for the same reason as
    # in compose() above (Git Bash + MSYS_NO_PATHCONV=1 means we have to
    # convert /c/Users/... to C:/Users/... ourselves before docker sees it).
    write_runtime_override
    local args=(
        compose
        --project-name "$project_name"
        -f "$(harness_docker_path "$clone_dir/docker-compose.yml")"
    )
    if [[ -f "$env_file" ]]; then args+=(--env-file "$(harness_docker_path "$env_file")"); fi
    if [[ -f "$runtime_override" ]]; then args+=(-f "$(harness_docker_path "$runtime_override")"); fi
    # Other enabled MCPs (so their networks/volumes resolve consistently).
    local mcp_arg
    while IFS= read -r mcp_arg; do
        [[ -n "$mcp_arg" ]] && args+=("$mcp_arg")
    done < <(mcp_compose_files)
    # Force this MCP in, even if disabled.
    if ! mcp_is_enabled "$name"; then
        args+=(-f "$(harness_docker_path "$mcp_active_dir/$name/compose.yml")")
    fi
    args+=(--profile mcp up -d)
    args+=("${svc_list[@]}")
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker "${args[@]}"
    echo "up: $name"
}

# down: stop an installed MCP's containers (does not change enabled flag).
cmd_mcp_down() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        err "usage: harness mcp down <name>"
        exit 1
    fi
    if ! mcp_is_installed "$name"; then
        err "$name is not installed"
        exit 1
    fi
    if mcp_is_host "$name"; then
        # Host MCP: stop the supervised host process (no container).
        if ! host_mcp_running "$name"; then
            echo "down: $name (not running)"
            return
        fi
        host_mcp_stop "$name"
        echo "down: $name (host process stopped)"
        return
    fi
    require_docker

    local svc_list=()
    local svc
    while IFS= read -r svc; do
        [[ -z "$svc" ]] && continue
        svc_list+=("$svc")
    done < <(mcp_services_of "$name")
    if (( ${#svc_list[@]} == 0 )); then
        err "could not enumerate services in $mcp_active_dir/$name/compose.yml"
        exit 1
    fi

    # Splice this MCP's compose file in even if disabled, so compose can
    # find the service to remove. Host paths are converted via
    # harness_docker_path for Windows Git Bash (see compose() for why).
    write_runtime_override
    local args=(
        compose
        --project-name "$project_name"
        -f "$(harness_docker_path "$clone_dir/docker-compose.yml")"
    )
    if [[ -f "$env_file" ]]; then args+=(--env-file "$(harness_docker_path "$env_file")"); fi
    if [[ -f "$runtime_override" ]]; then args+=(-f "$(harness_docker_path "$runtime_override")"); fi
    if ! mcp_is_enabled "$name"; then
        args+=(-f "$(harness_docker_path "$mcp_active_dir/$name/compose.yml")")
    fi
    local mcp_arg
    while IFS= read -r mcp_arg; do
        [[ -n "$mcp_arg" ]] && args+=("$mcp_arg")
    done < <(mcp_compose_files)
    args+=(--profile mcp rm -sf)
    args+=("${svc_list[@]}")
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker "${args[@]}" 2>/dev/null || true
    echo "down: $name"
}

# logs: follow log output for one MCP's services.
cmd_mcp_logs() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        err "usage: harness mcp logs <name>"
        exit 1
    fi
    if ! mcp_is_installed "$name"; then
        err "$name is not installed"
        exit 1
    fi
    if mcp_is_host "$name"; then
        # Host MCP: tail the supervised process's logfile. Only meaningful when
        # harness started it (manual `./run.sh` logs to its own terminal).
        local lf
        lf=$(host_mcp_logfile "$name")
        if [[ ! -f "$lf" ]]; then
            err "no supervised log for host MCP $name at $lf"
            err "(harness only captures logs for servers it started via 'harness mcp up'"
            err " or the auto-up on 'harness start'; a manual ./run.sh logs to its terminal)."
            exit 1
        fi
        # exec bypasses the EXIT trap — reap the jq sidecar before it.
        _reap_jq_sidecar
        exec tail -n +1 -f "$lf"
    fi
    require_docker

    local svc_list=()
    local svc
    while IFS= read -r svc; do
        [[ -z "$svc" ]] && continue
        svc_list+=("$svc")
    done < <(mcp_services_of "$name")
    if (( ${#svc_list[@]} == 0 )); then
        err "could not enumerate services in $mcp_active_dir/$name/compose.yml"
        exit 1
    fi

    # Splice this MCP's compose file in even if disabled. Host paths are
    # converted via harness_docker_path for Windows Git Bash (see compose()).
    write_runtime_override
    local args=(
        compose
        --project-name "$project_name"
        -f "$(harness_docker_path "$clone_dir/docker-compose.yml")"
    )
    if [[ -f "$env_file" ]]; then args+=(--env-file "$(harness_docker_path "$env_file")"); fi
    if [[ -f "$runtime_override" ]]; then args+=(-f "$(harness_docker_path "$runtime_override")"); fi
    if ! mcp_is_enabled "$name"; then
        args+=(-f "$(harness_docker_path "$mcp_active_dir/$name/compose.yml")")
    fi
    local mcp_arg
    while IFS= read -r mcp_arg; do
        [[ -n "$mcp_arg" ]] && args+=("$mcp_arg")
    done < <(mcp_compose_files)
    args+=(--profile mcp logs -f)
    args+=("${svc_list[@]}")
    local projects_root="${HARNESS_PROJECTS_ROOT:-$HOME}"
    # exec bypasses the EXIT trap — reap the jq sidecar before it (compose()
    # ran write_runtime_override, which reads the override through harness_jq).
    _reap_jq_sidecar
    INSTALL_ROOT="$install_root" \
        HARNESS_ALLOWLIST_PATH="$allowlist_path" \
        HARNESS_PROJECTS_ROOT="$projects_root" \
        harness_docker_exec "${args[@]}"
}

# status: per-MCP diagnostic. No exit code on warnings; the user is asking
# for info, not running a check.
cmd_mcp_status() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        err "usage: harness mcp status <name>"
        exit 1
    fi
    if ! mcp_is_installed "$name"; then
        printf 'name:      %s\n' "$name"
        printf 'state:     available\n'
        if [[ -d "$registry_dir/$name" ]]; then
            printf 'registry:  %s\n' "$registry_dir/$name"
        else
            printf 'registry:  (not in registry)\n'
        fi
        return
    fi
    local enabled state runtime
    if mcp_is_enabled "$name"; then
        enabled="true"
        state="installed-enabled"
    else
        enabled="false"
        state="installed-disabled"
    fi
    runtime=$(mcp_runtime_status "$name")
    printf 'name:      %s\n' "$name"
    printf 'state:     %s\n' "$state"
    printf 'enabled:   %s\n' "$enabled"
    printf 'runtime:   %s\n' "$runtime"
    printf 'install:   %s\n' "$mcp_active_dir/$name"

    # Host MCPs have no compose snippet and no container — surface the
    # transport, the URL the agent uses, and where the server source lives
    # instead of the (nonexistent) services/data dirs.
    if mcp_is_host "$name"; then
        local url
        url=$(harness_jq -r '(.mcpServers // {}) | to_entries | (.[0].value.url // "")' \
            "$mcp_active_dir/$name/client-config.json" 2>/dev/null || true)
        printf 'transport: host (process on the host; not a container)\n'
        printf 'endpoint:  %s\n' "${url:-(unknown)}"
        printf 'project:   %s\n' "$install_root/host-mcp/$name"
        printf 'launch:    harness mcp up %s (supervised), or ./run.sh in that folder\n' "$name"
        if host_mcp_running "$name"; then
            printf 'process:   running (pid %s, supervised by harness)\n' "$(host_mcp_pid "$name")"
            printf 'logs:      %s  (harness mcp logs %s)\n' "$(host_mcp_logfile "$name")" "$name"
        else
            printf 'process:   stopped\n'
        fi
        return
    fi

    printf 'data:      %s\n' "$mcp_active_dir/$name/data"
    if [[ -f "$registry_dir/$name/compose.yml" ]]; then
        printf 'origin:    registry (%s)\n' "$registry_dir/$name"
    else
        printf 'origin:    custom\n'
    fi
    # Surface the declared services so the user knows what 'mcp logs' will
    # tail and what 'mcp up/down' acts on.
    local svcs
    svcs=$(mcp_services_of "$name" | paste -sd, -)
    printf 'services:  %s\n' "${svcs:-(none)}"
}

# --- host MCP (non-container) -----------------------------------------------
#
# A "host MCP" runs as a plain process ON THE HOST (e.g. a Windows machine with
# Visual Studio) and exposes build/test/run tools the containerized agent calls
# over HTTP at host.docker.internal:<port>/mcp. It is NOT a docker service: it
# has no compose.yml, so `harness start`/`up`/`down`/`logs` never touch it. It
# is registered as a client-config-only entry under state/mcp/<name>/ — the
# agent-config merge keys off client-config.json presence (not compose.yml), so
# the URL is wired into every agent launched after registration.
#
# Validate a host MCP name as a safe directory + service token. Rejects path
# traversal (no '/' or '.'), the reserved template dir, and bad first chars.
_mcp_host_validate_name() {
    local name="$1"
    if ! [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        err "invalid name '$name'; use lowercase letters, digits, '-' and '_' (must start alphanumeric)"
        return 1
    fi
    if [[ "$name" == "template" ]]; then
        err "'template' is reserved (it is the source scaffold under host-mcp/)"
        return 1
    fi
    return 0
}

# host-init: scaffold a host MCP from the in-repo template and register it.
cmd_mcp_host_init() {
    local name="" port="" force=0
    while (( $# > 0 )); do
        case "$1" in
            --port)   shift; port="${1:-}" ;;
            --port=*) port="${1#--port=}" ;;
            --force)  force=1 ;;
            -*)       err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                else
                    err "unexpected extra argument '$1'"; exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        err "usage: harness mcp host-init <name> [--port <port>] [--force]"
        exit 1
    fi
    _mcp_host_validate_name "$name" || exit 1

    local tmpl="$clone_dir/host-mcp/template"
    if [[ ! -d "$tmpl" ]]; then
        err "host MCP template not found at $tmpl"
        exit 1
    fi

    # Default port. The MCP streamable-http default is 8000; pick 9100 to dodge
    # common dev servers, and let --port override.
    port="${port:-9100}"
    if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        err "invalid --port '$port'; must be 1-65535"
        exit 1
    fi

    local inst="$install_root/host-mcp/$name"
    local reg="$mcp_active_dir/$name"

    if mcp_is_installed "$name" && (( ! force )); then
        err "$name is already registered (use --force to overwrite its registration)"
        exit 1
    fi
    if [[ -d "$inst" ]] && (( ! force )); then
        err "instance dir already exists: $inst (use --force to re-scaffold; this overwrites server.py/project.json)"
        exit 1
    fi

    # Scaffold: copy the template, then substitute the name/port placeholders
    # in the files that carry them. sed-to-temp + mv (no -i) for GNU/BSD
    # portability; name+port are validated above, so they're sed-safe.
    mkdir -p "$inst"
    local f
    for f in "$tmpl"/* "$tmpl"/.[!.]*; do
        [[ -e "$f" ]] || continue
        cp -a "$f" "$inst/"
    done
    local base target subst
    for base in server.py project.json; do
        target="$inst/$base"
        [[ -f "$target" ]] || continue
        subst="$target.tmp.$$"
        sed -e "s/__MCP_NAME__/$name/g" -e "s/__MCP_PORT__/$port/g" "$target" >"$subst"
        mv "$subst" "$target"
    done

    # Register a client-config-only entry (no compose.yml ⇒ mcp_is_host). The
    # agent-config merge keys off client-config.json, so this wires the URL
    # into every agent launched after now. Atomic writes (temp + mv).
    mkdir -p "$reg"
    local cc="$reg/client-config.json" meta="$reg/harness-meta.json"
    local cc_tmp="$cc.tmp.$$" meta_tmp="$meta.tmp.$$"
    cat >"$cc_tmp" <<EOF
{
  "mcpServers": {
    "$name": {
      "url": "http://host.docker.internal:$port/mcp"
    }
  }
}
EOF
    mv "$cc_tmp" "$cc"
    # allowed_domains is intentionally empty: a host MCP's reachability is wired
    # automatically (see emit_host_mcp_docker_args + init-firewall.sh 9b). Listing
    # host.docker.internal here would make mcp_print_firewall_recs tell the user
    # to `harness net allow host.docker.internal`, which is both unnecessary and
    # unresolvable by the dig-based allowlist path (it's an /etc/hosts name).
    cat >"$meta_tmp" <<EOF
{
  "enabled": true,
  "transport": "host",
  "host_port": $port,
  "allowed_domains": []
}
EOF
    mv "$meta_tmp" "$meta"

    cat <<EOF
host MCP registered: $name
  endpoint (agent -> host): http://host.docker.internal:$port/mcp
  server source:            $inst
  registration:             $reg

next:
  1. tailor the server with an agent that reads its AGENTS.md:
       harness mcp host-setup $name
  2. start the stack ('harness', or 'harness restart' if already up). harness
     now supervises this server for you: it starts on 'harness start' / first
     agent launch and stops on 'harness down' (or when the last agent exits),
     alongside the container MCPs. Agents launched after step 1 see it in their
     config. cmake/ctest must be on PATH for the build tools to work.

  manual control (all optional — supervision handles the common case):
       harness mcp up $name      # start the supervised process now
       harness mcp logs $name    # tail its captured log
       harness mcp down $name    # stop it
       cd "$inst" && ./run.sh    # run it standalone (logs to this terminal)
     run.sh works on Linux, macOS, and Windows Git Bash — the same Git Bash you
     run harness in.

  Reachability is automatic: while this host MCP is enabled, harness maps
  host.docker.internal into the agent container and allows it through the
  firewall. No 'harness net allow' or --add-host needed.
EOF
}

# host-setup: launch an agent INSIDE the host MCP's instance folder so opencode
# auto-loads its AGENTS.md and helps the user tailor server.py + project.json.
cmd_mcp_host_setup() {
    local name="${1:-}"
    if [[ -z "$name" || "$name" == -* ]]; then
        err "usage: harness mcp host-setup <name> [agent flags...]"
        exit 1
    fi
    shift
    _mcp_host_validate_name "$name" || exit 1

    local inst="$install_root/host-mcp/$name"
    if [[ ! -d "$inst" ]]; then
        err "no host MCP scaffold at $inst"
        err "create one first: harness mcp host-init $name"
        exit 1
    fi
    if [[ ! -f "$inst/AGENTS.md" ]]; then
        err "$inst has no AGENTS.md; re-scaffold with: harness mcp host-init $name --force"
        exit 1
    fi

    # run_agent bind-mounts $PWD and sets it as the workdir; opencode auto-reads
    # AGENTS.md from cwd. cd into the instance folder (same shell process, so
    # the change is visible to run_agent), then launch the agent normally.
    cd "$inst" || { err "cannot enter $inst"; exit 1; }
    echo "launching setup agent in $inst (it will read AGENTS.md)..." >&2
    run_agent opencode "$@"
}

cmd_mcp() {
    local sub="${1:-help}"
    if [[ $# -gt 0 ]]; then shift; fi
    case "$sub" in
        help|-h|--help) cmd_mcp_help ;;
        list)           cmd_mcp_list "$@" ;;
        install)        cmd_mcp_install "$@" ;;
        register)       cmd_mcp_register "$@" ;;
        uninstall)      cmd_mcp_uninstall "$@" ;;
        enable)         cmd_mcp_enable "$@" ;;
        disable)        cmd_mcp_disable "$@" ;;
        up)             cmd_mcp_up "$@" ;;
        down)           cmd_mcp_down "$@" ;;
        logs)           cmd_mcp_logs "$@" ;;
        status)         cmd_mcp_status "$@" ;;
        host-init)      cmd_mcp_host_init "$@" ;;
        host-setup)     cmd_mcp_host_setup "$@" ;;
        *)
            err "unknown mcp subcommand '$sub'"
            cmd_mcp_help >&2
            exit 1
            ;;
    esac
}

# --- net --------------------------------------------------------------------
#
# `harness net` manages the egress allowlist (a flat text file) and the
# per-service firewall override JSON. Subcommands:
#
#   list     show allowlist hosts (annotated pull/push)
#   allow    add a host (with optional --git-push)
#   deny     remove a host
#   edit     open the allowlist in $EDITOR
#   status   summarize allowlist + override state
#   open     mark a service as firewall-disabled (requires confirmation phrase)
#   close    drop firewall-disabled override for a service
#
# All mutators are atomic (temp + mv) and idempotent. After a mutation the
# user is reminded to run `harness restart` to materialize the change in
# running containers.

# Names of services that can be opened/closed. We enumerate via
# `compose --profile mcp config --services` so installed MCP services
# (which carry the `mcp` profile) show up alongside core services.
# `agent` is included even though agents launch ephemerally — opening
# the firewall for the `agent` service propagates onto every subsequent
# `harness <agent>` launch via the runtime override file.
net_known_services() {
    local rt
    rt=$(harness_container_runtime)
    if ! command -v "$rt" >/dev/null 2>&1; then
        printf '%s\n' proxy agent
        return 0
    fi
    local svcs
    svcs=$(compose --profile mcp config --services 2>/dev/null || true)
    if [[ -z "$svcs" ]]; then
        # Compose not configured / fallback to the static core list.
        printf '%s\n' proxy agent
        return 0
    fi
    # Agent is a pseudo-service: agent containers aren't in compose
    # (they're started by direct docker run from run_agent / cmd_shell),
    # but the override file can still record an 'agent'
    # entry. The agent launch path reads it and applies
    # HARNESS_FIREWALL_DISABLED=1.
    printf '%s\n' "$svcs"
    if ! grep -qx 'agent' <<<"$svcs"; then
        printf '%s\n' agent
    fi
}

cmd_net_help() {
    cat <<'EOF'
harness net — manage the egress allowlist and per-service firewall overrides.

usage:
  harness net <subcommand> [args...]

subcommands:
  list                        show every host in the allowlist (pull/push)
  allow <host> [--git-push]   add a host. --git-push annotates it so
                                git push to that host is permitted.
  deny <host>                 remove a host from the allowlist.
  edit                        open the allowlist in $EDITOR.
  status                      summarize allowlist size + active overrides.
  open <service>              fully disable the firewall for one service.
                                Requires the typed phrase
                                'I understand the risks' on a TTY prompt.
  close <service>             drop the firewall-disabled override for
                                <service>. Restores the universal firewall.

services that accept open/close:
  proxy, agent, plus any installed MCP service.

After any mutation, run `harness restart` to apply the change to running
containers. Both `net open/close` and `net allow/deny` take effect on the
next start of affected containers.
EOF
}

# Resolve the editor for `net edit`, in priority order. Falls back to vi.
net_pick_editor() {
    if [[ -n "${VISUAL:-}" ]]; then
        printf '%s' "$VISUAL"
    elif [[ -n "${EDITOR:-}" ]]; then
        printf '%s' "$EDITOR"
    else
        printf 'vi'
    fi
}

cmd_net_list() {
    load_net_helpers
    if [[ ! -f "$allowlist_path" ]]; then
        err "$allowlist_path does not exist; run install.sh or copy .harness-allowlist.example"
        exit 1
    fi
    local count
    count=$(netlib_list_hosts | wc -l | tr -d ' ')
    cat <<EOF
Allowlist (${count} entries):

Note: git domains allow pull only by default. To enable git push for a
host, add it with the '--git-push' flag (or annotate the line with
'# git-push' when editing manually). Use 'harness net allow <host> --git-push'.

EOF
    # Format: hostname [+ '[git-push]' if annotated] [+ inline comment if any].
    # Read the allowlist directly so we can preserve inline comments that
    # netlib_list_hosts strips.
    awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            line = $0
            push = 0
            comment = ""
            # Extract any trailing comment.
            if (match(line, /[[:space:]]*#.*$/)) {
                comment = substr(line, RSTART, RLENGTH)
                line = substr(line, 1, RSTART - 1)
            }
            # If the comment is exactly the git-push annotation, recognize it.
            if (comment ~ /^[[:space:]]*#[[:space:]]*git-push[[:space:]]*$/) {
                push = 1
                comment = ""
            } else if (comment ~ /^[[:space:]]*#[[:space:]]*git-push[[:space:]]+/) {
                push = 1
                # Strip the git-push token, keep any further note.
                sub(/^[[:space:]]*#[[:space:]]*git-push[[:space:]]+/, "  # ", comment)
            }
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (length(line) == 0) next

            host = line
            tag = push ? "  [git-push]" : ""
            note = ""
            if (length(comment) > 0) {
                # Normalize whitespace before the comment.
                gsub(/^[[:space:]]+/, " ", comment)
                note = comment
            }
            printf "  %-30s%s%s\n", host, tag, note
        }
    ' "$allowlist_path"
}

cmd_net_allow() {
    load_net_helpers
    local host="" git_push=0
    while (( $# > 0 )); do
        case "$1" in
            --git-push) git_push=1 ;;
            -*) err "unknown flag '$1'"; exit 1 ;;
            *)
                if [[ -z "$host" ]]; then host="$1"
                else err "unexpected extra argument '$1'"; exit 1
                fi
                ;;
        esac
        shift
    done
    if [[ -z "$host" ]]; then
        err "usage: harness net allow <host> [--git-push]"
        exit 1
    fi
    local normalized
    if ! normalized=$(netlib_validate_host "$host"); then
        err "invalid host '$host' (allowed: lowercase letters, digits, '.', '-')"
        exit 1
    fi
    if netlib_has_host "$normalized"; then
        # Already present — only act if we need to upgrade pull -> push.
        local mode
        mode=$(netlib_list_hosts | awk -v h="$normalized" -F '\t' '$1 == h { print $2; exit }')
        if (( git_push )) && [[ "$mode" == "pull" ]]; then
            netlib_add_host "$normalized" "1"
            echo "upgraded $normalized to allow git push"
        else
            echo "$normalized already on allowlist (mode: $mode)"
        fi
    else
        netlib_add_host "$normalized" "$git_push"
        if (( git_push )); then
            echo "added $normalized (git push allowed)"
        else
            echo "added $normalized"
        fi
    fi
    echo "next: 'harness restart' to apply to running containers"
}

cmd_net_deny() {
    load_net_helpers
    local host="${1:-}"
    if [[ -z "$host" ]]; then
        err "usage: harness net deny <host>"
        exit 1
    fi
    local normalized
    if ! normalized=$(netlib_validate_host "$host"); then
        err "invalid host '$host'"
        exit 1
    fi
    if ! netlib_has_host "$normalized"; then
        err "$normalized is not on the allowlist"
        exit 1
    fi
    netlib_remove_host "$normalized"
    echo "removed $normalized"
    echo "next: 'harness restart' to apply to running containers"
}

cmd_net_edit() {
    if [[ ! -f "$allowlist_path" ]]; then
        err "$allowlist_path does not exist; run install.sh or copy .harness-allowlist.example"
        exit 1
    fi
    local editor
    editor=$(net_pick_editor)
    "$editor" "$allowlist_path"
    echo "next: 'harness restart' to apply changes"
}

cmd_net_status() {
    load_net_helpers
    printf 'allowlist:\n'
    if [[ -f "$allowlist_path" ]]; then
        local total push_count
        total=$(netlib_list_hosts | wc -l | tr -d ' ')
        push_count=$(netlib_list_pushable | wc -l | tr -d ' ')
        printf '  path:        %s\n' "$allowlist_path"
        printf '  hosts:       %s (%s pull-only, %s push-enabled)\n' \
            "$total" "$((total - push_count))" "$push_count"
    else
        printf '  path:        %s (missing)\n' "$allowlist_path"
    fi
    printf '\noverrides:\n'
    printf '  path:        %s\n' "$net_overrides_path"
    if [[ -f "$net_overrides_path" ]]; then
        local open_list
        open_list=$(netlib_overrides_open_services | paste -sd ',' -)
        if [[ -z "$open_list" ]]; then
            printf '  open:        (none)\n'
        else
            printf '  open:        %s\n' "$open_list"
            printf '  WARNING:     these services have unrestricted egress.\n'
        fi
    else
        printf '  open:        (none — no overrides file)\n'
    fi
}

# Confirm by typed phrase. Reads from /dev/tty so confirmation is impossible
# to slip past in scripts. The phrase MUST match exactly (case-sensitive,
# no extra whitespace beyond the readline-stripped trailing newline).
net_confirm_phrase() {
    local expected="$1"
    if [[ ! -t 0 || ! -t 1 ]]; then
        # On a non-TTY stdin/stdout we still need /dev/tty to actually exist,
        # otherwise we can't ask the user. Refuse rather than blindly proceed.
        if [[ ! -e /dev/tty ]]; then
            err "non-interactive shell without /dev/tty; refusing to disable firewall"
            exit 1
        fi
    fi
    printf 'To confirm, type the following phrase exactly:\n' >&2
    printf '  %s\n' "$expected" >&2
    printf '> ' >&2
    local typed=""
    if ! IFS= read -r typed </dev/tty; then
        err "no input received"
        exit 1
    fi
    if [[ "$typed" != "$expected" ]]; then
        err "phrase did not match — aborting"
        exit 1
    fi
}

cmd_net_open() {
    load_net_helpers
    local svc="${1:-}"; shift || true
    local reason="${1:-}"
    if [[ -z "$svc" ]]; then
        err "usage: harness net open <service> [reason]"
        err "       services: $(net_known_services | paste -sd, -)"
        exit 1
    fi
    # Capture the service list once, then match against it with a here-string
    # rather than a `net_known_services | grep -q` pipe. Under `set -o pipefail`
    # the pipe is a trap: grep -q exits on the first match and SIGPIPEs the
    # still-writing producer (net_known_services shells out to a slow
    # `docker compose config`), so the producer dies 141 and pipefail reports
    # the whole pipeline as failed — turning a real match into a false
    # "unknown service" for any service that isn't the last line emitted.
    local known_services
    known_services=$(net_known_services)
    if ! grep -qx -- "$svc" <<<"$known_services"; then
        err "unknown service '$svc' (services: $(paste -sd, - <<<"$known_services"))"
        exit 1
    fi
    if netlib_overrides_is_open "$svc"; then
        echo "$svc already firewall-disabled"
        return 0
    fi

    cat >&2 <<EOF
This will disable the egress firewall for the '$svc' service entirely.
Once applied, that container will have unrestricted outbound network and
can talk to any host on the internet.

Use this only if you have an explicit reason that the universal allowlist
cannot cover (e.g. an upstream API on a CDN with rotating IPs). Prefer
'harness net allow <host>' wherever possible.

EOF
    net_confirm_phrase "I understand the risks"
    netlib_overrides_open "$svc" "$reason"
    echo "opened: $svc (firewall disabled)"
    echo "next: 'harness restart' to apply (the next start of '$svc' picks it up)"
}

cmd_net_close() {
    load_net_helpers
    local svc="${1:-}"
    if [[ -z "$svc" ]]; then
        err "usage: harness net close <service>"
        exit 1
    fi
    if [[ ! -f "$net_overrides_path" ]] || ! netlib_overrides_is_open "$svc"; then
        echo "$svc has no firewall-disabled override (nothing to close)"
        return 0
    fi
    netlib_overrides_close "$svc"
    echo "closed: $svc (firewall re-enabled)"
    echo "next: 'harness restart' to apply"
}

cmd_net() {
    local sub="${1:-help}"
    if [[ $# -gt 0 ]]; then shift; fi
    case "$sub" in
        help|-h|--help) cmd_net_help ;;
        list)           cmd_net_list   "$@" ;;
        allow)          cmd_net_allow  "$@" ;;
        deny)           cmd_net_deny   "$@" ;;
        edit)           cmd_net_edit   "$@" ;;
        status)         cmd_net_status "$@" ;;
        open)           cmd_net_open   "$@" ;;
        close)          cmd_net_close  "$@" ;;
        *)
            err "unknown net subcommand '$sub'"
            cmd_net_help >&2
            exit 1
            ;;
    esac
}

# --- doctor -----------------------------------------------------------------
#
# Read-only runtime diagnostics. Each section runs a fixed set of checks;
# every check prints one line: <symbol> <name> <detail>. A summary footer
# reports counts. Exit 0 if zero errors, 1 otherwise. Warnings don't fail.
#
# Implementation notes:
#   - Each check is wrapped to never abort doctor (e.g. via `|| true`).
#   - Runtime probes that exec into containers are bounded with `timeout 3`
#     so a slow / hung container can't stall the whole report.
#   - Output is plain text + one ANSI color per status. No box-drawing.

declare -i doctor_errors=0
declare -i doctor_warnings=0

doctor_section() {
    printf '\n[%s]\n' "$1"
}

doctor_check() {
    local status="$1" name="$2" detail="${3:-}"
    local symbol color
    case "$status" in
        ok)   symbol='✓'; color='\033[0;32m' ;;
        fail) symbol='✗'; color='\033[0;31m'; doctor_errors=$((doctor_errors+1)) ;;
        warn) symbol='⚠'; color='\033[0;33m'; doctor_warnings=$((doctor_warnings+1)) ;;
        skip) symbol='–'; color='\033[0;90m' ;;
        *)    symbol='?'; color='' ;;
    esac
    printf '  %b%s%b %-22s %s\n' "$color" "$symbol" '\033[0m' "$name" "$detail"
}

# Redact a secret to "abcd...wxyz" (first 4 + last 4) when long enough,
# else "***". For empty or short values returns "***".
doctor_redact() {
    local v="${1:-}"
    if [[ -z "$v" ]]; then
        printf '***'
        return
    fi
    if (( ${#v} >= 12 )); then
        printf '%s...%s' "${v:0:4}" "${v: -4}"
    else
        printf '***'
    fi
}

# Fetch the Health.Status string from a compose service (empty string if
# the service or container can't be inspected). Never aborts on failure.
doctor_health_of() {
    local svc="$1"
    local cid
    cid=$(compose ps -q "$svc" 2>/dev/null || true)
    if [[ -z "$cid" ]]; then
        printf 'absent'
        return
    fi
    harness_docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || printf 'unknown'
}

cmd_doctor() {
    doctor_errors=0
    doctor_warnings=0

    # On a host-only box (no container runtime installed at all), 'harness host'
    # is the intended path — so the missing daemon is expected, not a fault.
    # Downgrade the container checks to warnings in that case so 'harness doctor'
    # returns 0 on a correctly set-up host-only install instead of reporting
    # spurious hard failures.
    local host_only=0
    harness_runtime_installed || host_only=1

    # ---------------- [deps] ----------------
    doctor_section deps
    local rt
    rt=$(harness_container_runtime)
    if harness_docker info >/dev/null 2>&1; then
        doctor_check ok "$rt runtime" "reachable"
    elif (( host_only )); then
        doctor_check warn "$rt runtime" "not installed (host-only box; use 'harness host')"
    else
        doctor_check fail "$rt runtime" "not reachable; is it running?"
    fi

    if harness_docker compose version >/dev/null 2>&1; then
        local v
        v=$(harness_docker compose version 2>/dev/null | head -1)
        doctor_check ok "$rt compose" "${v}"
    elif (( host_only )); then
        doctor_check warn "$rt compose" "n/a (host-only box, no container runtime)"
    else
        doctor_check fail "$rt compose" "compose subcommand not available"
    fi

    if command -v git >/dev/null 2>&1; then
        local gv
        gv=$(git --version 2>/dev/null | head -1)
        doctor_check ok "git" "${gv}"
    else
        doctor_check fail "git" "not found on PATH"
    fi

    # ---------------- [install] -------------
    doctor_section install
    doctor_check ok "install root" "$install_root"

    if [[ -d "$clone_dir/.git" ]]; then
        local commit branch dirty_count detail
        commit=$(git -C "$clone_dir" describe --always 2>/dev/null || echo "?")
        branch=$(git -C "$clone_dir" branch --show-current 2>/dev/null || echo "?")
        dirty_count=$(git -C "$clone_dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$dirty_count" == "0" ]]; then
            detail="${commit} on ${branch} (clean)"
        else
            detail="${commit} on ${branch} (${dirty_count} dirty)"
        fi
        doctor_check ok "clone" "$detail"
    else
        doctor_check fail "clone" "$clone_dir is not a git repo"
    fi

    local local_bin="$HOME/.local/bin/harness"
    if [[ -x "$local_bin" ]]; then
        # The wrapper is a small shell script (a real symlink isn't always
        # creatable on Windows without Developer Mode). Match against the
        # install root by extracting the exec target from the wrapper.
        local target
        target=$(grep -oE 'exec "[^"]+/harness"' "$local_bin" 2>/dev/null \
            | head -1 | sed -E 's/exec "(.*)"/\1/')
        if [[ -n "$target" && "$target" == "$real_self" ]]; then
            doctor_check ok "harness wrapper" "$local_bin -> $real_self"
        else
            doctor_check warn "harness wrapper" "$local_bin (target ${target:-unknown})"
        fi
    else
        doctor_check warn "harness wrapper" "$local_bin missing; reinstall to add"
    fi

    case ":$PATH:" in
        *":$HOME/.local/bin:"*)
            doctor_check ok "PATH" "\$HOME/.local/bin present"
            ;;
        *)
            doctor_check warn "PATH" "\$HOME/.local/bin not in PATH"
            ;;
    esac

    # ---------------- [config] --------------
    doctor_section config
    if [[ ! -f "$env_file" ]]; then
        doctor_check fail ".env" "$env_file missing"
    elif [[ ! -r "$env_file" ]]; then
        doctor_check fail ".env" "$env_file not readable"
    else
        doctor_check ok ".env" "$env_file"

        if [[ -n "${PROXY_API_URL:-}" ]]; then
            doctor_check ok "PROXY_API_URL" "$PROXY_API_URL"
        else
            doctor_check fail "PROXY_API_URL" "unset"
        fi

        if [[ -n "${PROXY_API_KEY:-}" ]]; then
            doctor_check ok "PROXY_API_KEY" "$(doctor_redact "$PROXY_API_KEY")"
        else
            doctor_check fail "PROXY_API_KEY" "unset"
        fi

        if [[ -n "${agent_model}" ]]; then
            doctor_check ok "DEFAULT_MODEL_NAME" "$agent_model"
        else
            doctor_check fail "DEFAULT_MODEL_NAME" "unset"
        fi
    fi

    # ---------------- [network] -------------
    doctor_section network
    if [[ -f "$allowlist_path" ]]; then
        load_net_helpers
        local total push_count
        total=$(netlib_list_hosts | wc -l | tr -d ' ')
        push_count=$(netlib_list_pushable | wc -l | tr -d ' ')
        doctor_check ok "allowlist" "$allowlist_path ($total hosts, $push_count push-enabled)"

        # Cross-check PROXY_API_URL hostname against the allowlist — this is
        # the single most common misconfiguration (entry missing or typo'd)
        # and the firewall guardrail will refuse to start the proxy without
        # it. Surfacing it here gives the user a fast diagnosis.
        if [[ -n "${PROXY_API_URL:-}" ]]; then
            local proxy_host
            proxy_host=$(printf '%s' "$PROXY_API_URL" | awk -F'[/:]' '{print $4}')
            if [[ -n "$proxy_host" && "$proxy_host" == *.* ]]; then
                if netlib_has_host "$proxy_host"; then
                    doctor_check ok "PROXY_API_URL host" "$proxy_host on allowlist"
                else
                    doctor_check fail "PROXY_API_URL host" \
                        "$proxy_host NOT on allowlist (proxy will refuse to start)"
                fi
            fi
        fi
    elif (( host_only )); then
        doctor_check ok "allowlist" "n/a (host-only; host mode has no egress firewall)"
    else
        doctor_check fail "allowlist" "$allowlist_path missing"
    fi

    if [[ -f "$net_overrides_path" ]]; then
        load_net_helpers
        local open_list
        open_list=$(netlib_overrides_open_services | paste -sd ',' -)
        if [[ -z "$open_list" ]]; then
            doctor_check ok "overrides" "$net_overrides_path (no open services)"
        else
            doctor_check warn "overrides" "$open_list firewall-disabled — unrestricted egress"
        fi
    else
        doctor_check ok "overrides" "no per-service overrides"
    fi

    # ---------------- [storage] -------------
    doctor_section storage
    local d
    for d in output agent/home; do
        local path="$state_root/$d"
        if [[ -d "$path" && -w "$path" ]]; then
            doctor_check ok "state/$d" "writable"
        elif [[ -d "$path" ]]; then
            doctor_check fail "state/$d" "exists but not writable"
        else
            doctor_check fail "state/$d" "missing ($path)"
        fi
    done
    # mcp/ is only required if any MCPs have been enabled. If the dir
    # exists but is empty, that's fine — it's auto-created by ensure_dirs.
    if [[ -d "$mcp_active_dir" ]]; then
        if any_mcp_active; then
            if [[ -w "$mcp_active_dir" ]]; then
                doctor_check ok "mcp" "writable; $(list_active_entries | wc -l | tr -d ' ') entries"
            else
                doctor_check fail "mcp" "exists but not writable ($mcp_active_dir)"
            fi
        else
            doctor_check ok "mcp" "no entries enabled"
        fi
    else
        doctor_check ok "mcp" "no entries enabled"
    fi

    # ---------------- [runtime] -------------
    doctor_section runtime
    local network="${project_name}_harness-net"
    local network_ok=0
    if harness_docker network inspect "$network" >/dev/null 2>&1; then
        doctor_check ok "network" "$network"
        network_ok=1
    else
        doctor_check warn "network" "$network not present (services not running)"
    fi

    if (( network_ok )); then
        local proxy_status
        proxy_status=$(doctor_health_of proxy)

        # The proxy's compose healthcheck curls http://127.0.0.1/health, so a
        # "healthy" status here doubles as the proxy /health liveness probe.
        case "$proxy_status" in
            healthy)        doctor_check ok   "proxy" "healthy" ;;
            absent)         doctor_check warn "proxy" "no container for project ($project_name)" ;;
            none)           doctor_check warn "proxy" "running but no healthcheck reported" ;;
            *)              doctor_check warn "proxy" "$proxy_status" ;;
        esac
    else
        doctor_check skip "proxy" "services not running"
    fi

    # Windows-only: interactive launches (opencode/shell) need docker.exe to
    # accept `-t` from the current terminal. bash's `[[ -t 0 ]]` and docker's
    # isTerminal() disagree under MinTTY (issue #82), so report what actually
    # works in this terminal instead of guessing. The probe is a throwaway
    # `--rm` container — read-only with respect to harness state.
    if [[ "$(harness_detect_os)" == "windows" ]]; then
        local tty_img
        tty_img=$(agent_image)
        if ! harness_docker image inspect "$tty_img" >/dev/null 2>&1; then
            doctor_check skip "interactive tty" "agent image not built yet"
        elif [[ ! -t 0 ]]; then
            doctor_check skip "interactive tty" "stdin not a terminal here"
        elif harness_runtime_tty_ok "$tty_img"; then
            doctor_check ok "interactive tty" "docker accepts -t in this terminal"
        elif [[ -z "${HARNESS_NO_WINPTY:-}" ]] && harness_winpty_available; then
            doctor_check warn "interactive tty" "docker rejects -t here; harness will use winpty"
        else
            doctor_check warn "interactive tty" "docker rejects -t and winpty missing; use Windows Terminal or install winpty"
        fi

        # Issue #112: surface the resolved container working-dir for $PWD so
        # a future "working directory is invalid" failure is one-line
        # diagnosable. Print both the bind-mount target (`mount_path`) and
        # the `//`-escaped form actually passed to docker -w.
        local dx_mp dx_w
        if dx_mp=$(harness_abs_path "$PWD" 2>/dev/null) && [[ -n "$dx_mp" ]]; then
            dx_w=$(harness_container_workdir "$dx_mp")
            doctor_check ok "container workdir" "$dx_mp (docker -w $dx_w)"
            # Issue #112 (third failure mode): show the CWD bind-mount arg
            # docker actually receives. On Windows this must be the single
            # `--mount=type=bind,...` token, not `-v src:tgt` (which MSYS /
            # winpty path-list-convert into `invalid mode: …`).
            local dx_src dx_bind=()
            dx_src=$(harness_docker_path "$dx_mp")
            harness_add_bind_mount dx_bind "$dx_src" "$dx_mp"
            doctor_check ok "container bind mount" "${dx_bind[*]}"
        else
            doctor_check warn "container workdir" "could not resolve \$PWD ($PWD)"
        fi
    fi

    # ---------------- [images] --------------
    doctor_section images
    local img
    for img in \
        "harness-proxy:latest" \
        "harness-agent:latest"
    do
        if harness_docker image inspect "$img" >/dev/null 2>&1; then
            doctor_check ok "$(printf '%s' "$img" | cut -d: -f1)" "$img present"
        else
            doctor_check warn "$(printf '%s' "$img" | cut -d: -f1)" "$img missing — run 'harness' to build"
        fi
    done

    # ---------------- [mcp] -----------------
    #
    # Emitted whenever any MCP is installed (even if all are disabled), so
    # the user can see at a glance which MCPs are around and what state
    # they're in. For each entry we surface enabled/disabled and runtime
    # status. A misbehaving MCP warns rather than fails (the harness is
    # still usable without that MCP).
    local any_installed=0 entry_dir
    if [[ -d "$mcp_active_dir" ]]; then
        for entry_dir in "$mcp_active_dir"/*/; do
            [[ -f "$entry_dir/compose.yml" ]] || continue
            any_installed=1
            break
        done
    fi
    if (( any_installed )); then
        doctor_section mcp
        local name status detail
        while IFS= read -r entry_dir; do
            [[ -n "$entry_dir" ]] || continue
            name=$(basename "$entry_dir")
            if mcp_is_enabled "$name"; then
                status=$(mcp_runtime_status "$name")
                detail="enabled; ${status}"
                case "$status" in
                    *"(healthy)"|"running") doctor_check ok   "$name" "$detail" ;;
                    stopped)                doctor_check warn "$name" "$detail" ;;
                    *)                      doctor_check warn "$name" "$detail" ;;
                esac
            else
                doctor_check ok "$name" "disabled (installed)"
            fi
        done < <(list_active_entries)
    fi

    # ---------------- [agents] --------------
    doctor_section agents
    local running
    running=$(harness_docker ps --filter "label=harness.agent=true" --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' ')
    doctor_check ok "running" "${running} agent container(s)"

    # ---------------- [host] ----------------
    # Containerless mode (harness host). Surface its prerequisites and proxy
    # state when this looks like a host-mode box — no runtime, or a host proxy /
    # venv already present — so 'harness doctor' is actually useful on a
    # host-only install instead of only reporting container facts. Deps are
    # warn-not-fail: they don't gate a container install, and a host-only box
    # that's missing one still wants a 0 exit with a visible nudge.
    local host_venv
    host_venv=$(host_venv_dir)
    if (( host_only )) || host_proxy_running || [[ -d "$host_venv" ]]; then
        doctor_section host
        # python3 is the one dep the user must supply; on Windows (Git Bash) it
        # may be 'python' or 'py -3', so resolve it rather than probing python3.
        local pybin
        if pybin=$(host_python_bin 2>/dev/null); then
            doctor_check ok "python3" "$pybin"
        else
            doctor_check warn "python3" "no Python 3 (python3/python/py) on PATH (needed for 'harness host')"
        fi
        # jq / node / opencode are auto-provisioned on first run, so a miss here
        # is informational, not a hard requirement.
        local dep
        for dep in jq node opencode; do
            if command -v "$dep" >/dev/null 2>&1; then
                doctor_check ok "$dep" "$(command -v "$dep")"
            else
                doctor_check warn "$dep" "not on PATH (auto-provisioned on first 'harness host')"
            fi
        done
        if command -v node >/dev/null 2>&1; then
            local nmaj
            nmaj=$(node --version 2>/dev/null | sed -E 's/^v?([0-9]+).*/\1/')
            if [[ -n "$nmaj" ]] && (( nmaj >= 20 )); then
                doctor_check ok "node version" "$(node --version 2>/dev/null)"
            else
                doctor_check warn "node version" "$(node --version 2>/dev/null) (host mode needs >= 20)"
            fi
        fi
        if [[ -x "$(host_venv_python)" ]]; then
            doctor_check ok "host venv" "$host_venv"
        else
            doctor_check ok "host venv" "not built yet (created on first 'harness host')"
        fi
        if host_proxy_running; then
            doctor_check ok "host proxy" "running (pid $(host_proxy_pid), 127.0.0.1:$(host_proxy_port))"
            doctor_check ok "host proxy log" "$(host_proxy_logfile)"
        else
            doctor_check ok "host proxy" "not running"
        fi
    fi

    # ---------------- summary ---------------
    printf '\n%d errors, %d warnings\n' "$doctor_errors" "$doctor_warnings"
    if (( doctor_errors > 0 )); then
        return 1
    fi
    return 0
}

# --- preflight --------------------------------------------------------------
#
# Validate the install root before `harness start` would otherwise fail
# midway with cryptic errors. Reports each check with ✓/✗/⚠ on stderr,
# returns non-zero if any required check failed. Doctor is the diagnostic
# for a *running* stack; preflight is for the static state on disk plus
# the docker daemon.

cmd_preflight() {
    local errors=0
    echo "[harness] preflight..."

    # Host-only box (no container runtime installed): validate the host-mode
    # prerequisites instead of the container daemon + firewall allowlist, which
    # don't apply to 'harness host'. Detect it up front so each check branches.
    local host_only=0
    harness_runtime_installed || host_only=1

    # Container runtime (docker/podman) with auto-start attempt on Win/Mac
    # via platform.sh
    local rt
    if declare -f harness_container_runtime >/dev/null 2>&1; then
        rt=$(harness_container_runtime)
    else
        rt="docker"
    fi
    if (( host_only )); then
        echo "  ⓘ no container runtime installed — validating host mode ('harness host')"
    elif declare -f harness_docker_running >/dev/null 2>&1 && harness_docker_running; then
        echo "  ✓ $rt runtime"
    elif declare -f harness_docker_running >/dev/null 2>&1; then
        echo "  - $rt runtime not reachable; attempting auto-start..."
        if harness_start_docker_desktop; then
            echo "  ✓ $rt runtime (started)"
        else
            echo "  ✗ $rt runtime not available"
            errors=$((errors+1))
        fi
    else
        if docker info >/dev/null 2>&1 || podman info >/dev/null 2>&1; then
            echo "  ✓ container runtime"
        else
            echo "  ✗ container runtime not running"
            errors=$((errors+1))
        fi
    fi

    # Host-mode prerequisites (only checked on a host-only box). Container mode
    # gets these from inside the image, so they're irrelevant there.
    if (( host_only )); then
        local hdep
        for hdep in python3 jq node opencode; do
            if command -v "$hdep" >/dev/null 2>&1; then
                echo "  ✓ $hdep"
            else
                echo "  ✗ $hdep not found (required for 'harness host')"
                errors=$((errors+1))
            fi
        done
        if command -v node >/dev/null 2>&1; then
            local pnmaj
            pnmaj=$(node --version 2>/dev/null | sed -E 's/^v?([0-9]+).*/\1/')
            if [[ -z "$pnmaj" ]] || (( pnmaj < 20 )); then
                echo "  ✗ node $(node --version 2>/dev/null) is too old (host mode needs >= 20)"
                errors=$((errors+1))
            fi
        fi
    fi

    # Configuration files. .env is required for both modes; the firewall
    # allowlist only governs container mode, so skip it on a host-only box.
    if declare -f harness_check_file_exists >/dev/null 2>&1; then
        harness_check_file_exists "$env_file" true ".env config file" || errors=$((errors+1))
        if (( ! host_only )); then
            harness_check_file_exists "$allowlist_path" true "firewall allowlist" || errors=$((errors+1))
        fi
    else
        [[ -f "$env_file" ]] || { echo "  ✗ .env not found at $env_file"; errors=$((errors+1)); }
        if (( ! host_only )); then
            [[ -f "$allowlist_path" ]] || { echo "  ✗ allowlist not found at $allowlist_path"; errors=$((errors+1)); }
        fi
    fi

    # Required env vars (parsed from .env, not the live shell — env vars
    # are only sourced if the file exists, but this also works as a sanity
    # check when the file is malformed and source would silently no-op).
    if [[ -f "$env_file" ]]; then
        local proxy_url proxy_key proxy_model
        proxy_url=$(grep -E '^PROXY_API_URL=' "$env_file" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
        proxy_key=$(grep -E '^PROXY_API_KEY=' "$env_file" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
        proxy_model=$(grep -E '^DEFAULT_MODEL_NAME=' "$env_file" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")

        if [[ -z "$proxy_url" ]]; then
            echo "  ✗ PROXY_API_URL is empty in $env_file (required: upstream API base URL)"
            errors=$((errors+1))
        else
            echo "  ✓ PROXY_API_URL is set"
        fi
        if [[ -z "$proxy_key" ]]; then
            echo "  ✗ PROXY_API_KEY is empty in $env_file (required: upstream API bearer token)"
            errors=$((errors+1))
        else
            echo "  ✓ PROXY_API_KEY is set"
        fi
        if [[ -z "$proxy_model" ]]; then
            echo "  ✗ DEFAULT_MODEL_NAME is empty in $env_file (required: default/fallback upstream model id)"
            errors=$((errors+1))
        else
            echo "  ✓ DEFAULT_MODEL_NAME is set"
        fi

        # PROXY_API_URL hostname must be in the allowlist or container egress
        # will be blocked by the firewall. Host mode has no firewall, so this
        # cross-check is container-only.
        if (( ! host_only )) && [[ -n "$proxy_url" && -f "$allowlist_path" ]]; then
            local proxy_host
            proxy_host=$(echo "$proxy_url" | awk -F[/:] '{print $4}')
            if [[ -n "$proxy_host" ]]; then
                if ! grep -qE "^[[:space:]]*${proxy_host}([[:space:]]|#|\$)" "$allowlist_path"; then
                    echo "  ✗ PROXY_API_URL hostname '$proxy_host' is NOT in $allowlist_path"
                    echo "    Add it with:  harness net allow $proxy_host"
                    errors=$((errors+1))
                else
                    echo "  ✓ PROXY_API_URL hostname is in allowlist"
                fi
            fi
        fi
    fi

    # State dirs (optional — created on demand by ensure_dirs)
    if declare -f harness_check_dir_writable >/dev/null 2>&1; then
        harness_check_dir_writable "$state_root/output" false "output dir" || true
        harness_check_dir_writable "$state_root/agent/home" false "agent home" || true
    fi

    # Compose project + service status — informational; doesn't gate exit.
    # Wrapped in an explicit subshell that swallows pipefail because
    # `docker compose ps <service>` errors if the project has no compose
    # file context (e.g., running preflight against a never-started
    # install).
    if harness_docker info >/dev/null 2>&1; then
        local proxy_status=""
        proxy_status=$( { harness_docker compose --project-name "$project_name" ps proxy --format '{{.Status}}' 2>/dev/null || true; } | head -1 )
        if [[ -n "$proxy_status" ]]; then
            echo "  ⓘ proxy: $proxy_status"
        else
            echo "  ⓘ proxy: not running (run 'harness' to start it)"
        fi
    fi

    if (( errors > 0 )); then
        echo
        echo "[harness] preflight: $errors error(s). Resolve issues above before running harness."
        return 1
    fi

    echo "[harness] preflight: all checks passed"
    return 0
}

# --- harness test -----------------------------------------------------------
#
# Glob-based test discovery. New test files added to tests/ (matching
# <name>_test.sh) are picked up automatically — this dispatcher never
# needs to be edited when tests are added.
#
# Sections:
#   all          → tests/*_test.sh
#   unit         → tests/upgrade_test.sh + tests/unit_*_test.sh (no docker
#                  required); new docker-free files matching unit_*_test.sh
#                  are picked up automatically.
#   integration  → tests/*_test.sh
#   <prefix>     → tests/<prefix>_test.sh plus tests/<prefix>*_test.sh
#
# Exits non-zero if no tests match or any test fails. The glob expansion
# is always filtered to existing files so an empty match degrades to a
# clean "no tests matched" rather than a shell error.

_harness_test_usage() {
    cat <<'EOF'
Usage: harness test [section] [--pattern GLOB] [--slow]

Run the harness test suite. Test discovery is glob-based — any file
matching tests/*_test.sh is picked up automatically without editing
the wrapper.

sections:
  all           run every tests/*_test.sh (default)
  unit          fast, no-docker tests (upgrade_test.sh + unit_*_test.sh)
  integration   tests/*_test.sh
  <prefix>      tests/<prefix>_test.sh plus tests/<prefix>*_test.sh

flags:
  --pattern GLOB   explicit glob (relative to repo root); overrides section
  --slow           export HARNESS_RUN_SLOW=1 for the test run
  -h, --help       show this help

examples:
  harness test                       # all tests
  harness test unit                  # just unit tests
  harness test mcp                   # tests/mcp_test.sh plus tests/mcp*_test.sh
  harness test --pattern 'tests/firewall_*'
EOF
}

cmd_test() {
    local section="all"
    local explicit_pattern=""
    local slow=0

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                _harness_test_usage
                return 0
                ;;
            --pattern)
                if [[ $# -lt 2 ]]; then
                    err "harness test: --pattern requires a glob argument"
                    return 1
                fi
                explicit_pattern="$2"
                shift 2
                continue
                ;;
            --pattern=*)
                explicit_pattern="${1#--pattern=}"
                ;;
            --slow)
                slow=1
                ;;
            --)
                shift
                break
                ;;
            -*)
                err "harness test: unknown flag '$1'"
                _harness_test_usage >&2
                return 1
                ;;
            *)
                section="$1"
                ;;
        esac
        shift
    done

    if (( slow == 1 )); then
        export HARNESS_RUN_SLOW=1
    fi

    # Resolve the tests root via the install root (clone_dir).
    local tests_root="$clone_dir/tests"
    if [[ ! -d "$tests_root" ]]; then
        err "harness test: tests directory not found at $tests_root"
        return 1
    fi

    # Build the candidate list. We glob inside the repo and filter to
    # existing regular executable-or-readable files.
    local -a candidates=()
    local glob_expr=""
    if [[ -n "$explicit_pattern" ]]; then
        # User-supplied pattern is interpreted relative to the repo root
        # (clone_dir) so 'tests/foo_*' works as expected.
        glob_expr="$explicit_pattern"
        local -a matches=()
        # shellcheck disable=SC2206
        # We deliberately use word-splitting + glob expansion here.
        local pat="$clone_dir/$glob_expr"
        # If pattern is already absolute, don't double-prefix.
        if [[ "$glob_expr" == /* ]]; then
            pat="$glob_expr"
        fi
        # Use a subshell with nullglob so a no-match becomes empty array.
        mapfile -t matches < <(shopt -s nullglob; for f in $pat; do echo "$f"; done)
        candidates=("${matches[@]}")
    else
        case "$section" in
            all)
                mapfile -t candidates < <(shopt -s nullglob; for f in "$tests_root"/*_test.sh; do echo "$f"; done)
                ;;
            unit)
                # For now, the only file classified as unit (runs without
                # docker) is upgrade_test.sh. Future unit-only files can
                # be added by adopting a naming convention or splitting
                # this case out.
                if [[ -f "$tests_root/upgrade_test.sh" ]]; then
                    candidates+=("$tests_root/upgrade_test.sh")
                fi
                # Glob future unit_*.sh files too, so adopting that
                # convention later is zero-friction.
                mapfile -t _u < <(shopt -s nullglob; for f in "$tests_root"/unit_*_test.sh; do echo "$f"; done)
                candidates+=("${_u[@]}")
                unset _u
                ;;
            integration)
                mapfile -t candidates < <(shopt -s nullglob; for f in "$tests_root"/*_test.sh; do echo "$f"; done)
                ;;
            *)
                # Prefix mode: tests/<prefix>_test.sh and tests/<prefix>*_test.sh.
                # We add both forms and dedupe.
                local -a pref_matches=()
                mapfile -t pref_matches < <(
                    shopt -s nullglob
                    for f in "$tests_root/${section}_test.sh" "$tests_root/${section}"*_test.sh; do
                        echo "$f"
                    done
                )
                # Dedupe while preserving order.
                local -A seen=()
                local p
                for p in "${pref_matches[@]}"; do
                    if [[ -z "${seen[$p]:-}" ]]; then
                        candidates+=("$p")
                        seen[$p]=1
                    fi
                done
                ;;
        esac
    fi

    # Filter to existing files (glob expansions can leave broken paths if
    # nullglob misbehaves on older bash).
    local -a tests=()
    local t
    for t in "${candidates[@]}"; do
        [[ -f "$t" ]] && tests+=("$t")
    done

    if (( ${#tests[@]} == 0 )); then
        if [[ -n "$explicit_pattern" ]]; then
            err "harness test: no files matched pattern '$explicit_pattern'"
        else
            err "harness test: no tests matched section '$section'"
        fi
        return 1
    fi

    echo "[harness test] section=$section ${explicit_pattern:+pattern=$explicit_pattern }slow=$slow"
    echo "[harness test] running ${#tests[@]} test file(s):"
    for t in "${tests[@]}"; do
        echo "  - ${t#$clone_dir/}"
    done
    echo

    local failed=0 passed=0
    local -a failures=()
    for t in "${tests[@]}"; do
        echo "─── ${t#$clone_dir/} ───"
        # Run from clone_dir so tests can use repo-relative paths if they
        # want, and so $0 inside the test resolves under tests/.
        if ( cd "$clone_dir" && bash "$t" ); then
            passed=$((passed+1))
            echo "  PASS: ${t#$clone_dir/}"
        else
            local rc=$?
            failed=$((failed+1))
            failures+=("${t#$clone_dir/} (exit $rc)")
            echo "  FAIL: ${t#$clone_dir/} (exit $rc)"
        fi
        echo
    done

    echo "─── summary ───"
    echo "  passed: $passed"
    echo "  failed: $failed"
    if (( failed > 0 )); then
        echo "  failures:"
        local f
        for f in "${failures[@]}"; do
            echo "    - $f"
        done
        return 1
    fi
    return 0
}

# --- harness benchmark ------------------------------------------------------
#
# Dispatch to one of the benchmark runners under tests/benchmarks/runners/
# (added by track G). Each runner is a self-contained bash script that
# reads its config from environment variables — keeping argument-parsing
# here lets us evolve the runners independently.
#
# Defense-in-depth: we refuse to run benchmarks in CI even if the runner
# script lacks its own guard. Track G's runners will also check $CI.

_harness_benchmark_usage() {
    cat <<'EOF'
Usage: harness benchmark [target] [options]

Run a benchmark suite. Runner scripts live under
tests/benchmarks/runners/<target>.sh.

targets:
  smoketest         small synthetic suite that proves the harness can run
                    a benchmark end-to-end (default)
  prefetch          download + cache the real datasets with harbor's backend
                    temporarily allowlisted, so the benchmark runs can stay
                    sealed (no harbor phone-home during the run). Run this
                    once before terminal-bench / swe-bench-lite.
  terminal-bench    terminal-bench scenarios
  swe-bench-lite    swe-bench-lite scenarios
  compare-schemes   compare prompting/agent schemes against each other
  all               run every runner in tests/benchmarks/runners/

options:
  --task-ids LIST       comma-separated task ids (HARNESS_BENCH_TASK_IDS)
  --schemes LIST        comma-separated scheme names (HARNESS_BENCH_SCHEMES)
  --agents LIST         comma-separated agent names (HARNESS_BENCH_AGENTS)
  --n-concurrent N      max concurrent tasks (HARNESS_BENCH_N_CONCURRENT)
  --no-smoketest        skip the implicit smoketest pre-run for non-smoke
                        targets (use at your own risk)
  -h, --help            show this help

Non-smoketest targets implicitly require a smoketest pass first unless
--no-smoketest is given.

This subcommand will refuse to run when $CI is set.
EOF
}

cmd_benchmark() {
    # Defense-in-depth CI guard. The runners (track G) also check $CI,
    # but checking here means a misconfigured runner or an accidental
    # invocation without arguments still trips the guard.
    if [[ -n "${CI:-}" ]]; then
        echo "Refusing to run benchmarks in CI environment." >&2
        return 1
    fi

    local target="smoketest"
    local no_smoketest=0
    local task_ids=""
    local schemes=""
    local agents=""
    local n_concurrent=""
    local target_set=0

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                _harness_benchmark_usage
                return 0
                ;;
            --task-ids)
                if [[ $# -lt 2 ]]; then
                    err "harness benchmark: --task-ids requires a value"
                    return 1
                fi
                task_ids="$2"; shift 2; continue
                ;;
            --task-ids=*)        task_ids="${1#--task-ids=}" ;;
            --schemes)
                if [[ $# -lt 2 ]]; then
                    err "harness benchmark: --schemes requires a value"
                    return 1
                fi
                schemes="$2"; shift 2; continue
                ;;
            --schemes=*)         schemes="${1#--schemes=}" ;;
            --agents)
                if [[ $# -lt 2 ]]; then
                    err "harness benchmark: --agents requires a value"
                    return 1
                fi
                agents="$2"; shift 2; continue
                ;;
            --agents=*)          agents="${1#--agents=}" ;;
            --n-concurrent)
                if [[ $# -lt 2 ]]; then
                    err "harness benchmark: --n-concurrent requires a value"
                    return 1
                fi
                n_concurrent="$2"; shift 2; continue
                ;;
            --n-concurrent=*)    n_concurrent="${1#--n-concurrent=}" ;;
            --no-smoketest)      no_smoketest=1 ;;
            --)                  shift; break ;;
            -*)
                err "harness benchmark: unknown flag '$1'"
                _harness_benchmark_usage >&2
                return 1
                ;;
            *)
                if (( target_set == 0 )); then
                    target="$1"
                    target_set=1
                else
                    err "harness benchmark: unexpected positional argument '$1'"
                    return 1
                fi
                ;;
        esac
        shift
    done

    # Locate runner directory. clone_dir already resolves the wrapper's
    # real path through any symlink, so this works whether harness is
    # invoked from /usr/local/bin/harness, ~/.local/bin/harness, or
    # in-place from the clone.
    local runners_dir="$clone_dir/tests/benchmarks/runners"

    # Export option env vars only when set, so runners can apply their
    # own defaults when callers omit a flag.
    [[ -n "$task_ids"     ]] && export HARNESS_BENCH_TASK_IDS="$task_ids"
    [[ -n "$schemes"      ]] && export HARNESS_BENCH_SCHEMES="$schemes"
    [[ -n "$agents"       ]] && export HARNESS_BENCH_AGENTS="$agents"
    [[ -n "$n_concurrent" ]] && export HARNESS_BENCH_N_CONCURRENT="$n_concurrent"

    # Helper to invoke a single runner with appropriate error reporting.
    _harness_run_bench_target() {
        local tgt="$1"
        local runner="$runners_dir/${tgt}.sh"
        if [[ ! -f "$runner" ]]; then
            err "harness benchmark: runner not found: $runner"
            err "  benchmark runners are provided by track G and live under tests/benchmarks/runners/"
            return 1
        fi
        echo "[harness benchmark] running $tgt ($runner)"
        ( cd "$clone_dir" && bash "$runner" )
    }

    case "$target" in
        smoketest)
            _harness_run_bench_target smoketest
            return $?
            ;;
        prefetch)
            # Setup step, not a benchmark: downloads datasets with harbor's
            # backend temporarily allowlisted. No smoketest gate (it runs no
            # agent and consumes no LLM budget).
            _harness_run_bench_target prefetch
            return $?
            ;;
        all)
            # Run every *.sh under runners/. Smoketest first if present.
            if [[ ! -d "$runners_dir" ]]; then
                err "harness benchmark: runners directory not found at $runners_dir"
                return 1
            fi
            local -a runners=()
            mapfile -t runners < <(shopt -s nullglob; for f in "$runners_dir"/*.sh; do echo "$f"; done)
            if (( ${#runners[@]} == 0 )); then
                err "harness benchmark: no runners under $runners_dir"
                return 1
            fi
            # Always run smoketest first when present.
            if (( no_smoketest == 0 )) && [[ -f "$runners_dir/smoketest.sh" ]]; then
                _harness_run_bench_target smoketest || return 1
            fi
            local r rc=0
            for r in "${runners[@]}"; do
                local name
                name=$(basename "$r" .sh)
                # smoketest already ran as the gate above. prefetch opens
                # harbor's backend, so it only ever runs when the operator
                # asks for it explicitly — never implicitly inside `all`.
                [[ "$name" == "smoketest" || "$name" == "prefetch" ]] && continue
                _harness_run_bench_target "$name" || rc=1
            done
            return $rc
            ;;
        *)
            # Non-smoketest, non-all target: require smoketest pass first
            # unless caller opted out.
            if (( no_smoketest == 0 )); then
                if [[ -f "$runners_dir/smoketest.sh" ]]; then
                    echo "[harness benchmark] running smoketest gate before $target (use --no-smoketest to skip)"
                    if ! _harness_run_bench_target smoketest; then
                        err "harness benchmark: smoketest failed; refusing to run $target"
                        return 1
                    fi
                else
                    err "harness benchmark: smoketest runner not present (use --no-smoketest to skip)"
                    return 1
                fi
            fi
            _harness_run_bench_target "$target"
            return $?
            ;;
    esac
}

# --- dispatch ---------------------------------------------------------------

main() {
    # Dispatch: bare `harness` (no args) — or `harness` followed by an agent
    # flag like --yolo / -p — launches an opencode agent in the current
    # directory and forwards everything. The help flags (-h/--help) are the
    # one flag exception and show help. A leading bare word is a subcommand:
    # known ones dispatch; an unknown one errors (so a typo like
    # `harness statt` is caught instead of silently launching an agent).
    if [[ $# -eq 0 ]]; then
        run_agent opencode
        return
    fi

    case "$1" in
        -h|--help)
            cmd_help
            return
            ;;
        -*)
            run_agent opencode "$@"
            return
            ;;
    esac

    local cmd="$1"; shift

    case "$cmd" in
        help)                       cmd_help ;;
        start)                      cmd_start "$@" ;;
        down)                       cmd_down ;;
        restart)                    cmd_restart "$@" ;;
        update)                     cmd_update ;;
        upgrade)                    cmd_upgrade "$@" ;;
        downgrade)                  cmd_downgrade "$@" ;;
        check-updates)              cmd_check_updates "$@" ;;
        logs)                       cmd_logs "$@" ;;
        opencode)                   run_agent opencode "$@" ;;
        host)                       cmd_host "$@" ;;
        shell)                      cmd_shell "$@" ;;
        list)                       cmd_list ;;
        stop)                       cmd_stop "$@" ;;
        net)                        cmd_net "$@" ;;
        mcp)                        cmd_mcp "$@" ;;
        unlock)                     cmd_unlock "$@" ;;
        doctor)                     cmd_doctor ;;
        preflight)                  cmd_preflight ;;
        test)                       cmd_test "$@" ;;
        benchmark)                  cmd_benchmark "$@" ;;
        *)
            err "unknown command '$cmd'"
            cmd_help >&2
            exit 1
            ;;
    esac
}

# Allow tests to source this script for access to internal helpers (e.g.
# _upgrade_confirm) without invoking main. Production execution always
# falls through to main "$@".
#
# The EXIT trap reaps this invocation's jq sidecar (if one was created).
# It covers every non-exec command; the `exec` paths (run_agent_print,
# mcp logs) never reach this trap, so they call _reap_jq_sidecar explicitly
# just before their `harness_docker_exec`. The interactive agent-launch /
# shell paths also reap explicitly but then run docker as a child and
# `exit`, so this trap fires too — harmless, the reap is idempotent.
# Set only for real execution: a sourced test shell must not reap on its
# own subshell exit.
if [[ -z "${HARNESS_SOURCE_ONLY:-}" ]]; then
    trap '_reap_jq_sidecar' EXIT
    main "$@"
fi
